  <!-- ============ Schedule-demo popup ============
       FORM SLOT: the Formidable form is not hardcoded. Give the Elementor Shortcode
       widget rendering [formidable id="..."] the CSS ID  schedule-demo-form  and the
       script relocates that live widget into the slot - nothing is recreated, so
       Formidable's own scripts, nonces and AJAX keep working. -->
  <div class="pk-schd" id="pkSchd" hidden>
    <div class="pk-schd-panel" role="dialog" aria-modal="true" aria-labelledby="pkSchdTitle" tabindex="-1">
      <button type="button" class="pk-schd-close" data-schedule-popup-close aria-label="Close">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
      <div class="pk-schd-head">
        <p class="eyb">Book a discovery call</p>
        <h3 id="pkSchdTitle">Schedule a demo call</h3>
        <p>Tell us a little about your machines and our team will follow up to find a time that works.</p>
      </div>
      <div class="pk-schd-form" id="pkSchdForm">
        <p class="pk-schd-empty">The form did not load. Email <a href="mailto:sales@ithena.ai">sales@ithena.ai</a> and we will book the call for you.</p>
      </div>
    </div>
  </div>

</section>

<script>
(function(){
  "use strict";
  var root=document.getElementById("main-section");
  if(!root||!root.classList.contains("pkg")) return;
  var reduced=window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  var $=function(s){return root.querySelector(s);};
  var $$=function(s){return Array.prototype.slice.call(root.querySelectorAll(s));};
  var pop=document.getElementById("pkSchd");

  /* ---- CTA video: play button opens a centered modal, video plays with audio ---- */
  var vid=document.getElementById("pkVid");
  if(vid&&!window.pkVidInit){
    window.pkVidInit=1;
    /* out of #main-section so a transformed Elementor ancestor cannot break position:fixed */
    document.body.appendChild(vid);
    var vidEl=vid.querySelector("video"),
        vidSrc="https://dev-website.ithena.app/wp-content/uploads/2026/09/Packaging%20page%20.mp4",
        vidLast=null;
    function vidKey(e){ if(e.key==="Escape") closeVid(); }
    function openVid(e){
      if(e) e.preventDefault();
      vidLast=document.activeElement;
      if(!vidEl.getAttribute("src")) vidEl.setAttribute("src",vidSrc);
      vid.hidden=false;
      document.body.style.overflow="hidden";
      document.addEventListener("keydown",vidKey);
      void vid.offsetWidth;               /* reflow, not rAF (throttled in bg tabs) */
      vid.classList.add("is-open");
      var p=vidEl.play(); if(p&&p.catch) p.catch(function(){});
      var c=vid.querySelector("[data-cta-close]"); if(c) c.focus();
    }
    function closeVid(){
      vid.classList.remove("is-open");
      document.body.style.overflow="";
      document.removeEventListener("keydown",vidKey);
      vidEl.pause();
      setTimeout(function(){vid.hidden=true;},250);
      if(vidLast&&vidLast.focus) vidLast.focus();
    }
    document.addEventListener("click",function(e){
      if(!e.target.closest) return;
      if(e.target.closest("[data-cta-play]")){ openVid(e); return; }
      if(e.target===vid||e.target.closest("[data-cta-close]")) closeVid();
    });
  }

  /* ---- theme: follow the site header when it drives <html class="dark"> ---- */
  function applyTheme(t){
    if(root.getAttribute("data-theme")===t) return;
    if(!reduced){root.classList.add("theming");setTimeout(function(){root.classList.remove("theming");},420);}
    root.setAttribute("data-theme",t);
    if(pop) pop.setAttribute("data-theme",t);
  }
  if(document.documentElement.classList.contains("dark")) applyTheme("dark");
  new MutationObserver(function(){
    applyTheme(document.documentElement.classList.contains("dark")?"dark":"light");
  }).observe(document.documentElement,{attributes:true,attributeFilter:["class"]});

  /* ---- reveal on scroll ---- */
  var targets=$$(".rv,.stg");
  if(!("IntersectionObserver" in window)||reduced){
    targets.forEach(function(el){el.classList.add("in");});
  }else{
    var io=new IntersectionObserver(function(es){
      es.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add("in"); io.unobserve(e.target); } });
    },{rootMargin:"0px 0px -12% 0px",threshold:.12});
    targets.forEach(function(el){io.observe(el);});
  }

  /* ---- proof dials: fill the arc and run the number, once ---- */
  var dials=$$(".dial");
  /* 270 is the r=43 circumference the .arc dasharray is set to */
  function fillArc(d){
    var arc=d.querySelector(".arc"),n=d.querySelector(".num");
    if(arc&&n) arc.style.strokeDashoffset=270-270*(parseFloat(n.getAttribute("data-count"))/100);
  }
  function runDial(d){
    fillArc(d);
    var el=d.querySelector(".num"),end=parseFloat(el.getAttribute("data-count")),
        suf=el.getAttribute("data-suffix")||"",t0=null;
    requestAnimationFrame(function frame(t){
      if(!t0)t0=t;
      var k=Math.min(1,(t-t0)/1900);
      el.textContent=Math.round(end*(1-Math.pow(1-k,3)))+suf;
      if(k<1)requestAnimationFrame(frame);
    });
  }
  if(dials.length&&"IntersectionObserver" in window&&!reduced){
    var fo=new IntersectionObserver(function(es){
      es.forEach(function(e){ if(e.isIntersecting){ fo.unobserve(e.target); runDial(e.target); } });
    },{threshold:.4});
    dials.forEach(function(d){fo.observe(d);});
  }else{
    /* no observer, or motion is off: the arcs still have to be drawn */
    dials.forEach(fillArc);
  }

  /* ---- in-page nav: mark the section you are reading ---- */
  var snLinks=$$(".sn-links a");
  if(snLinks.length&&"IntersectionObserver" in window){
    var byId={},secs=[],seen={};
    snLinks.forEach(function(a){
      var sec=root.querySelector(a.getAttribute("href"));
      if(sec){byId[sec.id]=a;secs.push(sec);}
    });
    var so=new IntersectionObserver(function(es){
      es.forEach(function(e){seen[e.target.id]=e.isIntersecting;});
      var cur=null;
      secs.forEach(function(sec){if(seen[sec.id]&&!cur)cur=sec.id;});
      snLinks.forEach(function(a){a.removeAttribute("aria-current");});
      if(cur)byId[cur].setAttribute("aria-current","true");
    },{rootMargin:"-80px 0px -55% 0px"});
    secs.forEach(function(sec){so.observe(sec);});
  }

  /* ---- capabilities: one open at a time, the panel follows the open one ---- */
  var capqs=$$(".capq"),capArts=$$(".cap-med .art"),capDots=$$(".capdots button"),
      capOrder=capDots.map(function(d){return d.dataset.cap;}),capTimer=null,capHeld=false;
  function capShow(k){
    capqs.forEach(function(q){
      var h=q.querySelector(".qh"),on=h.dataset.cap===k;
      q.classList.toggle("open",on); h.setAttribute("aria-expanded",on?"true":"false");
    });
    capArts.forEach(function(a){
      var on=a.dataset.cap===k;
      a.classList.toggle("on",on); a.setAttribute("aria-hidden",on?"false":"true");
    });
    capDots.forEach(function(d){d.setAttribute("aria-current",d.dataset.cap===k?"true":"false");});
  }
  if(capOrder.length){
    capArts.forEach(function(a){a.setAttribute("aria-hidden",a.classList.contains("on")?"false":"true");});
    $$(".capq .qh").concat(capDots).forEach(function(b){
      b.addEventListener("click",function(){
        /* once someone picks for themselves, stop picking for them */
        capHeld=true; clearInterval(capTimer); capTimer=null;
        capShow(b.dataset.cap);
      });
    });
    /* advance on its own, but only while the section is actually on screen */
    if(!reduced&&"IntersectionObserver" in window){
      new IntersectionObserver(function(es){
        es.forEach(function(e){
          if(e.isIntersecting&&!capTimer&&!capHeld){
            capTimer=setInterval(function(){
              var cur=root.querySelector('.capdots [aria-current="true"]');
              capShow(capOrder[(capOrder.indexOf(cur.dataset.cap)+1)%capOrder.length]);
            },4200);
          }else if(!e.isIntersecting){clearInterval(capTimer);capTimer=null;}
        });
      },{threshold:.3}).observe($(".caps"));
    }
  }

  /* ---- challenge: lift one cost article at a time, 3s each, while on screen ---- */
  var costs=$$(".chal .cost"),costTimer=null,costI=0;
  if(costs.length&&!reduced&&"IntersectionObserver" in window){
    var costStep=function(){
      costs.forEach(function(c,j){c.classList.toggle("active",j===costI);});
      costI=(costI+1)%costs.length;
    };
    new IntersectionObserver(function(es){
      es.forEach(function(e){
        if(e.isIntersecting&&!costTimer){costI=0;costStep();costTimer=setInterval(costStep,3000);}
        else if(!e.isIntersecting){clearInterval(costTimer);costTimer=null;costs.forEach(function(c){c.classList.remove("active");});}
      });
    },{threshold:.3}).observe($(".chal"));
  }

  /* ---- console tabs ---- */
  var picks=$$(".pick"),lmq=window.matchMedia("(max-width:1024px)"),cw=$(".conswrap");
  /* the band is divided into one slot per console plus a .6 tail, so the last
     console is still pinned for a moment after it arrives */
  var cslots=picks.length+.6;
  /* where in the pinned band the console at index i sits */
  function conspos(i){return cw.getBoundingClientRect().top+window.scrollY+(cw.offsetHeight-window.innerHeight)*(i+.5)/cslots;}
  function show(name){
    picks.forEach(function(b){ b.setAttribute("aria-selected", b.dataset.pane===name?"true":"false"); });
    $$(".pane,.blurb").forEach(function(p){
      var on=p.dataset.pane===name;
      p.classList.toggle("on",on);
    });
  }
  picks.forEach(function(b,i){
    b.addEventListener("click",function(){show(b.dataset.pane);if(cw&&!lmq.matches&&!reduced)window.scrollTo({top:conspos(i)});});
    b.addEventListener("keydown",function(e){
      var d=e.key==="ArrowRight"?1:e.key==="ArrowLeft"?-1:0;
      if(!d) return;
      e.preventDefault();
      var n=picks[(i+d+picks.length)%picks.length];
      n.focus(); show(n.dataset.pane);
    });
  });

  /* ---- consoles: pin the panel, one console per screen of scroll ---- */
  if(cw&&picks.length&&!reduced){
    var ctick=function(){
      if(lmq.matches)return;
      var cspan=cw.offsetHeight-window.innerHeight;
      var ck=cspan>0?Math.min(1,Math.max(0,-cw.getBoundingClientRect().top/cspan)):0;
      var ci=Math.min(picks.length-1,Math.floor(ck*cslots));
      if(picks[ci].getAttribute("aria-selected")!=="true")show(picks[ci].dataset.pane);
    };
    window.addEventListener("scroll",ctick,{passive:true});
    window.addEventListener("resize",ctick);
    ctick();
  }

  /* ---- schedule popup: trigger + Formidable form adoption ---- */
  if(pop&&!window.pkSchdInit){
    window.pkSchdInit=1;
    /* out of #main-section so a transformed Elementor ancestor cannot break position:fixed */
    document.body.appendChild(pop);
    pop.setAttribute("data-theme",root.getAttribute("data-theme"));
    var slot=document.getElementById("pkSchdForm"),moved=false,lastFocus=null;

    function adopt(){
      if(moved||!slot) return;
      var src=document.querySelector("#schedule-demo-form, .schedule-demo-form");
      if(!src){
        var w=document.querySelectorAll(".elementor-widget-shortcode");
        for(var i=0;i<w.length;i++){ if(w[i].querySelector(".frm_forms, form")){ src=w[i]; break; } }
      }
      if(!src) src=document.querySelector(".frm_forms");
      if(!src||pop.contains(src)) return;
      slot.innerHTML=""; slot.appendChild(src); src.style.display="block"; moved=true;
    }
    adopt();
    window.addEventListener("load",adopt);

    function onKey(e){ if(e.key==="Escape") closePop(); }
    function openPop(e){
      if(e) e.preventDefault();
      adopt();
      lastFocus=document.activeElement;
      pop.hidden=false;
      document.body.style.overflow="hidden";
      document.addEventListener("keydown",onKey);
      /* forced reflow, not rAF: rAF is throttled in a background tab, which would
         leave the panel invisible while body scroll is already locked */
      void pop.offsetWidth;
      pop.classList.add("is-open");
      var f=pop.querySelector(".pk-schd-form input:not([type=hidden]):not([type=submit]):not([type=button]):not([disabled]), .pk-schd-form textarea:not([disabled]), .pk-schd-form select:not([disabled])")||pop.querySelector("[data-schedule-popup-close]");
      if(f) f.focus();
    }
    function closePop(){
      pop.classList.remove("is-open");
      document.body.style.overflow="";
      document.removeEventListener("keydown",onKey);
      setTimeout(function(){pop.hidden=true;},250);
      if(lastFocus&&lastFocus.focus) lastFocus.focus();
    }
    /* delegated: triggers Elementor renders later still work, one listener covers open + close */
    document.addEventListener("click",function(e){
      if(!e.target.closest) return;
      if(e.target.closest("[data-schedule-demo]")){ openPop(e); return; }
      if(e.target===pop||e.target.closest("[data-schedule-popup-close]")) closePop();
    });
  }
})();
</script>