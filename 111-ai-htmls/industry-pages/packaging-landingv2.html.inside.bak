<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">

<style>
  /* ================= ITHENA iSERV - Packaging machinery =================
     Built to ithena-product-page-blueprint.md (tokens §3, block library §4,
     order §9, responsive §10). Content is packaging-landing.html's own copy
     and data, re-laid onto the blueprint system.
     Scoped to #main-section.pkg so it survives Astra/Elementor.
     ====================================================================== */
  #main-section.pkg{
    --srf:#FAFAFA; --srf2:#FFFFFF; --card:#FFFFFF;
    --ink:#1F2023; --ink2:rgba(0,0,0,.70); --ink3:rgba(0,0,0,.50);
    --blue:#0083C8; --blue-d:#006AA3; --blue-w:#EDF7FC; --red:#C00000;
    --line:#EAEAEA; --navy:#0D1B2E; --navy-2:#152C46; --navy-acc:#BFE5F8;
    --ok:#1EA672; --bad:var(--red);
    /* one accent for the whole page - the brand blue - with the accent red kept
       for loss and stopped states only. --hc/--hw are the per-element accent and
       wash slots every block fills from. */
    --hc:var(--blue); --hw:var(--blue-w);
    /* drawn-interface sub-palette (blueprint §3.3) */
    --mk:#FFFFFF; --mk-2:#FBFCFD; --art:#F6F9FB; --mk-line:#E4EAF0; --mk-line2:#EEF2F6;
    --mk-sel:#EDF7FC; --mk-selb:#CFE7F5; --mk-mut:#8494A2; --mk-ink:#1F2023;
    /* elevation - always blue-tinted (blueprint §3.5) */
    --sh-feat:0 40px 24px -32px rgba(0,60,100,.22);
    --sh-pair:0 -6px 20px -16px rgba(6,42,68,.10);
    --sh-shell:0 30px 70px -40px rgba(0,40,70,.35);
    --sh-screen:0 26px 54px -30px rgba(0,40,70,.55);
    --sh-micro:0 1px 2px rgba(13,27,46,.06);
    --sh-pill:0 8px 22px -12px rgba(0,40,70,.35);
    --wrap:min(1344px,86.7vw);
    --pad:clamp(48px,5.6vw,84px);
    --ff:"Noto Sans",-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
    --mono:ui-monospace,SFMono-Regular,"SF Mono",Menlo,Consolas,monospace;
    --ez:cubic-bezier(.2,0,0,1);
    font-family:var(--ff)!important; background:var(--srf)!important; color:var(--ink)!important;
    font-size:16px!important; line-height:1.6!important; margin:0!important; display:block!important;
    -webkit-font-smoothing:antialiased; overflow-x:clip;
  }
  #main-section.pkg[data-theme="dark"]{
    --srf:#0D1B2E; --srf2:#122C44; --card:#122C44;
    --ink:#FFFFFF; --ink2:rgba(215,236,246,.82); --ink3:#8FAFC4;
    --blue:#39A8DE; --blue-d:#0083C8; --blue-w:rgba(0,131,200,.16);
    --line:rgba(255,255,255,.13); --navy:#081524; --navy-2:#102338;
    --mk:#0E2438; --mk-2:#122C44; --art:#0E2438;
    --mk-line:rgba(255,255,255,.13); --mk-line2:rgba(255,255,255,.07);
    --mk-sel:rgba(0,131,200,.18); --mk-selb:rgba(57,168,222,.42); --mk-mut:#8FAFC4; --mk-ink:#FFFFFF;
    /* the accent red itself never changes, but at 10px on navy it has to be
       lifted off the surface to stay readable - a tint of the same red */
    --bad:color-mix(in srgb,var(--red) 55%,#fff);
    --sh-feat:0 40px 24px -32px rgba(0,0,0,.6);
    --sh-shell:0 30px 70px -40px rgba(0,0,0,.8);
    --sh-screen:0 26px 54px -30px rgba(0,0,0,.85);
    --sh-pill:0 8px 22px -12px rgba(0,0,0,.6);
    color-scheme:dark;
  }
  #main-section.pkg.theming,#main-section.pkg.theming *{
    transition:background-color .35s var(--ez),color .35s var(--ez),border-color .35s var(--ez)!important}

  /* ---- reset: the page defends itself against the parent theme ---- */
  #main-section.pkg *,#main-section.pkg *::before,#main-section.pkg *::after{box-sizing:border-box}
  #main-section.pkg h1,#main-section.pkg h2,#main-section.pkg h3,#main-section.pkg h4,
  #main-section.pkg p,#main-section.pkg ul,#main-section.pkg ol,#main-section.pkg figure{font-family:var(--sc-ff) !important;padding:0!important}
  #main-section.pkg ul,#main-section.pkg ol{list-style:none!important}
  #main-section.pkg li{margin:0!important;list-style:none!important}
  #main-section.pkg a{color:inherit!important;text-decoration:none!important}
  #main-section.pkg img,#main-section.pkg svg,#main-section.pkg video{max-width:100%;display:block}
  #main-section.pkg button{font:inherit;color:inherit;background:none;border:0;padding:0;cursor:pointer}
  #main-section.pkg table{border-collapse:collapse;width:100%}
  #main-section.pkg :focus-visible{outline:2px solid var(--blue)!important;outline-offset:3px!important;border-radius:4px}
  #main-section.pkg ::selection{background:rgba(0,131,200,.22)}

  /* ---------- in-page nav ---------- */
  #main-section.pkg section[id]{scroll-margin-top:78px}
  #main-section.pkg .subnav{position:sticky;top:0;z-index:30;background:color-mix(in srgb,var(--srf) 90%,transparent);border-bottom:1px solid var(--line);-webkit-backdrop-filter:saturate(1.6) blur(12px);backdrop-filter:saturate(1.6) blur(12px)}
  #main-section.pkg .subnav-in{display:flex;align-items:center;gap:18px;padding:10px 0}
  #main-section.pkg .sn-name{flex:none;font-size:14px;font-weight:800;letter-spacing:-.01em;color:var(--ink)}
  #main-section.pkg .sn-links{flex:1;display:flex;gap:2px;overflow-x:auto;scrollbar-width:none;-ms-overflow-style:none}
  #main-section.pkg .sn-links::-webkit-scrollbar{display:none}
  #main-section.pkg .sn-links a{display:block;white-space:nowrap;font-size:13.5px;font-weight:600;color:var(--ink2)!important;padding:7px 13px;border-radius:100px;transition:background-color .2s var(--ez),color .2s var(--ez)}
  #main-section.pkg .sn-links a:hover{background:color-mix(in srgb,var(--ink) 6%,transparent);color:var(--ink)!important}
  #main-section.pkg .sn-links a[aria-current="true"]{background:var(--blue-w);color:var(--blue-d)!important}
  #main-section.pkg[data-theme="dark"] .sn-links a[aria-current="true"]{color:#9AD4F2!important}
  #main-section.pkg .sn-cta{flex:none;height:38px;padding:0 16px;font-size:13px}

  /* ---------- band + header contract (blueprint §4) ---------- */
  #main-section.pkg .band{width:100%;padding:var(--pad) 0;background:var(--srf)}
  #main-section.pkg .band.alt{background:var(--srf2)}
  #main-section.pkg .wrap{width:var(--wrap);margin:0 auto}
  #main-section.pkg .shead{max-width:880px}
  #main-section.pkg .shead.mid{margin-left:auto;margin-right:auto;text-align:center}
  #main-section.pkg .eyb{display:flex;align-items:center;gap:9px;font-size:12px;font-weight:700;letter-spacing:.17em;text-transform:uppercase;color:var(--blue)}
  #main-section.pkg .eyb::before{content:"";width:22px;height:2px;border-radius:2px;background:currentColor;flex:none}
  #main-section.pkg .shead.mid .eyb{justify-content:center}
  #main-section.pkg .shead h2{font-size:44px;line-height:1.12;font-weight:800;letter-spacing:-.025em;color:var(--ink);margin-top:13px!important}
  #main-section.pkg .lede{font-size:17px;line-height:1.6;color:var(--ink2);margin-top:16px!important;max-width:72ch}
  #main-section.pkg .shead.mid .lede{margin-left:auto;margin-right:auto}
  #main-section.pkg .grid{margin-top:clamp(34px,3vw,48px)}

  /* ---------- buttons, chips, links (blueprint §3.6, §3.7) ---------- */
  #main-section.pkg .btn{display:inline-flex;align-items:center;gap:9px;height:46px;padding:0 18px 0 22px;border-radius:100px;font-size:14px;font-weight:600;transition:background-color .2s var(--ez),border-color .2s var(--ez)}
  #main-section.pkg .btn.pri{background:var(--blue);color:#fff!important}
  #main-section.pkg .btn.pri:hover{background:var(--blue-d)}
  #main-section.pkg .btn.sec{background:color-mix(in srgb,var(--ink) 7%,transparent);color:var(--ink)!important}
  #main-section.pkg .btn.sec:hover{background:color-mix(in srgb,var(--ink) 13%,transparent)}
  #main-section.pkg .btn.gho{background:var(--card);border:1px solid var(--line);color:var(--ink)!important}
  #main-section.pkg .btn.gho:hover{border-color:var(--blue)}
  #main-section.pkg .btn svg{width:15px;height:15px;flex:none}
  #main-section.pkg .btns{display:flex;flex-wrap:wrap;gap:12px;margin-top:30px}
  #main-section.pkg .chip{display:inline-flex;align-items:center;gap:7px;background:var(--blue-w);border:1px solid rgba(0,131,200,.24);border-radius:100px;padding:7px 14px;font-size:13px;font-weight:600;color:var(--blue)}
  #main-section.pkg[data-theme="dark"] .chip{border-color:rgba(57,168,222,.34);color:#9AD4F2}
  #main-section.pkg .chips{display:flex;flex-wrap:wrap;gap:8px}

  /* ---------- shared mock-interface parts (blueprint §5) ---------- */
  /* the reset above zeroes padding but not margin, so every heading and
     paragraph drawn inside a screen was carrying the browser's own margins.
     that slack is what forced the console to scroll inside itself. */
  #main-section.pkg .cbar h3,#main-section.pkg .panel .ph h4{margin:0}
  #main-section.pkg .screen p,#main-section.pkg .cscreen p{margin-bottom:0}
  #main-section.pkg .screen{background:var(--mk);border:1px solid var(--mk-line);border-radius:20px;box-shadow:var(--sh-screen);overflow:hidden}
  #main-section.pkg .cbar{display:flex;align-items:center;gap:10px;padding:12px 16px;border-bottom:1px solid var(--mk-line2);background:var(--mk-2);flex-wrap:wrap}
  #main-section.pkg .cbar h3{font-size:13.5px;font-weight:700;color:var(--mk-ink)}
  #main-section.pkg .cbar .sp{flex:1}
  #main-section.pkg .cbar .tag{font-size:11px;font-weight:600;color:var(--mk-mut);border:1px solid var(--mk-line2);border-radius:100px;padding:3px 10px;white-space:nowrap}
  #main-section.pkg .cbar .dot{width:6px;height:6px;border-radius:50%;background:var(--ok);flex:none}
  #main-section.pkg .kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(112px,1fr));gap:10px}
  #main-section.pkg .kpi{border:1px solid var(--mk-line2);border-radius:14px;padding:11px 12px;box-shadow:var(--sh-micro);background:var(--mk)}
  #main-section.pkg .kpi .v{font-size:20px;font-weight:800;color:var(--mk-ink);letter-spacing:-.02em;line-height:1.1;font-variant-numeric:tabular-nums}
  #main-section.pkg .kpi .l{font-size:11px;color:var(--mk-mut);margin-top:5px!important}
  #main-section.pkg .kpi .d{font-size:11px;font-weight:700;margin-top:6px!important}
  #main-section.pkg .kpi .d.up{color:var(--ok)} #main-section.pkg .kpi .d.dn{color:var(--bad)}
  #main-section.pkg .kpi .d.mut{color:var(--mk-mut);font-weight:600}
  #main-section.pkg .panel{border:1px solid var(--mk-line2);border-radius:16px;padding:13px;background:var(--mk)}
  #main-section.pkg .panel .ph{display:flex;align-items:baseline;justify-content:space-between;gap:10px;margin-bottom:12px}
  #main-section.pkg .panel .ph h4{font-size:12px;font-weight:700;color:var(--mk-ink)}
  #main-section.pkg .panel .ph span{font-size:10.5px;color:var(--mk-mut)}
  #main-section.pkg .tbl th{font-size:10.5px;font-weight:700;color:var(--mk-mut);text-align:left;padding:0 10px 8px;border-bottom:1px solid var(--mk-line2);white-space:nowrap}
  #main-section.pkg .tbl td{font-size:12px;color:var(--mk-ink);padding:9px 10px;border-bottom:1px solid var(--mk-line2);white-space:nowrap}
  #main-section.pkg .tbl tr.sel td{background:var(--mk-sel)}
  #main-section.pkg .tbl tr.sel td:first-child{box-shadow:inset 2px 0 0 var(--blue)}
  #main-section.pkg .tbl td.num{text-align:right;font-variant-numeric:tabular-nums}
  #main-section.pkg .pill{display:inline-flex;align-items:center;gap:5px;font-size:10.5px;font-weight:600;border-radius:100px;padding:3px 9px;border:1px solid var(--mk-line2);color:var(--mk-mut);white-space:nowrap}
  #main-section.pkg .pill.ok{color:var(--ok);border-color:rgba(30,166,114,.35);background:rgba(30,166,114,.08)}
  #main-section.pkg .pill.bad{color:var(--bad);border-color:rgba(192,0,0,.32);background:rgba(192,0,0,.07)}
  #main-section.pkg .pill.warn{color:var(--blue-d);border-color:rgba(0,131,200,.32);background:rgba(0,131,200,.08)}
  #main-section.pkg[data-theme="dark"] .pill.warn{color:#9AD4F2}
  #main-section.pkg .alist{display:grid;gap:9px}
  #main-section.pkg .alert{border:1px solid var(--mk-line2);border-radius:13px;padding:10px 11px;box-shadow:var(--sh-micro);background:var(--mk)}
  #main-section.pkg .alert .t{font-size:12px;font-weight:600;color:var(--mk-ink);line-height:1.4}
  #main-section.pkg .alert .m{font-size:10.5px;color:var(--mk-mut);margin-top:5px!important}
  #main-section.pkg .prov{display:flex;align-items:center;gap:8px;font-size:11.5px;color:var(--mk-mut);border-top:1px solid var(--mk-line2);padding-top:9px;margin-top:12px;line-height:1.45}
  #main-section.pkg .prov b{color:var(--mk-ink);font-weight:600}
  #main-section.pkg .prov .dot{width:5px;height:5px;border-radius:50%;background:var(--ok);flex:none}
  #main-section.pkg .hbar{display:grid;grid-template-columns:104px 1fr 58px;gap:10px;align-items:center}
  #main-section.pkg .hbar+.hbar{margin-top:9px}
  #main-section.pkg .hbar .n{font-size:11.5px;color:var(--mk-mut);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  #main-section.pkg .hbar .t{height:10px;border-radius:100px;background:var(--mk-line2);overflow:hidden}
  #main-section.pkg .hbar .t i{display:block;height:100%;border-radius:100px;background:var(--hc);width:var(--w)}
  #main-section.pkg .hbar .v{font-size:12px;font-weight:700;color:var(--mk-ink);text-align:right;font-variant-numeric:tabular-nums}
  #main-section.pkg .hbar.hot .t i{background:var(--bad)}

  /* --pkw is the donut's sweep angle; it has to be registered or it would jump
     from 0 to 360 at the halfway mark instead of animating */
  @property --pkw{syntax:"<angle>";inherits:false;initial-value:360deg}

  /* ---------- reveal (blueprint §6) ---------- */
  @media not (prefers-reduced-motion:reduce){
    #main-section.pkg .rv{opacity:0;transform:translateY(16px);transition:opacity .6s var(--ez),transform .6s var(--ez)}
    #main-section.pkg .rv.in{opacity:1;transform:none}
    #main-section.pkg .stg>*{opacity:0;transform:translateY(16px);transition:opacity .55s var(--ez),transform .55s var(--ez)}
    #main-section.pkg .stg.in>*{opacity:1;transform:none}
    #main-section.pkg .stg.in>*:nth-child(2){transition-delay:.07s}
    #main-section.pkg .stg.in>*:nth-child(3){transition-delay:.14s}
    #main-section.pkg .stg.in>*:nth-child(4){transition-delay:.21s}
  }

  /* ================= B0 - HERO ================= */
  #main-section.pkg .hero{position:relative;isolation:isolate;padding-top:clamp(100px,8vw,160px);padding-bottom:clamp(44px,5vw,95px)}
  /* the line running, behind the copy. the still sits under the video, so it is
     what shows before the file arrives and what stays if motion is turned off. */
  #main-section.pkg .hero::before{content:"";position:absolute;inset:0;z-index:-3;
    background:url("https://dev-website.ithena.app/wp-content/uploads/2026/09/packaging-hero-1.webp") center/cover no-repeat}
  #main-section.pkg .hero-vid{position:absolute;inset:0;z-index:-2;width:100%;height:100%;object-fit:cover;pointer-events:none}
  #main-section.pkg .hero::after{content:"";position:absolute;inset:0;z-index:-1;background:#04070db3;}
  @media (prefers-reduced-motion:reduce){#main-section.pkg .hero-vid{display:none}}
  /* the band is dark in both themes now, so the copy borrows the dark palette */
  #main-section.pkg .hero-copy{--ink:#FFFFFF;--ink2:#D7ECF6;--ink3:#8FAFC4;--blue:#39A8DE;
    --hc:var(--blue)}
  #main-section.pkg .hero-in{display:grid;grid-template-columns:1.04fr 1fr;gap:49px;align-items:center}
  #main-section.pkg .hero h1{font-size:54px;line-height:1.08;font-weight:800;letter-spacing:-.028em;color:var(--ink);margin-top:14px!important;max-width:15ch}
  #main-section.pkg .hero h1 em{font-style:normal;color:var(--blue)}
  #main-section.pkg .hero .lede{margin-top:18px!important;max-width:54ch}
  #main-section.pkg .hero .lede b{font-weight:700;color:var(--ink)}
  /* the five verbs the page goes on to prove */
  #main-section.pkg .hero .chips{margin-top:26px;gap:22px}
  #main-section.pkg .hero .chip{background:none;border:0;border-radius:0;padding:0;font-size:14.5px;gap:8px;color:var(--blue)}
  #main-section.pkg .hero .chip::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--hc);flex:none}
  /* the console builds itself a row at a time (.stg does the stagger) */
  #main-section.pkg .stagewrap{position:relative}
  #main-section.pkg .hero .screen{position:relative}
  /* ---- HERO DEVICE RIG: graphite hardware (both themes), light-mode screens ---- */
  /* the screens inside the rig always render on the light --mk palette, even when
     the page is dark - the tokens are re-declared here so nothing can flip them */
  #main-section.pkg .hero .devices{position:relative;
    --mk:#FFFFFF;--mk-2:#FBFCFD;--art:#F6F9FB;--mk-line:#E4EAF0;--mk-line2:#EEF2F6;
    --mk-sel:#EDF7FC;--mk-selb:#CFE7F5;--mk-mut:#8494A2;--mk-ink:#1F2023;
    --blue:#0083C8;--blue-d:#006AA6;--blue-w:#EDF7FC;--bad:#C00000}
  #main-section.pkg .hero .dvc-monitor{position:relative;z-index:1}
  /* the graphite bezel supplies the frame - the screen drops its own border/shadow */
  #main-section.pkg .hero .monitor{background:linear-gradient(160deg,#242832,#111419);border-radius:16px;padding:9px;box-shadow:0 30px 70px -34px rgba(0,22,42,.72),inset 0 0 0 1px rgba(255,255,255,.05)}
  #main-section.pkg .hero .monitor .screen{border:0;box-shadow:none;border-radius:9px}
  #main-section.pkg .hero .browser-bar{display:flex;align-items:center;gap:7px;padding:9px 13px;background:var(--mk-2);border-bottom:1px solid var(--mk-line2)}
  #main-section.pkg .hero .browser-bar .tl{width:10px;height:10px;border-radius:50%;background:#D6DEE6;flex:none}
  #main-section.pkg .hero .browser-bar .tl:first-child{background:var(--blue)}
  #main-section.pkg .hero .browser-bar .bt{margin-left:7px;font-size:11.5px;font-weight:600;color:var(--mk-mut);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  #main-section.pkg .hero .monitor-stand{display:flex;flex-direction:column;align-items:center}
  #main-section.pkg .hero .monitor-stand .neck{width:82px;height:20px;background:linear-gradient(#3a4150,#262b34)}
  #main-section.pkg .hero .monitor-stand .base{width:196px;height:10px;border-radius:100px;background:linear-gradient(#454d5e,#1c212a);margin-top:2px;box-shadow:0 10px 20px -8px rgba(0,15,30,.6)}
  /* phone: leans into the monitor's bottom-right corner, screen also light */
  #main-section.pkg .hero .dvc-phone{position:absolute;right:-36px;bottom:-54px;width:clamp(118px,14.5vw,146px);z-index:3}
  #main-section.pkg .hero .phone{position:relative;background:linear-gradient(160deg,#242832,#0d1015);border-radius:26px;padding:6px;box-shadow:0 26px 48px -20px rgba(0,22,42,.78),inset 0 0 0 1px rgba(255,255,255,.06)}
  #main-section.pkg .hero .phone::before{content:"";position:absolute;top:11px;left:50%;transform:translateX(-50%);width:40px;height:7px;border-radius:100px;background:#07090d;z-index:2}
  #main-section.pkg .hero .phone::after{content:"";position:absolute;right:-2px;top:74px;width:2px;height:32px;border-radius:2px;background:#20242c}
  #main-section.pkg .hero .phone .screen{border:0;box-shadow:none;border-radius:20px;overflow:hidden}
  #main-section.pkg .hero .ph-status{display:flex;align-items:center;justify-content:space-between;padding:9px 14px 5px;font-size:10px;font-weight:700;color:var(--mk-ink)}
  #main-section.pkg .hero .ph-status .sys{display:flex;align-items:center;gap:3px}
  #main-section.pkg .hero .ph-status .sys i{width:5px;height:8px;border-radius:1px;background:var(--mk-ink);opacity:.5}
  #main-section.pkg .hero .ph-status .sys i.bat{width:13px;opacity:.7}
  #main-section.pkg .hero .dvc-phone .cbar{padding:6px 14px}
  #main-section.pkg .hero .dvc-phone .cbar h3{font-size:12px}
  #main-section.pkg .hero .ph-body{display:grid;gap:8px;padding:10px 12px 14px}
  #main-section.pkg .hero .ph-body .hero-kpi{padding:10px 12px}
  #main-section.pkg .hero .ph-body .hero-kpi .v{font-size:22px}
  #main-section.pkg .hero .ph-body .strip{height:12px}
  /* tablet: landscape floor device, tucks into the monitor bottom-left corner */
  #main-section.pkg .hero .dvc-tablet{position:absolute;left:-48px;bottom:-58px;width:clamp(168px,21vw,214px);z-index:2}
  #main-section.pkg .hero .tablet{position:relative;background:linear-gradient(160deg,#242832,#111419);border-radius:18px;padding:8px;box-shadow:0 24px 46px -20px rgba(0,22,42,.75),inset 0 0 0 1px rgba(255,255,255,.05)}
  #main-section.pkg .hero .tablet::before{content:"";position:absolute;top:50%;left:4px;transform:translateY(-50%);width:4px;height:4px;border-radius:50%;background:#3a4150;z-index:2}
  #main-section.pkg .hero .tablet .screen{border:0;box-shadow:none;border-radius:12px;overflow:hidden}
  #main-section.pkg .hero .dvc-tablet .cbar{padding:8px 12px}
  #main-section.pkg .hero .dvc-tablet .cbar h3{font-size:12px}
  #main-section.pkg .hero .dvc-tablet .kpis{padding:0 12px 12px;gap:8px;grid-template-columns:1fr 1fr}
  #main-section.pkg .hero .dvc-tablet .kpi{padding:9px 10px}
  #main-section.pkg .hero .dvc-tablet .kpi .v{font-size:17px}
  #main-section.pkg .hero .cbar{flex-wrap:nowrap}
  #main-section.pkg .hero .cbar h3{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  #main-section.pkg .lstat{display:grid;gap:8px;padding:14px 16px 0}
  #main-section.pkg .lrow{display:grid;grid-template-columns:1fr auto auto;gap:12px;align-items:center;border:1px solid var(--mk-line2);border-radius:14px;padding:10px 12px;box-shadow:var(--sh-micro);background:var(--mk)}
  #main-section.pkg .lrow.sel{background:var(--mk-sel);border-color:var(--mk-selb)}
  #main-section.pkg .lrow .nm{font-size:12.5px;font-weight:600;color:var(--mk-ink)}
  #main-section.pkg .lrow .mt{font-size:11px;color:var(--mk-mut);font-variant-numeric:tabular-nums}
  #main-section.pkg .hero .kpis{padding:14px 16px 0}
  #main-section.pkg .hero .donut{width:126px;height:126px}
  #main-section.pkg .hero .dnt{gap:22px;justify-content:center}
  #main-section.pkg .hero .legend{grid-template-columns:1fr;flex:none;min-width:0;width:232px}
  #main-section.pkg .hero .prov{margin:12px 16px 16px}

  /* ================= B1 - PROOF DIALS ================= */
  #main-section.pkg .stats{padding:clamp(30px,4.6vw,20px)}
  #main-section.pkg .dials{display:grid;grid-template-columns:repeat(3,1fr)}
  #main-section.pkg .dial{display:flex;align-items:center;gap:20px;padding:4px clamp(18px,2.4vw,38px)}
  #main-section.pkg .dial:first-child{padding-left:0}
  #main-section.pkg .dial:last-child{padding-right:0}
  #main-section.pkg .dial+.dial{border-left:1px solid var(--line)}
  #main-section.pkg .dial .ring{position:relative;width:106px;height:106px;flex:none}
  #main-section.pkg .dial .ring svg{width:100%;height:100%;transform:rotate(-90deg)}
  #main-section.pkg .dial .trk{fill:none;stroke:var(--hw);stroke-width:9}
  #main-section.pkg .dial .arc{fill:none;stroke:var(--hc);stroke-width:9;stroke-linecap:round;stroke-dasharray:270;stroke-dashoffset:270;transition:stroke-dashoffset 1.9s var(--ez)}
  #main-section.pkg .dial .num{position:absolute;inset:0;display:grid;place-items:center;font-size:25px;font-weight:800;letter-spacing:-.03em;color:var(--hc);font-variant-numeric:tabular-nums}
  #main-section.pkg .dial p{font-size:15.5px;color:var(--ink2);line-height:1.45}
  #main-section.pkg .figs-note{font-size:12.5px;color:var(--ink3);margin-top:26px!important}
  @media (prefers-reduced-motion:reduce){
    #main-section.pkg .dial .arc{transition:none}
    #main-section.pkg .pane,#main-section.pkg .blurb{transition:none;transform:none}
    #main-section.pkg .conswrap{height:auto}
    #main-section.pkg .consstick{position:static;min-height:0;padding:0}
  }

  /* ================= B3 - CAPABILITIES =================
     The list is the control and the panel is the evidence: open a capability on
     the left and the product shot it produces swaps in on the right. */
  #main-section.pkg .caps{display:grid;grid-template-columns:minmax(0,.88fr) minmax(0,1fr);gap:clamp(26px,4vw,72px);align-items:start}
  #main-section.pkg .capq{border-top:1px solid var(--line)}
  #main-section.pkg .capq:last-child{border-bottom:1px solid var(--line)}
  #main-section.pkg .capq .qh{display:flex;align-items:center;gap:16px;width:100%;text-align:left;padding:22px 0;
    font-size:21px;font-weight:700;letter-spacing:-.02em;line-height:1.3;color:var(--ink3);transition:color .3s var(--ez)}
  #main-section.pkg .capq .qh:hover{color:var(--ink2)}
  #main-section.pkg .capq.open .qh{color:var(--ink)}
  /* --ink3 is bright enough in dark that a closed row read as loud as the open
     one - the list only works if the open row is obviously the open row */
  #main-section.pkg[data-theme="dark"] .capq:not(.open) .qh{color:rgba(215,236,246,.42)}
  #main-section.pkg[data-theme="dark"] .capq:not(.open) .qh:hover{color:rgba(215,236,246,.75)}
  #main-section.pkg .capq .qh i{margin-left:auto;flex:none;width:32px;height:32px;border-radius:50%;border:1.5px solid currentColor;
    display:grid;place-items:center;transition:transform .22s var(--ez),background-color .18s var(--ez),border-color .18s var(--ez),color .18s var(--ez)}
  #main-section.pkg .capq.open .qh i{transform:rotate(180deg);background:var(--hc);border-color:var(--hc);color:#fff}
  #main-section.pkg .capq .qh i svg{width:13px;height:13px}
  /* 0fr -> 1fr animates the height without a measured pixel value, and the copy
     stays in the DOM either way so it is findable and the chips keep tab order */
  #main-section.pkg .capq .qb{display:grid;grid-template-rows:0fr;transition:grid-template-rows .26s var(--ez)}
  #main-section.pkg .capq .qb>div{overflow:hidden;min-height:0}
  #main-section.pkg .capq.open .qb{grid-template-rows:1fr}
  #main-section.pkg .capq .qb p{font-size:15.5px;color:var(--ink2);line-height:1.6;max-width:52ch}
  #main-section.pkg .capq .qb .chips{margin-top:16px;padding-bottom:26px}
  #main-section.pkg .capq .chip{background:var(--hw);border-color:color-mix(in srgb,var(--hc) 32%,transparent);color:var(--hc)!important;font-size:12.5px;padding:6px 12px}
  /* the panel is the shot and nothing else - no wash, no frame, no shadow. it
     takes the shape of whichever shot is showing (16:9 for the two dashboards,
     square for the order screen) and contain keeps the whole frame visible at
     every width, including if a shot of another shape is dropped in later. */
  #main-section.pkg .cap-med{position:relative;aspect-ratio:16/9;transition:aspect-ratio .45s var(--ez)}
  /* opacity alone, not visibility: a transitioned visibility that gets
     interrupted leaves the panel blank, and aria-hidden already takes the
     off-screen ones out of the reading order */
  #main-section.pkg .cap-med .art{position:absolute;inset:0;
    opacity:0;pointer-events:none;transition:opacity .22s var(--ez)}
  #main-section.pkg .cap-med .art.on{opacity:1}
  #main-section.pkg .cap-med .art img{width:100%;height:100%;object-fit:contain;border-radius:20px}
  #main-section.pkg .capdots{display:flex;gap:8px;margin-top:20px}
  #main-section.pkg .capdots button{font-size:0;line-height:0;color:transparent}
  #main-section.pkg .capdots button{width:11px;height:11px;border-radius:100px;background:color-mix(in srgb,var(--ink) 20%,transparent);
    transition:width .26s var(--ez),background-color .26s var(--ez)}
  #main-section.pkg .capdots button[aria-current="true"]{width:36px;background:var(--hc)}
  @media (prefers-reduced-motion:reduce){
    #main-section.pkg .capq .qb,#main-section.pkg .capq .qh i,
    #main-section.pkg .cap-med,#main-section.pkg .cap-med .art{transition:none}
  }

  /* ================= B5 - THE CHALLENGE PANEL =================
     One rounded surface instead of three boxed cards: the plant photograph holds
     the left edge, the three costs read down the right on hairlines. */
  #main-section.pkg .chal{display:grid;grid-template-columns:minmax(0,.7fr) minmax(0,1.3fr);
    background:var(--card);border-radius:40px;overflow:hidden;box-shadow:0 0 0 1px var(--line),var(--sh-feat)}
  #main-section.pkg .chal-shot{position:relative;min-height:440px;background:var(--navy);margin:0!important}
  #main-section.pkg .chal-shot img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 40%}
  #main-section.pkg .chal-shot::after{content:"";position:absolute;inset:0;
    background:linear-gradient(180deg,rgba(8,21,36,0) 40%,rgba(8,21,36,.88) 100%)}
  #main-section.pkg .chal-shot figcaption{position:absolute;left:26px;right:26px;bottom:24px;z-index:2;
    font-size:13.5px;line-height:1.5;font-weight:600;color:#fff}
  #main-section.pkg .chal-list{padding:clamp(8px,1.2vw,16px)}
  #main-section.pkg .cost{display:grid;grid-template-columns:1fr 186px;gap:clamp(16px,2vw,30px);align-items:center;
    padding:clamp(20px,2.2vw,30px) clamp(12px,1.6vw,22px)}
  #main-section.pkg .cost+.cost{border-top:1px solid var(--line)}
  #main-section.pkg .cost h3{display:flex;align-items:center;gap:11px;font-size:21px;font-weight:700;letter-spacing:-.02em;color:var(--ink);line-height:1.25}
  #main-section.pkg .cost h3::before{content:"";width:10px;height:10px;border-radius:50%;background:var(--hc);flex:none}
  #main-section.pkg .cost p{font-size:14.5px;color:var(--ink2);margin-top:10px!important;line-height:1.55;padding-left:21px}
  #main-section.pkg .cost .dia{border-radius:20px;background:var(--hw);padding:15px;height:112px;overflow:hidden}
  #main-section.pkg .cost .dia .bars{height:100%;display:flex;flex-direction:column;justify-content:center}
  #main-section.pkg .cost .dia .hbar{display:grid;grid-template-columns:1fr auto;gap:3px 8px}
  #main-section.pkg .cost .dia .hbar+.hbar{margin-top:14px}
  #main-section.pkg .cost .dia .hbar .n{font-size:10.5px}
  #main-section.pkg .cost .dia .hbar .v{font-size:11.5px}
  #main-section.pkg .cost .dia .hbar .t{grid-column:1/-1;height:8px;background:color-mix(in srgb,var(--hc) 16%,transparent)}
  /* shift timeline: the lost shift is the only marked one */
  #main-section.pkg .shifts{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;align-items:end;height:56px;margin-bottom:10px}
  #main-section.pkg .shifts i{display:block;height:100%;border-radius:10px;background:color-mix(in srgb,var(--hc) 26%,transparent)}
  #main-section.pkg .shifts i.stop{background:repeating-linear-gradient(45deg,var(--hc) 0 5px,color-mix(in srgb,var(--hc) 55%,transparent) 5px 10px);height:44%}
  #main-section.pkg .shifts-x{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;font-size:10px;color:var(--ink3);text-align:center}
  #main-section.pkg .shifts-x b{color:var(--hc);font-weight:700}
  /* SKU stack: the ones iSERV can name are filled, the dashed ones nobody can */
  #main-section.pkg .skus{display:grid;gap:7px;height:100%;align-content:center}
  #main-section.pkg .skus div{display:flex;gap:7px}
  #main-section.pkg .skus span{height:15px;flex:1;border-radius:7px;background:var(--card);border:1px solid color-mix(in srgb,var(--hc) 22%,transparent)}
  #main-section.pkg .skus span.q{background:var(--hc);border-color:var(--hc)}
  #main-section.pkg .skus span.x{background:transparent;border-style:dashed}
  /* one cost article lifts at a time on a 3s cycle (JS toggles .active): a
     pop up + accent wash. inset ring not outer shadow - the card clips it. */
  #main-section.pkg .cost{border-radius:22px;transition:transform .55s var(--ez),background-color .55s var(--ez),box-shadow .55s var(--ez)}
  #main-section.pkg .cost.active{transform:translateY(-6px) scale(1.02);z-index:1;
    background:var(--blue-w);
    box-shadow:inset 0 0 0 1.5px color-mix(in srgb,var(--hc) 35%,transparent),0 16px 34px -16px color-mix(in srgb,var(--hc) 60%,transparent)}
  #main-section.pkg[data-theme="dark"] .cost.active{background:color-mix(in srgb,var(--hc) 20%,var(--card))}
  @media (prefers-reduced-motion:reduce){#main-section.pkg .cost{transition:none}}

  /* ================= B7 - CONSOLES ================= */
  /* the panel pins and the consoles step through one per screen of scroll, plus
     a tail so the last one is read before the band lets go */
  #main-section.pkg .conswrap{height:340vh}
  #main-section.pkg .consstick{position:sticky;top:0;min-height:100vh;display:flex;flex-direction:column;justify-content:center;padding:clamp(20px,4vh,48px) 0}
  /* the consoles are a tab strip across the top over a wash rather than a block
     of colour, so the screen inside stays the brightest thing in the section. */
  #main-section.pkg .shell{margin-top:clamp(28px,2.4vw,40px);border-radius:24px;padding:clamp(16px,1.8vw,26px) clamp(18px,2.2vw,32px) clamp(18px,2.2vw,32px);background:color-mix(in srgb,var(--hc) 6%,var(--srf2));transition:background-color .55s var(--ez)}
  #main-section.pkg[data-theme="dark"] .shell{background:color-mix(in srgb,var(--hc) 11%,var(--srf2))}
  /* underline tabs, not filled pills: the dark-theme blue is light enough that
     a filled pill would need white text it cannot carry */
  #main-section.pkg .picks{display:flex;flex-wrap:wrap;gap:clamp(14px,2.2vw,30px);margin:0 0 clamp(16px,1.8vw,24px);border-bottom:1px solid color-mix(in srgb,var(--ink) 12%,transparent)}
  #main-section.pkg .pick{position:relative;padding:0 1px 13px;font-size:clamp(13.5px,1.1vw,15px);font-weight:600;color:var(--ink3);transition:color .25s var(--ez)}
  #main-section.pkg .pick::after{content:"";position:absolute;left:0;right:0;bottom:-1px;height:2px;background:var(--hc);transform:scaleX(0);transform-origin:left center;transition:transform .35s var(--ez)}
  #main-section.pkg .pick:hover{color:var(--ink)}
  #main-section.pkg .pick[aria-selected="true"]{color:var(--ink);font-weight:700}
  #main-section.pkg .pick[aria-selected="true"]::after{transform:scaleX(1)}
  #main-section.pkg .shell-in{display:grid;grid-template-columns:minmax(0,232px) minmax(0,1fr);gap:clamp(20px,2.4vw,34px);align-items:center}
  #main-section.pkg .blurb h3{font-size:clamp(21px,1.9vw,26px);line-height:1.18;font-weight:800;letter-spacing:-.025em;color:var(--ink)}
  #main-section.pkg .blurb p{font-size:14.5px;line-height:1.55;color:var(--ink2);margin-top:11px!important;max-width:34ch}
  #main-section.pkg .blurb .src{display:flex;align-items:center;gap:9px;font-size:12px;font-weight:600;color:var(--ink);margin-top:16px!important;padding-top:13px!important;border-top:1px solid color-mix(in srgb,var(--hc) 45%,transparent)}
  #main-section.pkg .blurb .src i{width:9px;height:9px;border-radius:50%;background:var(--hc);flex:none}
  #main-section.pkg .bezel{background:color-mix(in srgb,var(--hw) 55%,var(--mk));border:1px solid var(--line);border-radius:26px;padding:clamp(9px,1.1vw,14px)}
  #main-section.pkg[data-theme="dark"] .bezel{background:rgba(255,255,255,.04);box-shadow:inset 0 1px 0 rgba(255,255,255,.10)}
  #main-section.pkg .cscreen{background:var(--mk);border:1px solid var(--mk-line);border-radius:20px;overflow:hidden;
    display:grid;grid-template-columns:auto minmax(0,1fr)}
  /* one rail for all three consoles, because it is one product. :has() lights
     whichever entry belongs to the pane currently on screen. */
  #main-section.pkg .cnav{width:clamp(120px,9.5vw,146px);border-right:1px solid var(--mk-line2);background:var(--mk-2);padding:14px 9px;display:flex;flex-direction:column;gap:1px}
  #main-section.pkg .cnav .bd{display:flex;align-items:center;gap:7px;font-size:12.5px;font-weight:800;color:var(--mk-ink);padding:0 8px 13px}
  #main-section.pkg .cnav .bd i{width:15px;height:15px;border-radius:5px;background:var(--hc);flex:none}
  #main-section.pkg .cnav p{font-size:11.5px;color:var(--mk-mut);padding:7px 8px;border-radius:8px;line-height:1.3;transition:background-color .4s var(--ez),color .4s var(--ez)}
  #main-section.pkg .cscreen:has(#p-oee.on) .cnav [data-nav="oee"],
  #main-section.pkg .cscreen:has(#p-parts.on) .cnav [data-nav="parts"],
  #main-section.pkg .cscreen:has(#p-avail.on) .cnav [data-nav="avail"]{color:var(--mk-ink);font-weight:600;background:var(--mk-sel)}
  #main-section.pkg .cbody{padding:15px 16px 16px}
  /* both stacks hold every state in one grid cell, so the shell keeps one height
     across the whole band and a console change is a crossfade, not a jump.
     visibility does the hiding - same idiom as the capability artwork above - and
     it takes the panes out of the tab order and the a11y tree the way hidden did. */
  #main-section.pkg .cpanes,#main-section.pkg .blurbs{display:grid;grid-template-columns:minmax(0,1fr)}
  #main-section.pkg .pane,#main-section.pkg .blurb{grid-area:1/1;opacity:0;visibility:hidden;
    transition:opacity .2s var(--ez),transform .2s var(--ez),visibility 0s .2s}
  #main-section.pkg .pane.on,#main-section.pkg .blurb.on{opacity:1;visibility:visible;
    transition:opacity .36s var(--ez) .12s,transform .36s var(--ez) .12s,visibility 0s}
  /* only the copy lifts - the screen crossfades in place, the way a real app
     repaints. a lift there would only be clipped by the bezel anyway. */
  #main-section.pkg .blurb{transform:translateY(7px)}
  #main-section.pkg .blurb.on{transform:none}
  #main-section.pkg .csplit{display:grid;grid-template-columns:1.35fr 1fr;gap:12px;margin-top:12px}
  /* availability pane: the downtime-reason split and the shift strip, in the
     product's own chart colours */
  #main-section.pkg .dnt{display:flex;align-items:center;gap:26px;flex-wrap:wrap}
  #main-section.pkg .donut{position:relative;width:168px;height:168px;border-radius:50%;flex:none;
    background:conic-gradient(var(--c1) 0 36%,var(--c2) 36% 63%,var(--c3) 63% 77%,var(--c4) 77% 88%,var(--c5) 88% 95%,var(--c6) 95% 99%,var(--c7) 99% 100%)}
  #main-section.pkg .donut::after{content:"";position:absolute;inset:27%;border-radius:50%;background:var(--mk)}
  /* the pie sweeps in clockwise when its screen arrives - and again each time a
     console pane is re-shown, because display:none -> block restarts the animation */
  #main-section.pkg .donut{-webkit-mask:conic-gradient(#000 var(--pkw),#0000 0);mask:conic-gradient(#000 var(--pkw),#0000 0)}
  #main-section.pkg .in .donut{animation:pk-pie 1.7s var(--ez) both}
  @keyframes pk-pie{from{--pkw:0deg}to{--pkw:360deg}}
  #main-section.pkg .legend{flex:1;min-width:200px;display:grid;grid-template-columns:1fr 1fr;gap:7px 14px}
  #main-section.pkg .cscreen .legend{grid-template-columns:1fr}
  #main-section.pkg .cscreen .dnt{gap:18px}
  #main-section.pkg .cscreen .donut{width:132px;height:132px}
  #main-section.pkg .legend li{display:flex;align-items:center;gap:8px;font-size:11.5px;color:var(--mk-mut)}
  #main-section.pkg .legend i{width:9px;height:9px;border-radius:3px;flex:none;background:var(--c)}
  #main-section.pkg .legend b{margin-left:auto;font-weight:700;color:var(--mk-ink);font-variant-numeric:tabular-nums}
  #main-section.pkg .strip{display:flex;gap:2px;height:16px;border-radius:100px;overflow:hidden}
  #main-section.pkg .strip i{display:block;flex:var(--f);background:var(--ok)}
  #main-section.pkg .strip i.dn{background:var(--bad)}
  #main-section.pkg .strip-x{display:flex;justify-content:space-between;font-size:10.5px;color:var(--mk-mut);margin-top:8px}

  /* pinning only works while a whole console fits on screen at once. on a
     shorter viewport the band scrolls normally instead - same fallback the
     narrow breakpoint already uses. */
  @media (max-height:820px){
    #main-section.pkg .conswrap{height:auto}
    #main-section.pkg .consstick{position:static;min-height:0;padding:0}
  }

  /* ================= BUSINESS VALUE ================= */
  #main-section.pkg .vals{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(30px,3.4vw,58px)}
  /* no card, no ring, no figure: the icon sits in its own washed disc and the
     words carry the value on their own */
  #main-section.pkg .val{display:flex;flex-direction:column;align-items:center;text-align:center}
  #main-section.pkg .val .ic{width:clamp(104px,9vw,128px);height:clamp(104px,9vw,128px);border-radius:50%;background:var(--blue);display:grid;place-items:center;flex:none}
  #main-section.pkg .val .ic svg{width:clamp(40px,3.6vw,48px);height:clamp(40px,3.6vw,48px);color:var(--art)}
  #main-section.pkg .val h3{font-size:20px;font-weight:700;color:var(--ink);line-height:1.3;margin-top:26px!important}
  #main-section.pkg .val p{font-size:15px;color:var(--ink2);margin-top:10px!important;line-height:1.55;max-width:34ch}
  /* a hairline rule sits between each value (vertical on desktop) */
  #main-section.pkg .vals .val+.val{border-left:1px solid var(--line)}
  /* the three value icons are live mini-dashboards now, so the disc becomes a
     dark surface the data-viz reads against instead of the flat blue */
  #main-section.pkg .val .ic-rev,#main-section.pkg .val .ic-cost,#main-section.pkg .val .ic-avail{background:#0082C8;overflow:hidden}
  /* revenue: a rising line that redraws on a loop, head point pulsing */
  #main-section.pkg .val .ic-rev svg{width:62%;height:62%}
  #main-section.pkg .ic-rev .ln-area{fill:rgba(255,255,255,.22);stroke:none}
  #main-section.pkg .ic-rev .ln{fill:none;stroke:#FFFFFF;stroke-width:5;stroke-linecap:round;stroke-linejoin:round;
    stroke-dasharray:112;stroke-dashoffset:112;animation:pk-rev 3.4s var(--ez) infinite}
  #main-section.pkg .ic-rev .ln-dot{fill:#FFFFFF;stroke:#FFFFFF;stroke-width:3;animation:pk-revdot 3.4s var(--ez) infinite}
  @keyframes pk-rev{0%{stroke-dashoffset:112}55%,100%{stroke-dashoffset:0}}
  @keyframes pk-revdot{0%,45%{opacity:0}60%,100%{opacity:1}}
  /* cost: two bars grow on a loop - red high (the reactive cost), green low */
  #main-section.pkg .ic-cost .barwrap{display:flex;align-items:flex-end;gap:10px;width:52%;height:56%}
  #main-section.pkg .ic-cost .bar{flex:1;border-radius:5px 5px 2px 2px;transform-origin:bottom;height:100%}
  #main-section.pkg .ic-cost .bar.hi{background:#FFFFFF;animation:pk-barhi 3.2s var(--ez) infinite}
  #main-section.pkg .ic-cost .bar.lo{background:rgba(255,255,255,.5);animation:pk-barlo 3.2s var(--ez) infinite}
  @keyframes pk-barhi{0%{transform:scaleY(.12)}45%,100%{transform:scaleY(.92)}}
  @keyframes pk-barlo{0%{transform:scaleY(.12)}45%,100%{transform:scaleY(.44)}}
  /* availability: machine rows, each with a blinking green live dot */
  #main-section.pkg .ic-avail .mlist{display:flex;flex-direction:column;gap:6px;width:74%}
  #main-section.pkg .ic-avail .mrow{display:flex;align-items:center;gap:6px;font-size:9.5px;font-weight:600;
    color:#FFFFFF;background:rgba(255,255,255,.16);border-radius:100px;padding:3px 8px;line-height:1}
  #main-section.pkg .ic-avail .mrow .nm{flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-variant-numeric:tabular-nums}
  #main-section.pkg .ic-avail .mrow .lv{font-size:8px;color:#FFFFFF;font-weight:700}
  #main-section.pkg .ic-avail .dot{width:6px;height:6px;border-radius:50%;background:#FFFFFF;flex:none;
    animation:pk-live 1.6s ease-in-out infinite}
  #main-section.pkg .ic-avail .mrow:nth-child(2) .dot{animation-delay:.5s}
  #main-section.pkg .ic-avail .mrow:nth-child(3) .dot{animation-delay:1s}
  @keyframes pk-live{0%{box-shadow:0 0 0 0 rgba(255,255,255,.6);opacity:1}70%{box-shadow:0 0 0 5px rgba(255,255,255,0);opacity:.45}100%{box-shadow:0 0 0 0 rgba(255,255,255,0);opacity:1}}
  @media (prefers-reduced-motion:reduce){
    #main-section.pkg .ic-rev .ln,#main-section.pkg .ic-rev .ln-dot,
    #main-section.pkg .ic-cost .bar,#main-section.pkg .ic-avail .dot{animation:none}
    #main-section.pkg .ic-rev .ln{stroke-dashoffset:0}
    #main-section.pkg .ic-cost .bar.hi{transform:scaleY(.92)}
    #main-section.pkg .ic-cost .bar.lo{transform:scaleY(.44)}
  }

  /* ================= B12 - CLOSING CTA ================= */
  #main-section.pkg .cta{padding:0;background:var(--navy)}
  #main-section.pkg .cta-in{display:grid;grid-template-columns:1fr 1fr}
  #main-section.pkg .cta-copy{max-width:calc(var(--wrap)/2);margin-left:auto;padding:clamp(56px,6.4vw,96px) clamp(26px,3.4vw,60px) clamp(56px,6.4vw,96px) 0}
  #main-section.pkg .cta .eyb{color:var(--navy-acc)}
  #main-section.pkg .cta .shead h2{color:#fff}
  #main-section.pkg .cta .shead h2 em{font-style:normal;color:var(--navy-acc)}
  #main-section.pkg .cta .lede{color:rgba(255,255,255,.72)}
  #main-section.pkg .ex{margin-top:26px!important;display:grid;gap:11px}
  #main-section.pkg .ex li{display:flex;gap:11px;align-items:flex-start;font-size:15px;color:rgba(215,236,246,.9)}
  #main-section.pkg .ex li svg{width:16px;height:16px;color:var(--navy-acc);flex:none;margin-top:3px}
  #main-section.pkg .cta .btn.gho{background:transparent;border-color:rgba(255,255,255,.28);color:#fff!important}
  #main-section.pkg .cta .btn.gho:hover{border-color:var(--navy-acc)}
  #main-section.pkg .cta-med{position:relative;overflow:hidden;background:var(--navy-2)}
  #main-section.pkg .cta-med img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  /* the CTA video does not autoplay: a play button over the poster opens it in a modal */
  #main-section.pkg .cta-play{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);z-index:2;width:66px;height:66px;border-radius:50%;border:0;display:grid;place-items:center;background:#fff;color:var(--blue);cursor:pointer;box-shadow:0 14px 34px -12px rgba(0,0,0,.7);transition:transform .2s var(--ez)}
  #main-section.pkg .cta-play:hover{transform:translate(-50%,-50%) scale(1.07)}
  #main-section.pkg .cta-play svg{width:22px;height:22px;fill:currentColor;stroke:none;margin-left:3px}
  @media (prefers-reduced-motion:reduce){#main-section.pkg .cta-play{transition:none}}

  /* ================= RESPONSIVE (blueprint §10) ================= */
  @media (max-width:1024px){
    #main-section.pkg{--wrap:min(1344px,92vw);--pad:clamp(44px,6vw,56px)}
    #main-section.pkg .hero h1{font-size:40px}
    #main-section.pkg .shead h2{font-size:34px}
    #main-section.pkg .hero-in,#main-section.pkg .cta-in{grid-template-columns:1fr;gap:44px}
    #main-section.pkg .cta-in{gap:0}
    #main-section.pkg .cta-copy{max-width:var(--wrap);margin:0 auto;padding:64px 0}
    #main-section.pkg .cta-med{min-height:290px}
    #main-section.pkg .vals{grid-template-columns:repeat(1,1fr)}
    #main-section.pkg .vals .val+.val{border-left:0;border-top:1px solid var(--line);padding-top:clamp(30px,5vw,44px)}
    #main-section.pkg .caps{grid-template-columns:minmax(0,1fr);gap:34px}
    #main-section.pkg .cap-med{max-width:620px}
    #main-section.pkg .conswrap{height:auto}
    #main-section.pkg .consstick{position:static;min-height:0;padding:0}
    #main-section.pkg .shell-in{grid-template-columns:minmax(0,1fr);gap:24px}
    #main-section.pkg .csplit{grid-template-columns:1fr}
    #main-section.pkg .chal{grid-template-columns:1fr;border-radius:32px}
    #main-section.pkg .chal-shot{min-height:0;aspect-ratio:5/4}
    #main-section.pkg .chal-shot img{object-position:50% 68%}
  }
  @media (max-width:767px){
    #main-section.pkg{--wrap:min(1344px,90vw);--pad:40px}
    #main-section.pkg .hero h1{font-size:32px;max-width:none}
    #main-section.pkg .shead h2{font-size:27px}
    #main-section.pkg .vals{grid-template-columns:1fr}
    #main-section.pkg .capq .qh{font-size:18px;padding:18px 0}
    #main-section.pkg .shell{padding:16px;border-radius:18px}
    #main-section.pkg .picks{gap:16px}
    #main-section.pkg .cnav{display:none}
    #main-section.pkg .dials{grid-template-columns:1fr}
    #main-section.pkg .dial{padding:18px 0}
    #main-section.pkg .dial+.dial{border-left:0;border-top:1px solid var(--line)}
    #main-section.pkg .dial .ring{width:84px;height:84px}
    #main-section.pkg .dial .num{font-size:21px}
    #main-section.pkg .chal{border-radius:26px}
    #main-section.pkg .cost{grid-template-columns:1fr;gap:18px}
    #main-section.pkg .cost .dia{max-width:320px}
    #main-section.pkg .btn{width:100%;justify-content:center}
    #main-section.pkg .btns{gap:10px}
    #main-section.pkg .sn-name,#main-section.pkg .sn-cta{display:none}
    #main-section.pkg .subnav-in{padding:6px 0}
    #main-section.pkg section[id]{scroll-margin-top:62px}
    #main-section.pkg .bezel{padding:8px}
    #main-section.pkg .cbody .kpis{grid-template-columns:repeat(2,1fr)}
  }
  @media (max-width:480px){
    #main-section.pkg .cap-art{aspect-ratio:16/11}
    #main-section.pkg .hero .kpis{gap:6px}
    #main-section.pkg .kpi{padding:10px}
    #main-section.pkg .kpi .v{font-size:18px}
    #main-section.pkg .hero .dvc-tablet{display:none}
  }

  /* ================= SCHEDULE-DEMO POPUP =================
     Deliberately NOT scoped to #main-section: the script moves this node to
     <body> so a transformed Elementor ancestor cannot break position:fixed.
     It therefore carries its own tokens and !important.
     ====================================================== */
  .pk-schd{
    --sc-card:#FFFFFF;--sc-srf:#F4F7FA;--sc-ink:#1F2023;--sc-ink2:rgba(0,0,0,.70);
    --sc-line:#EAEAEA;--sc-blue:#0083C8;--sc-wash:#EDF7FC;
    --sc-ff:"Noto Sans",-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
    --sc-ez:cubic-bezier(.2,0,0,1);
    position:fixed!important;inset:0!important;z-index:999999!important;
    display:flex!important;align-items:center!important;justify-content:center!important;
    padding:20px!important;margin:0!important;background:rgba(13,27,46,.62)!important;
    -webkit-backdrop-filter:blur(6px)!important;backdrop-filter:blur(6px)!important;
    opacity:0!important;visibility:hidden!important;
    transition:opacity .25s var(--sc-ez),visibility .25s var(--sc-ez)!important;
    font-family:var(--sc-ff)!important;color:var(--sc-ink)!important;line-height:1.6!important}
  .pk-schd[data-theme="dark"]{--sc-card:#122C44;--sc-srf:#0E2438;--sc-ink:#FFFFFF;--sc-ink2:rgba(215,236,246,.82);--sc-line:rgba(255,255,255,.13);--sc-blue:#39A8DE;--sc-wash:rgba(0,131,200,.16)}
  .pk-schd[hidden]{display:flex!important}
  .pk-schd.is-open{opacity:1!important;visibility:visible!important}
  .pk-schd,.pk-schd *,.pk-schd *::before,.pk-schd *::after{box-sizing:border-box}
  .pk-schd-panel{position:relative!important;width:100%!important;max-width:480px!important;max-height:88vh!important;overflow-y:auto!important;background:var(--sc-card)!important;color:var(--sc-ink)!important;border-radius:24px!important;border:1px solid var(--sc-line)!important;box-shadow:0 40px 90px -30px rgba(0,0,0,.6)!important;padding:clamp(24px,4vw,36px)!important;transform:translateY(18px) scale(.98)!important;transition:transform .28s var(--sc-ez)!important}
  .pk-schd.is-open .pk-schd-panel{transform:none!important}
  .pk-schd-close{position:absolute!important;top:14px!important;right:14px!important;width:34px!important;height:34px!important;padding:0!important;border-radius:50%!important;display:grid!important;place-items:center!important;background:var(--sc-srf)!important;border:1px solid var(--sc-line)!important;color:var(--sc-ink)!important;cursor:pointer!important;transition:background-color .2s var(--sc-ez),border-color .2s var(--sc-ez)!important}
  .pk-schd-close:hover{background:var(--sc-wash)!important;border-color:var(--sc-blue)!important}
  .pk-schd-close svg{width:15px!important;height:15px!important;display:block!important}
  .pk-schd-head{padding-right:36px!important;margin-bottom:22px!important}
  .pk-schd-head .eyb{display:flex!important;align-items:center!important;gap:9px!important;margin:0 0 10px!important;padding:0!important;font-size:12px!important;font-weight:700!important;letter-spacing:.17em!important;text-transform:uppercase!important;color:var(--sc-blue)!important}
  .pk-schd-head .eyb::before{content:""!important;width:22px!important;height:2px!important;border-radius:2px!important;background:currentColor!important;flex:none!important}
  .pk-schd-head h3{font-size:24px!important;font-weight:700!important;letter-spacing:-.02em!important;line-height:1.2!important;margin:0 0 8px!important;padding:0!important;color:var(--sc-ink)!important}
  .pk-schd-head p{font-size:14px!important;line-height:1.6!important;color:var(--sc-ink2)!important;margin:0!important;padding:0!important}
  .pk-schd-form{width:100%!important}
  .pk-schd-form .frm_forms,.pk-schd-form .elementor-widget-shortcode{max-width:100%!important;margin:0!important}
  .pk-schd-form input[type=text],.pk-schd-form input[type=email],.pk-schd-form input[type=tel],.pk-schd-form input[type=number],.pk-schd-form input[type=url],.pk-schd-form select,.pk-schd-form textarea{font-family:var(--sc-ff)!important;font-size:15px!important;padding:12px 15px!important;border-radius:100px!important;border:1px solid var(--sc-line)!important;background:var(--sc-srf)!important;color:var(--sc-ink)!important;width:100%!important}
  .pk-schd-form textarea{border-radius:12px!important;resize:vertical!important}
  .pk-schd-form label{font-size:13px!important;font-weight:600!important;color:var(--sc-ink2)!important}
  .pk-schd-form .frm_submit button,.pk-schd-form button[type=submit],.pk-schd-form input[type=submit]{background:var(--sc-blue)!important;color:#fff!important;border:0!important;border-radius:100px!important;font-family:var(--sc-ff)!important;font-weight:700!important;font-size:15px!important;padding:14px 26px!important;cursor:pointer!important;width:auto!important}
  .pk-schd-empty{font-size:14px!important;line-height:1.6!important;color:var(--sc-ink2)!important;margin:0!important;padding:0!important}
  .pk-schd-empty a{color:var(--sc-blue)!important;font-weight:600!important;text-decoration:none!important}
  .pk-schd :focus-visible{outline:2px solid var(--sc-blue)!important;outline-offset:3px!important;border-radius:4px}
  @media (max-width:520px){.pk-schd{padding:12px!important}.pk-schd-panel{max-height:92vh!important}}
  @media (prefers-reduced-motion:reduce){.pk-schd{transition:none!important}.pk-schd-panel{transform:none!important;transition:none!important}}
  /* ---- CTA video modal: same overlay pattern as .pk-schd, black panel for the video ---- */
  .pk-vid{position:fixed!important;inset:0!important;z-index:999999!important;display:flex!important;align-items:center!important;justify-content:center!important;padding:20px!important;margin:0!important;background:rgba(13,27,46,.72)!important;-webkit-backdrop-filter:blur(6px)!important;backdrop-filter:blur(6px)!important;opacity:0!important;visibility:hidden!important;transition:opacity .25s cubic-bezier(.2,0,0,1),visibility .25s cubic-bezier(.2,0,0,1)!important}
  .pk-vid[hidden]{display:flex!important}
  .pk-vid.is-open{opacity:1!important;visibility:visible!important}
  .pk-vid-panel{position:relative!important;width:100%!important;max-width:920px!important;border-radius:16px!important;overflow:hidden!important;background:#000!important;box-shadow:0 40px 90px -30px rgba(0,0,0,.7)!important;transform:translateY(18px) scale(.98)!important;transition:transform .28s cubic-bezier(.2,0,0,1)!important}
  .pk-vid.is-open .pk-vid-panel{transform:none!important}
  .pk-vid-panel video{display:block!important;width:100%!important;height:auto!important;max-height:82vh!important;background:#000!important}
  .pk-vid-close{position:absolute!important;top:10px!important;right:10px!important;width:36px!important;height:36px!important;padding:0!important;border-radius:50%!important;display:grid!important;place-items:center!important;background:rgba(0,0,0,.55)!important;border:0!important;color:#fff!important;cursor:pointer!important;z-index:2!important;transition:background-color .2s ease!important}
  .pk-vid-close:hover{background:rgba(0,0,0,.85)!important}
  .pk-vid-close svg{width:16px!important;height:16px!important;display:block!important}
  @media (prefers-reduced-motion:reduce){.pk-vid{transition:none!important}.pk-vid-panel{transform:none!important;transition:none!important}}
</style>

<section id="main-section" class="pkg" data-page="packaging-landing">
  <script>
    /* Resolve the saved/system theme before the section paints, so there is no flash.
       Same mechanism as ithena-homepage_4_2.html: data-theme on #main-section. */
    (function(){try{var s=localStorage.getItem("ithena-theme");
      var d=s?s==="dark":window.matchMedia("(prefers-color-scheme: dark)").matches;
      document.currentScript.parentElement.setAttribute("data-theme",d?"dark":"light");}catch(e){}})();
  </script>

  <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false"><defs>
    <g id="pk-arr" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></g>
    <g id="pk-chev" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 9 7 7 7-7"/></g>
    <g id="pk-chk" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m4 12.5 5 5L20 6.5"/></g>
  </defs></svg>

  <!-- ============ B0 · HERO ============ -->
  <section class="band hero" id="top">
    <video class="hero-vid" autoplay muted loop playsinline preload="metadata" tabindex="-1" aria-hidden="true"
      poster="https://dev-website.ithena.app/wp-content/uploads/2026/09/packaging-hero-1.webp">
      <source src="https://dev-website.ithena.app/wp-content/uploads/2026/09/ecom-hero-parts-video.mp4" type="video/mp4">
    </video>
    <div class="wrap hero-in">
      <div class="hero-copy">
        <span class="eyb rv">Packaging machinery</span>
        <h1 class="rv">Every machine you ship becomes a <em>service channel</em></h1>
        <p class="lede rv">iSERV connects the packaging lines already running at your customers&rsquo; plants: live OEE and throughput off the machine, spare parts they can identify and order themselves, and wear flagged <b>before it stops the line</b>.</p>
        <div class="btns rv">
          <button type="button" class="btn pri" data-schedule-demo>Schedule a demo call <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#pk-arr"/></svg></button>
          <a class="btn sec" href="#consoles">See the consoles</a>
        </div>
        <div class="chips rv">
          <span class="chip">Monitor</span><span class="chip">Benchmark</span><span class="chip">Predict</span><span class="chip">Identify</span><span class="chip">Order</span>
        </div>
      </div>

      <div class="stagewrap rv">
        <div class="devices">

          <!-- desktop monitor on a stand -->
          <div class="dvc dvc-monitor stg">
            <div class="monitor">
              <div class="screen">
                <div class="browser-bar" aria-hidden="true">
                  <span class="tl"></span><span class="tl"></span><span class="tl"></span>
                  <span class="bt">iSERV workspace &middot; availability</span>
                </div>
                <div class="cbar">
                  <i class="dot"></i><h3>Bender &middot; L02 - availability</h3><i class="sp"></i><span class="tag">Rolling 12 days</span>
                </div>
                <div class="kpis">
                  <div class="kpi"><div class="v">11d 19:58</div><p class="l">Loaded time</p></div>
                  <div class="kpi"><div class="v">02:41:40</div><p class="l">Between failures</p></div>
                  <div class="kpi"><div class="v">21:04:07</div><p class="l">Process downtime</p></div>
                </div>
                <div class="lstat">
                  <div class="dnt">
                    <span class="donut" style="--c1:#0083C8;--c2:#39A8DE;--c3:#6DC2EA;--c4:#9AD4F2;--c5:#BFE5F8;--c6:#D7ECF6;--c7:#8FAFC4" role="img" aria-label="Downtime by reason: glue missing 36%, lunch time 27%, change over 14%, conveyor jammed 11%, belt broken 7%, pump grease missing 4%, plant not open 2%."></span>
                    <ul class="legend">
                      <li style="--c:#0083C8"><i></i>Glue missing <b>36%</b></li>
                      <li style="--c:#39A8DE"><i></i>Lunch time <b>27%</b></li>
                      <li style="--c:#6DC2EA"><i></i>Change over <b>14%</b></li>
                      <li style="--c:#9AD4F2"><i></i>Conveyor jammed <b>11%</b></li>
                      <li style="--c:#BFE5F8"><i></i>Belt broken <b>7%</b></li>
                    </ul>
                  </div>
                  <div class="strip" role="img" aria-label="Day timeline: the machine ran from 6am until 3pm, stopped until 6pm, ran again, stopped briefly around 9pm, then ran through to 1am.">
                    <i style="--f:9"></i><i class="dn" style="--f:3"></i><i style="--f:3"></i><i class="dn" style="--f:1"></i><i style="--f:4"></i>
                  </div>
                  <div class="strip-x"><span>06 am</span><span>12 pm</span><span>06 pm</span><span>01 am</span></div>
                </div>
                <div class="prov"><i class="dot"></i><span>Every stop is filed against a reason at the machine &middot; <b>glue missing</b> cost 11 hours, more than lunch and change over together</span></div>
              </div>
            </div>
            <div class="monitor-stand" aria-hidden="true"><span class="neck"></span><span class="base"></span></div>
          </div>

          <!-- tablet: floor glance, live KPIs -->
          <div class="dvc dvc-tablet">
            <div class="tablet">
              <div class="screen">
                <div class="cbar"><i class="dot"></i><h3>Bender &middot; L02</h3><i class="sp"></i><span class="tag">Live</span></div>
                <div class="kpis">
                  <div class="kpi"><div class="v">84.2%</div><p class="l">Availability</p></div>
                  <div class="kpi"><div class="v">11h</div><p class="l">Glue missing</p></div>
                </div>
              </div>
            </div>
          </div>

          <!-- phone: the same machine, mobile glance -->
          <div class="dvc dvc-phone">
            <div class="phone">
              <div class="screen">
                <div class="ph-status" aria-hidden="true"><span class="t">7:41</span><span class="sys"><i></i><i></i><i class="bat"></i></span></div>
                <div class="cbar"><i class="dot"></i><h3>Bender &middot; L02</h3></div>
                <div class="ph-body">
                  <div class="kpi hero-kpi"><div class="v">84.2%</div><p class="l">Availability, 12 days</p><p class="d dn">&minus;6.1 pts</p></div>
                  <div class="alert"><p class="t">Glue missing &middot; 11h lost</p><p class="m">Top stop reason, more than lunch and change over together</p></div>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- ============ B1 · PROOF STATS ============ -->
  <section class="band stats">
    <div class="wrap">
      <div class="dials stg">
        <div class="dial">
          <span class="ring">
            <svg viewBox="0 0 106 106" aria-hidden="true"><circle class="trk" cx="53" cy="53" r="43"/><circle class="arc" cx="53" cy="53" r="43"/></svg>
            <span class="num" data-count="40" data-suffix="%">40%</span>
          </span>
          <p>Increase in aftermarket revenue</p>
        </div>
        <div class="dial">
          <span class="ring">
            <svg viewBox="0 0 106 106" aria-hidden="true"><circle class="trk" cx="53" cy="53" r="43"/><circle class="arc" cx="53" cy="53" r="43"/></svg>
            <span class="num" data-count="50" data-suffix="%">50%</span>
          </span>
          <p>Faster order processing</p>
        </div>
        <div class="dial">
          <span class="ring">
            <svg viewBox="0 0 106 106" aria-hidden="true"><circle class="trk" cx="53" cy="53" r="43"/><circle class="arc" cx="53" cy="53" r="43"/></svg>
            <span class="num" data-count="30" data-suffix="%">30%</span>
          </span>
          <p>Reduction in unplanned downtime</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ B3 · CAPABILITIES ============ -->
  <section class="band alt" id="capabilities">
    <div class="wrap">
      <div class="shead rv">
        <span class="eyb">Capabilities</span>
        <h2>What iSERV puts on the line</h2>
        <p class="lede">Telemetry, parts and prediction run off the same connection. None of it needs a second gateway, a data warehouse, or an engineer on site to read it.</p>
      </div>
      <div class="grid caps rv">

        <div class="caplist">

          <div class="capq open" id="capq-tel">
            <button type="button" class="qh" data-cap="tel" aria-expanded="true" aria-controls="capb-tel">
              Real-time machine telemetry
              <i aria-hidden="true"><svg viewBox="0 0 24 24"><use href="#pk-chev"/></svg></i>
            </button>
            <div class="qb" id="capb-tel"><div>
              <p>Live OEE, throughput and machine health streamed straight from the packaging line, with every machine you have shipped benchmarked against the rest of the fleet.</p>
              <div class="chips">
                <span class="chip">Exact OEE monitoring</span><span class="chip">Throughput tracking</span><span class="chip">Multi-machine benchmarking</span>
              </div>
            </div></div>
          </div>

          <div class="capq" id="capq-part">
            <button type="button" class="qh" data-cap="part" aria-expanded="false" aria-controls="capb-part">
              Automated spare-parts ordering
              <i aria-hidden="true"><svg viewBox="0 0 24 24"><use href="#pk-chev"/></svg></i>
            </button>
            <div class="qb" id="capb-part"><div>
              <p>Your customer photographs the worn part, iSERV names it and puts it in the basket. Interactive catalogues cover every assembly, so a repeat order takes one tap instead of an email thread.</p>
              <div class="chips">
                <span class="chip">AI image-to-part recognition</span><span class="chip">Interactive visual cataloguing</span><span class="chip">Automated order routing</span>
              </div>
            </div></div>
          </div>

          <div class="capq" id="capq-pred">
            <button type="button" class="qh" data-cap="pred" aria-expanded="false" aria-controls="capb-pred">
              Predictive maintenance alerts
              <i aria-hidden="true"><svg viewBox="0 0 24 24"><use href="#pk-chev"/></svg></i>
            </button>
            <div class="qb" id="capb-pred"><div>
              <p>Wear is forecast from how the machine is actually running, so the alert arrives while there is still a planned window to fix it in - not after the line has stopped.</p>
              <div class="chips">
                <span class="chip">Predictive maintenance alerts</span><span class="chip">Wear-and-tear forecasting</span>
              </div>
            </div></div>
          </div>

        </div>

        <div>
          <div class="cap-med">

            <div class="art on" data-cap="tel">
              <img src="https://dev-website.ithena.app/wp-content/uploads/2026/09/pkg-oee-scaled.webp" alt="A cartoning machine on the line beside the iSERV OEE dashboard, showing availability, performance, quality and a loss breakdown for the shift." width="2560" height="1440" loading="lazy" decoding="async">
