  <!-- ============ B5 · THE PROBLEM ============ -->
  <section class="band alt" id="challenge">
    <div class="wrap">
      <div class="shead mid rv">
        <span class="eyb">Food &amp; beverage bakery challenges</span>
        <h2>After the oven ships, you go blind.</h2>
        <p class="lede">Bakery and F&amp;B equipment makers face unique challenges in a high-heat, tight-margin, multi-SKU environment. Three of them cost money on every line you have installed.</p>
      </div>
      <div class="grid chal rv">

        <figure class="chal-shot">
          <img src="https://dev-website.ithena.app/wp-content/uploads/2026/08/food-bakery-2.webp" alt="A commercial bakery line running behind a laptop showing the iSERV equipment overview." width="720" height="1080" loading="lazy" decoding="async">
          <figcaption>The line keeps running whether or not anyone is watching it. iSERV is the view of it you do not currently have.</figcaption>
        </figure>

        <div class="chal-list">

          <article class="cost">
            <div>
              <h3>Unplanned downtime.</h3>
              <p>An oven or conveyor stopping mid-run scraps the batch in it and disrupts every batch behind it. The first you hear of it is a phone call from a plant that has already lost the run.</p>
            </div>
            <div class="dia" aria-hidden="true">
              <div class="shifts"><i></i><i class="stop"></i><i></i></div>
              <div class="shifts-x"><span>Batch A</span><span><b>Batch B</b></span><span>Batch C</span></div>
            </div>
          </article>

          <article class="cost">
            <div>
              <h3>Spare parts nobody can find.</h3>
              <p>Thousands of SKUs across oven, mixer and conveyor models lead to inventory inefficiencies. The part exists; identifying it from a worn photograph and a twelve-year-old manual is the job nobody wants.</p>
            </div>
            <div class="dia" aria-hidden="true">
              <div class="skus">
                <div><span></span><span class="q"></span><span></span><span></span><span class="x"></span></div>
                <div><span class="x"></span><span></span><span></span><span class="q"></span><span></span></div>
                <div><span></span><span></span><span class="x"></span><span></span><span></span></div>
                <div><span class="q"></span><span class="x"></span><span></span><span></span><span class="x"></span></div>
              </div>
            </div>
          </article>

          <article class="cost">
            <div>
              <h3>Aftermarket revenue you never see.</h3>
              <p>Fragmented service and limited parts visibility mean missed revenue. Every element, belt and seal ordered from someone else was one you were closest to filling.</p>
            </div>
            <div class="dia" aria-hidden="true">
              <div class="bars">
                <div class="hbar"><span class="n">Ordered from you</span><span class="v">34%</span><span class="t"><i style="--w:34%"></i></span></div>
                <div class="hbar"><span class="n">Ordered elsewhere</span><span class="v">66%</span><span class="t"><i style="--w:66%"></i></span></div>
              </div>
            </div>
          </article>

        </div>
      </div>
    </div>
  </section>

  <!-- ============ B7 · CONSOLES ============ -->
  <section class="band" id="consoles">
    <div class="wrap">
      <div class="shead rv">
        <span class="eyb">On the screen</span>
        <h2>Explore the service experience behind every machine</h2>
        <p class="lede">From live production data to wear alerts and self-service parts identification, every screen is designed to keep bakery lines running.</p>
      </div>

      <div class="conswrap">
      <div class="consstick">
      <div class="shell rv">
        <div class="picks" role="tablist" aria-label="iSERV consoles">
          <button class="pick" role="tab" id="tab-oee" aria-controls="p-oee" aria-selected="true" data-pane="oee" type="button">Machine telemetry</button>
          <button class="pick" role="tab" id="tab-parts" aria-controls="p-parts" aria-selected="false" data-pane="parts" type="button">Spare-parts commerce</button>
          <button class="pick" role="tab" id="tab-avail" aria-controls="p-avail" aria-selected="false" data-pane="avail" type="button">Availability</button>
        </div>

        <div class="shell-in">
        <div class="blurbs">
          <div class="blurb" data-pane="oee">
            <h3>What the line is doing, right now</h3>
            <p>The screen your service desk keeps open: throughput, availability and thermal health for every bakery machine you have shipped, each one benchmarked against the rest of its model family.</p>
            <p class="src"><i aria-hidden="true"></i>Streams from the machine&rsquo;s own sensors</p>
          </div>
          <div class="blurb" data-pane="parts">
            <h3>A photo instead of a part number</h3>
            <p>Your customer photographs the assembly at the machine. iSERV matches the part, checks the distributor holding it and places the order &mdash; in your system, not a competitor&rsquo;s.</p>
            <p class="src"><i aria-hidden="true"></i>Every assembly mapped to the catalogue</p>
          </div>
          <div class="blurb" data-pane="avail">
            <h3>Why the machine actually stopped</h3>
            <p>Downtime split by the reason recorded at the machine, so tray change and change over stop arriving as one number nobody can act on.</p>
            <p class="src"><i aria-hidden="true"></i>Reasons captured at the machine</p>
          </div>
        </div>

        <div class="bezel">
          <div class="cscreen">
          <div class="cnav">
            <div class="bd"><i aria-hidden="true"></i>iSERV</div>
            <p>Overview</p>
            <p data-nav="oee">Machines</p>
            <p data-nav="parts">Parts</p>
            <p data-nav="avail">Downtime</p>
            <p>Reports</p>
          </div>
          <div class="cpanes">

            <div class="pane on" id="p-oee" role="tabpanel" aria-labelledby="tab-oee" data-pane="oee">
              <div class="cbar"><i class="dot"></i><h3>Machine telemetry</h3><span class="tag">Fleet &middot; 34 machines</span><i class="sp"></i><span class="tag">Updated 40 s ago</span></div>
              <div class="cbody">
                <div class="kpis">
                  <div class="kpi"><div class="v">38 trays/min</div><p class="l">Throughput, Oven 3</p><p class="d up">+2.1% vs plan</p></div>
                  <div class="kpi"><div class="v">87%</div><p class="l">OEE, shift to date</p><p class="d up">+3 pts vs plan</p></div>
                  <div class="kpi"><div class="v">Good</div><p class="l">Machine health</p><p class="d up">no faults open</p></div>
                </div>
                <div class="csplit">
                  <div class="panel">
                    <div class="ph"><h4>OEE by machine, current shift</h4><span>installed base, top four</span></div>
                    <div class="hbar"><span class="n">OV-40 &middot; Line 3</span><span class="t"><i style="--w:87%"></i></span><span class="v">87%</span></div>
                    <div class="hbar"><span class="n">OV-40 &middot; Line 1</span><span class="t"><i style="--w:84%"></i></span><span class="v">84%</span></div>
                    <div class="hbar"><span class="n">MX-22 &middot; Line 6</span><span class="t"><i style="--w:79%"></i></span><span class="v">79%</span></div>
                    <div class="hbar hot"><span class="n">MX-22 &middot; Line 5</span><span class="t"><i style="--w:61%"></i></span><span class="v">61%</span></div>
                    <div class="prov"><i class="dot"></i><span>Benchmarked across <b>34 machines</b> in the same model family &middot; shift A</span></div>
                  </div>
                  <div class="panel">
                    <div class="ph"><h4>Wants your attention</h4><span>2 open</span></div>
                    <div class="alist">
                      <div class="alert"><p class="t">Prover 2 on Line 3 stopped mid-shift</p><p class="m">6 minutes lost &middot; proving-chamber temperature drift &middot; <span class="pill bad">stopped</span></p></div>
                      <div class="alert"><p class="t">Heating element HE-4418 is forecast to fail in 12 days</p><p class="m">Next planned stop is in 8 days &middot; <span class="pill warn">schedule it</span></p></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="pane" id="p-parts" role="tabpanel" aria-labelledby="tab-parts" data-pane="parts">
              <div class="cbar"><i class="dot"></i><h3>Spare-parts commerce</h3><span class="tag">Customer portal</span><i class="sp"></i><span class="tag">Catalogue &middot; OV-40</span></div>
              <div class="cbody">
                <div class="kpis">
                  <div class="kpi"><div class="v">98%</div><p class="l">Image match confidence</p><p class="d up">HE-4418 identified</p></div>
                  <div class="kpi"><div class="v">2 min</div><p class="l">Photo to order placed</p><p class="d up">no email thread</p></div>
                  <div class="kpi"><div class="v">1,284</div><p class="l">Parts in the OV-40 catalogue</p><p class="d up">every assembly mapped</p></div>
                </div>
                <div class="csplit">
                  <div class="panel">
                    <div class="ph"><h4>Identify a part</h4><span>photo, drawing or part number</span></div>
                    <div class="alist">
                      <div class="alert"><p class="t">Photo received from Pune &middot; Line 3</p><p class="m">Oven heating assembly, taken at the machine &middot; <span class="pill ok">received</span></p></div>
                      <div class="alert"><p class="t">Matched to HE-4418, oven heating element</p><p class="m">Assembly 04 &middot; exploded view 12 &middot; <span class="pill ok">98% match</span></p></div>
                    </div>
                    <div class="prov"><i class="dot"></i><span>The customer never opens a manual &middot; the order lands in <b>your</b> system, not a competitor&rsquo;s</span></div>
                  </div>
                  <div class="panel">
                    <div class="ph"><h4>Most ordered, OV-40</h4><span>last 12 months</span></div>
                    <div class="hbar"><span class="n">HE-4418 Heating element</span><span class="t"><i style="--w:100%"></i></span><span class="v">148</span></div>
                    <div class="hbar"><span class="n">BT-2207 Conveyor belt</span><span class="t"><i style="--w:64%"></i></span><span class="v">95</span></div>
                    <div class="hbar"><span class="n">BL-0913 Mixer blade</span><span class="t"><i style="--w:41%"></i></span><span class="v">61</span></div>
                  </div>
                </div>
              </div>
            </div>

            <div class="pane" id="p-avail" role="tabpanel" aria-labelledby="tab-avail" data-pane="avail">
              <div class="cbar"><i class="dot"></i><h3>Oven line &middot; OV-40 L02 - availability</h3><span class="tag">Rolling period</span><i class="sp"></i><span class="tag">Uptime &amp; downtime</span></div>
              <div class="cbody">
                <div class="kpis">
                  <div class="kpi"><div class="v">11d 19:58</div><p class="l">Loaded time</p><p class="d mut">of 12d 09:10 available</p></div>
                  <div class="kpi"><div class="v">02:41:40</div><p class="l">Mean time between failures</p><p class="d mut">MTBF</p></div>
                  <div class="kpi"><div class="v">21:04:07</div><p class="l">Process downtime</p><p class="d dn">across the period</p></div>
                </div>
                <div class="csplit">
                  <div class="panel">
                    <div class="ph"><h4>Why the machine stopped</h4><span>share of recorded downtime</span></div>
                    <div class="dnt">
                      <span class="donut" style="--c1:#0083C8;--c2:#39A8DE;--c3:#6DC2EA;--c4:#9AD4F2;--c5:#BFE5F8;--c6:#D7ECF6;--c7:#8FAFC4" role="img" aria-label="Downtime by reason: tray change 36%, cleaning cycle 27%, change over 14%, belt jam 11%, element fault 7%, grease top-up 4%, plant not open 2%."></span>
                      <ul class="legend">
                        <li style="--c:#0083C8"><i></i>Tray change <b>36%</b></li>
                        <li style="--c:#39A8DE"><i></i>Cleaning cycle <b>27%</b></li>
                        <li style="--c:#6DC2EA"><i></i>Change over <b>14%</b></li>
                        <li style="--c:#9AD4F2"><i></i>Belt jam <b>11%</b></li>
                      </ul>
                    </div>
                    <div class="prov"><i class="dot"></i><span>Reasons are captured at the machine, so <b>tray change</b> and <b>change over</b> stop being filed as one number</span></div>
                  </div>
                  <div class="panel">
                  <div class="ph"><h4>The day, hour by hour</h4><span>uptime against downtime</span></div>
                  <div class="strip" role="img" aria-label="Day timeline: the line ran from 6am until 3pm, stopped between 3pm and 6pm, ran again, stopped briefly around 9pm, then ran through to 1am.">
                    <i style="--f:9"></i><i class="dn" style="--f:3"></i><i style="--f:3"></i><i class="dn" style="--f:1"></i><i style="--f:4"></i>
                  </div>
                  <div class="strip-x"><span>06 am</span><span>12 pm</span><span>06 pm</span><span>01 am</span></div>
                  <div class="prov"><i class="dot"></i><span>Three of the four stops above were recorded against a reason a service engineer can act on</span></div>
                  </div>
                </div>
              </div>
            </div>

          </div>
          </div>
        </div>
        </div>
      </div>
      </div>
      </div>
    </div>
  </section>

  <!-- ============ BUSINESS VALUE ============ -->
  <section class="band alt" id="value">
    <div class="wrap">
      <div class="shead rv">
        <span class="eyb">Business value</span>
        <h2>What this means for your bakery operations</h2>
        <p class="lede">Real-time visibility, automated parts ordering and predictive maintenance work together to protect production - not as separate tools, but as one connected outcome.</p>
      </div>
      <div class="grid vals stg">
        <article class="val">
          <span class="ic ic-fog" aria-hidden="true">
            <svg class="scene" viewBox="0 0 100 100">
              <g class="smoke">
                <circle class="pf" cx="44.5" cy="26" r="5"/>
                <circle class="pf" cx="44.5" cy="26" r="5"/>
                <circle class="pf" cx="44.5" cy="26" r="5"/>
              </g>
              <g class="fac">
                <rect x="41" y="26" width="7" height="32" rx="1.5"/>
                <rect x="15" y="50" width="36" height="32" rx="2"/>
                <rect class="side" x="53" y="60" width="22" height="22" rx="2"/>
                <rect x="11" y="82" width="66" height="5" rx="2.5"/>
              </g>
            </svg>
          </span>
          <h3>Optimized production margins</h3>
          <p>Safeguarding uptime preserves the operational efficiency and tight margins that every commercial bakery depends on.</p>
        </article>
        <article class="val">
          <span class="ic ic-gears" aria-hidden="true">
            <svg class="scene" viewBox="0 0 100 100">
              <g transform="translate(38,56)"><g class="spin"><circle r="14.5"/><rect class="t" x="-3.4" y="-21" width="6.8" height="7.6" rx="1"/><rect class="t" x="-3.4" y="-21" width="6.8" height="7.6" rx="1" transform="rotate(45)"/><rect class="t" x="-3.4" y="-21" width="6.8" height="7.6" rx="1" transform="rotate(90)"/><rect class="t" x="-3.4" y="-21" width="6.8" height="7.6" rx="1" transform="rotate(135)"/><rect class="t" x="-3.4" y="-21" width="6.8" height="7.6" rx="1" transform="rotate(180)"/><rect class="t" x="-3.4" y="-21" width="6.8" height="7.6" rx="1" transform="rotate(225)"/><rect class="t" x="-3.4" y="-21" width="6.8" height="7.6" rx="1" transform="rotate(270)"/><rect class="t" x="-3.4" y="-21" width="6.8" height="7.6" rx="1" transform="rotate(315)"/><circle class="hole" r="5.6"/></g></g>
              <g transform="translate(66,38) scale(.6)"><g class="spin-rev"><circle r="14.5"/><rect class="t" x="-3.4" y="-21" width="6.8" height="7.6" rx="1"/><rect class="t" x="-3.4" y="-21" width="6.8" height="7.6" rx="1" transform="rotate(45)"/><rect class="t" x="-3.4" y="-21" width="6.8" height="7.6" rx="1" transform="rotate(90)"/><rect class="t" x="-3.4" y="-21" width="6.8" height="7.6" rx="1" transform="rotate(135)"/><rect class="t" x="-3.4" y="-21" width="6.8" height="7.6" rx="1" transform="rotate(180)"/><rect class="t" x="-3.4" y="-21" width="6.8" height="7.6" rx="1" transform="rotate(225)"/><rect class="t" x="-3.4" y="-21" width="6.8" height="7.6" rx="1" transform="rotate(270)"/><rect class="t" x="-3.4" y="-21" width="6.8" height="7.6" rx="1" transform="rotate(315)"/><circle class="hole" r="5.6"/></g></g>
            </svg>
          </span>
          <h3>Faster parts, faster fixes</h3>
          <p>Automated service requests and digital parts ordering accelerate replacement delivery and repair cycles.</p>
        </article>
        <article class="val">
          <span class="ic ic-belt" aria-hidden="true">
            <svg class="scene" viewBox="0 0 100 100">
              <g class="pkgs">
                <rect class="box" x="0" y="52" width="14" height="12" rx="1.5"/>
                <rect class="box" x="0" y="52" width="14" height="12" rx="1.5"/>
                <rect class="box" x="0" y="52" width="14" height="12" rx="1.5"/>
              </g>
              <g class="belt">
                <circle class="roller" cx="22" cy="72" r="9"/>
                <circle class="roller" cx="78" cy="72" r="9"/>
                <rect class="deck" x="22" y="64" width="56" height="4"/>
                <rect class="deck" x="22" y="76" width="56" height="4"/>
                <circle class="axle" cx="22" cy="72" r="3"/>
                <circle class="axle" cx="78" cy="72" r="3"/>
              </g>
              <g class="alert">
                <path class="tri" d="M50 12 L63 36 H37 Z"/>
                <rect class="excl" x="48.5" y="21" width="3" height="8" rx="1.5"/>
                <circle class="excl" cx="50" cy="33" r="1.8"/>
              </g>
            </svg>
          </span>
          <h3>Fewer unplanned stops</h3>
          <p>Predictive alerts on ovens, mixers and conveyors catch issues before they interrupt a batch.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- ============ B12 · CLOSING CTA ============ -->
  <section class="band cta" id="start">
    <div class="cta-in">
      <div class="cta-copy">
        <div class="shead rv">
          <span class="eyb">Get started</span>
          <h2>Bring one line and the parts they reorder most. <em>You will see it running in a fortnight.</em></h2>
          <p class="lede">Pick an oven or line already running at a customer bakery. We connect it, load its parts catalogue, and show you these consoles with your own machine in them.</p>
        </div>
        <ul class="ex rv">
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#pk-chk"/></svg>One machine at one customer bakery, read-only from its controller</li>
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#pk-chk"/></svg>The parts list for that model, however you keep it today</li>
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#pk-chk"/></svg>No gateway to buy and no plant IT project to open</li>
        </ul>
        <div class="btns rv">
          <button type="button" class="btn pri" data-schedule-demo>Schedule a demo call <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#pk-arr"/></svg></button>
          <a class="btn gho" href="mailto:sales@ithena.ai">Talk to the team</a>
        </div>
      </div>
      <div class="cta-med">
        <img src="https://dev-website.ithena.app/wp-content/uploads/2026/08/food-bakery-2.webp" alt="" width="949" height="475" loading="lazy" decoding="async">
        <button type="button" class="cta-play" data-cta-play aria-label="Play the video">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4.5v15l13-7.5z"/></svg>
        </button>
      </div>
    </div>
  </section>

  <!-- ============ CTA video modal ============ -->
  <div class="pk-vid" id="pkVid" hidden>
    <div class="pk-vid-panel" role="dialog" aria-modal="true" aria-label="Watch the video">
      <button type="button" class="pk-vid-close" data-cta-close aria-label="Close video">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
      <video controls playsinline preload="none" poster="https://dev-website.ithena.app/wp-content/uploads/2026/08/food-bakery-2.webp"></video>
    </div>
  </div>

  <!-- ============ Schedule-demo popup ============
       FORM SLOT: the Formidable form is not hardcoded. Give the Elementor Shortcode
       widget rendering [formidable id="..."] the CSS ID  schedule-demo-form  and the
       script relocates that live widget into the slot - nothing is recreated, so
       Formidable's own scripts, nonces and AJAX keep working. -->
  <div class="pk-schd" id="pkSchd" hidden>
    <div class="pk-schd-panel" role="dialog" aria-modal="true" aria-labelledby="pkSchdTitle" tabindex="-1">
      <button type="button" class="pk-schd-close" data-schedule-popup-close aria-label="Close">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
      <div class="pk-schd-head">
        <p class="eyb">Book a discovery call</p>
        <h3 id="pkSchdTitle">Schedule a demo call</h3>
        <p>Tell us a little about your machines and our team will follow up to find a time that works.</p>
      </div>
      <div class="pk-schd-form" id="pkSchdForm">
        <p class="pk-schd-empty">The form did not load. Email <a href="mailto:sales@ithena.ai">sales@ithena.ai</a> and we will book the call for you.</p>
      </div>
    </div>
  </div>

</section>

<script>
(function(){
  "use strict";
  var root=document.getElementById("main-section");
  if(!root||!root.classList.contains("pkg")) return;
  var reduced=window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  var $=function(s){return root.querySelector(s);};
  var $$=function(s){return Array.prototype.slice.call(root.querySelectorAll(s));};
  var pop=document.getElementById("pkSchd");

  /* ---- CTA video: play button opens a centered modal, video plays with audio ---- */
  var vid=document.getElementById("pkVid");
  if(vid&&!window.pkVidInit){
    window.pkVidInit=1;
    /* out of #main-section so a transformed Elementor ancestor cannot break position:fixed */
    document.body.appendChild(vid);
    var vidEl=vid.querySelector("video"),
        vidSrc="https://dev-website.ithena.app/wp-content/uploads/2026/09/Food%20beverage%20and%20bakery.mp4",
        vidLast=null;
    function vidKey(e){ if(e.key==="Escape") closeVid(); }
    function openVid(e){
      if(e) e.preventDefault();
      vidLast=document.activeElement;
      if(!vidEl.getAttribute("src")) vidEl.setAttribute("src",vidSrc);
      vid.hidden=false;
      document.body.style.overflow="hidden";
      document.addEventListener("keydown",vidKey);
      void vid.offsetWidth;               /* reflow, not rAF (throttled in bg tabs) */
      vid.classList.add("is-open");
      var p=vidEl.play(); if(p&&p.catch) p.catch(function(){});
      var c=vid.querySelector("[data-cta-close]"); if(c) c.focus();
    }
    function closeVid(){
      vid.classList.remove("is-open");
      document.body.style.overflow="";
      document.removeEventListener("keydown",vidKey);
      vidEl.pause();
      setTimeout(function(){vid.hidden=true;},250);
      if(vidLast&&vidLast.focus) vidLast.focus();
    }
    document.addEventListener("click",function(e){
      if(!e.target.closest) return;
      if(e.target.closest("[data-cta-play]")){ openVid(e); return; }
      if(e.target===vid||e.target.closest("[data-cta-close]")) closeVid();
    });
  }

  /* ---- theme: follow the site header when it drives <html class="dark"> ---- */
  function applyTheme(t){
    if(root.getAttribute("data-theme")===t) return;
    if(!reduced){root.classList.add("theming");setTimeout(function(){root.classList.remove("theming");},420);}
    root.setAttribute("data-theme",t);
    if(pop) pop.setAttribute("data-theme",t);
  }
  if(document.documentElement.classList.contains("dark")) applyTheme("dark");
  new MutationObserver(function(){
    applyTheme(document.documentElement.classList.contains("dark")?"dark":"light");
  }).observe(document.documentElement,{attributes:true,attributeFilter:["class"]});

  /* ---- reveal on scroll ---- */
  var targets=$$(".rv,.stg");
  if(!("IntersectionObserver" in window)||reduced){
    targets.forEach(function(el){el.classList.add("in");});
  }else{
    var io=new IntersectionObserver(function(es){
      es.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add("in"); io.unobserve(e.target); } });
    },{rootMargin:"0px 0px -18% 0px",threshold:.2});
    targets.forEach(function(el){io.observe(el);});
  }

  /* ---- proof dials: fill the arc and run the number, once ---- */
  var dials=$$(".dial");
  /* 270 is the r=43 circumference the .arc dasharray is set to */
  function fillArc(d){
    var arc=d.querySelector(".arc"),n=d.querySelector(".num");
    if(arc&&n) arc.style.strokeDashoffset=270-270*(parseFloat(n.getAttribute("data-count"))/100);
  }
  function runDial(d){
    fillArc(d);
    var el=d.querySelector(".num"),end=parseFloat(el.getAttribute("data-count")),
        suf=el.getAttribute("data-suffix")||"",t0=null;
    requestAnimationFrame(function frame(t){
      if(!t0)t0=t;
      var k=Math.min(1,(t-t0)/1900);
      el.textContent=Math.round(end*(1-Math.pow(1-k,3)))+suf;
      if(k<1)requestAnimationFrame(frame);
    });
  }
  if(dials.length&&"IntersectionObserver" in window&&!reduced){
    var fo=new IntersectionObserver(function(es){
      es.forEach(function(e){ if(e.isIntersecting){ fo.unobserve(e.target); runDial(e.target); } });
    },{threshold:.4});
    dials.forEach(function(d){fo.observe(d);});
  }else{
    /* no observer, or motion is off: the arcs still have to be drawn */
    dials.forEach(fillArc);
  }

  /* ---- in-page nav: mark the section you are reading ---- */
  var snLinks=$$(".sn-links a");
  if(snLinks.length&&"IntersectionObserver" in window){
    var byId={},secs=[],seen={};
    snLinks.forEach(function(a){
      var sec=root.querySelector(a.getAttribute("href"));
      if(sec){byId[sec.id]=a;secs.push(sec);}
    });
    var so=new IntersectionObserver(function(es){
      es.forEach(function(e){seen[e.target.id]=e.isIntersecting;});
      var cur=null;
      secs.forEach(function(sec){if(seen[sec.id]&&!cur)cur=sec.id;});
      snLinks.forEach(function(a){a.removeAttribute("aria-current");});
      if(cur)byId[cur].setAttribute("aria-current","true");
    },{rootMargin:"-80px 0px -55% 0px"});
    secs.forEach(function(sec){so.observe(sec);});
  }

  /* ---- capabilities: one open at a time, the panel follows the open one ---- */
  var capqs=$$(".capq"),capArts=$$(".cap-med .art"),capDots=$$(".capdots button"),
      capOrder=capDots.map(function(d){return d.dataset.cap;}),capTimer=null,capHeld=false;
  function capShow(k){
    capqs.forEach(function(q){
      var h=q.querySelector(".qh"),on=h.dataset.cap===k;
      q.classList.toggle("open",on); h.setAttribute("aria-expanded",on?"true":"false");
    });
    capArts.forEach(function(a){
      var on=a.dataset.cap===k;
      a.classList.toggle("on",on); a.setAttribute("aria-hidden",on?"false":"true");
    });
    capDots.forEach(function(d){d.setAttribute("aria-current",d.dataset.cap===k?"true":"false");});
  }
  if(capOrder.length){
    capArts.forEach(function(a){a.setAttribute("aria-hidden",a.classList.contains("on")?"false":"true");});
    $$(".capq .qh").concat(capDots).forEach(function(b){
      b.addEventListener("click",function(){
        /* once someone picks for themselves, stop picking for them */
        capHeld=true; clearInterval(capTimer); capTimer=null;
        capShow(b.dataset.cap);
      });
    });
    /* advance on its own, but only while the section is actually on screen */
    if(!reduced&&"IntersectionObserver" in window){
      new IntersectionObserver(function(es){
        es.forEach(function(e){
          if(e.isIntersecting&&!capTimer&&!capHeld){
            capTimer=setInterval(function(){
              var cur=root.querySelector('.capdots [aria-current="true"]');
              capShow(capOrder[(capOrder.indexOf(cur.dataset.cap)+1)%capOrder.length]);
            },4200);
          }else if(!e.isIntersecting){clearInterval(capTimer);capTimer=null;}
        });
      },{threshold:.3}).observe($(".caps"));
    }
  }

  /* ---- challenge: lift one cost article at a time, 3s each, while on screen ---- */
  var costs=$$(".chal .cost"),costTimer=null,costI=0;
  if(costs.length&&!reduced&&"IntersectionObserver" in window){
    var costStep=function(){
      costs.forEach(function(c,j){c.classList.toggle("active",j===costI);});
      costI=(costI+1)%costs.length;
    };
    new IntersectionObserver(function(es){
      es.forEach(function(e){
        if(e.isIntersecting&&!costTimer){costI=0;costStep();costTimer=setInterval(costStep,3000);}
        else if(!e.isIntersecting){clearInterval(costTimer);costTimer=null;costs.forEach(function(c){c.classList.remove("active");});}
      });
    },{threshold:.3}).observe($(".chal"));
  }

  /* ---- console tabs ---- */
  var picks=$$(".pick"),lmq=window.matchMedia("(max-width:1024px)"),cw=$(".conswrap");
  /* the band is divided into one slot per console plus a .6 tail, so the last
     console is still pinned for a moment after it arrives */
  var cslots=picks.length+.6;
  /* where in the pinned band the console at index i sits */
  function conspos(i){return cw.getBoundingClientRect().top+window.scrollY+(cw.offsetHeight-window.innerHeight)*(i+.5)/cslots;}
  function show(name){
    picks.forEach(function(b){ b.setAttribute("aria-selected", b.dataset.pane===name?"true":"false"); });
    $$(".pane,.blurb").forEach(function(p){
      var on=p.dataset.pane===name;
      p.classList.toggle("on",on);
    });
  }
  picks.forEach(function(b,i){
    b.addEventListener("click",function(){show(b.dataset.pane);if(cw&&!lmq.matches&&!reduced)window.scrollTo({top:conspos(i)});});
    b.addEventListener("keydown",function(e){
      var d=e.key==="ArrowRight"?1:e.key==="ArrowLeft"?-1:0;
      if(!d) return;
      e.preventDefault();
      var n=picks[(i+d+picks.length)%picks.length];
      n.focus(); show(n.dataset.pane);
    });
  });

  /* ---- consoles: pin the panel, one console per screen of scroll ---- */
  if(cw&&picks.length&&!reduced){
    var ctick=function(){
      if(lmq.matches)return;
      var cspan=cw.offsetHeight-window.innerHeight;
      var ck=cspan>0?Math.min(1,Math.max(0,-cw.getBoundingClientRect().top/cspan)):0;
      var ci=Math.min(picks.length-1,Math.floor(ck*cslots));
      if(picks[ci].getAttribute("aria-selected")!=="true")show(picks[ci].dataset.pane);
    };
    window.addEventListener("scroll",ctick,{passive:true});
    window.addEventListener("resize",ctick);
    ctick();
  }

  /* ---- schedule popup: trigger + Formidable form adoption ---- */
  if(pop&&!window.pkSchdInit){
    window.pkSchdInit=1;
    /* out of #main-section so a transformed Elementor ancestor cannot break position:fixed */
    document.body.appendChild(pop);
    pop.setAttribute("data-theme",root.getAttribute("data-theme"));
    var slot=document.getElementById("pkSchdForm"),moved=false,lastFocus=null;

    function adopt(){
      if(moved||!slot) return;
      var src=document.querySelector("#schedule-demo-form, .schedule-demo-form");
      if(!src){
        var w=document.querySelectorAll(".elementor-widget-shortcode");
        for(var i=0;i<w.length;i++){ if(w[i].querySelector(".frm_forms, form")){ src=w[i]; break; } }
      }
      if(!src) src=document.querySelector(".frm_forms");
      if(!src||pop.contains(src)) return;
      slot.innerHTML=""; slot.appendChild(src); src.style.display="block"; moved=true;
    }
    adopt();
    window.addEventListener("load",adopt);

    function onKey(e){ if(e.key==="Escape") closePop(); }
    function openPop(e){
      if(e) e.preventDefault();
      adopt();
      lastFocus=document.activeElement;
      pop.hidden=false;
      document.body.style.overflow="hidden";
      document.addEventListener("keydown",onKey);
      /* forced reflow, not rAF: rAF is throttled in a background tab, which would
         leave the panel invisible while body scroll is already locked */
      void pop.offsetWidth;
      pop.classList.add("is-open");
      var f=pop.querySelector(".pk-schd-form input:not([type=hidden]):not([type=submit]):not([type=button]):not([disabled]), .pk-schd-form textarea:not([disabled]), .pk-schd-form select:not([disabled])")||pop.querySelector("[data-schedule-popup-close]");
      if(f) f.focus();
    }
    function closePop(){
      pop.classList.remove("is-open");
      document.body.style.overflow="";
      document.removeEventListener("keydown",onKey);
      setTimeout(function(){pop.hidden=true;},250);
      if(lastFocus&&lastFocus.focus) lastFocus.focus();
    }
    /* delegated: triggers Elementor renders later still work, one listener covers open + close */
    document.addEventListener("click",function(e){
      if(!e.target.closest) return;
      if(e.target.closest("[data-schedule-demo]")){ openPop(e); return; }
      if(e.target===pop||e.target.closest("[data-schedule-popup-close]")) closePop();
    });
  }
})();
</script>