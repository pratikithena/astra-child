  <article>

  <header class="aiml-sec aiml-sec--hero">
    <div class="hero-bg" aria-hidden="true">
      <img src="https://ithena.ai/wp-content/uploads/2024/02/big-data.jpg" alt="" width="1920" height="1080" fetchpriority="high" decoding="async">
    </div>
    <div class="wrap hero-in">
      <div>
        <p class="kick">Data Management</p>
        <h1 class="h-title">Big Data <em>&amp; Analytics</em></h1>
        <p class="h-deck">Harness the power of ITHENA&rsquo;s ONE Data Platform to drive business outcomes &ndash; from ingestion and modeling through to KPIs, analytics and workflows.</p>
        <ul class="h-tags">
          <li>ONE Data Platform</li>
          <li>Data management</li>
          <li>Enterprise BI</li>
          <li>Data visualization</li>
          <li>Advisory</li>
        </ul>
        <div class="btns">
          <a class="btn btn-o" href="#aiml-offerings" style="border-color:rgba(255,255,255,.28)!important;color:#fff!important">Explore offerings</a>
        </div>
      </div>
    </div>
  </header>

  <nav class="subnav" id="aiml-nav" aria-label="On this page">
    <div class="wrap">
      <div class="subnav-card">
        <a href="#bda-intro">Overview</a>
        <a href="#bda-platform">Platform</a>
        <a href="#aiml-offerings">Offerings</a>
        <a href="#aiml-approach">Approach</a>
        <a href="#aiml-stories">Success Stories</a>
        <a href="#aiml-partners">Partnerships</a>
      </div>
    </div>
  </nav>

  <section class="aiml-sec" id="bda-intro">
    <div class="wrap">
      <div class="two">
        <div class="rev">
          <p class="kick">Big Data &amp; Analytics</p>
          <h2>Harness your data to identify <em>new opportunities</em></h2>
          <div class="railtext">
            <p class="lead">ITHENA&rsquo;s Big data &amp; analytics capabilities assist organizations in harnessing their data and using it to identify new opportunities.</p>
            <p class="body">That, in turn, leads to intelligent business moves, more efficient operations, much higher profits, and delighted customers.</p>
          </div>
        </div>
        <div class="fig rev">
          <img src="https://ithena.ai/wp-content/uploads/2023/06/big-data-1.png" alt="Data blocks assembling into a single unified data cube" width="500" height="308" loading="lazy" decoding="async">
        </div>
      </div>
      <p class="kf-t rev">Key features of the integrated ONE Data Platform</p>
      <ul class="kf rev">
        <li><span class="badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#a-bolt"/></svg></span><h3>Massive data ingestion at incredible speeds</h3></li>
        <li><span class="badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#a-net"/></svg></span><h3>Complex modeling &amp; multi-source integration</h3></li>
        <li><span class="badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#a-user"/></svg></span><h3>Best in class end user self service</h3></li>
        <li><span class="badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#a-shield"/></svg></span><h3>Enhanced data security and audit</h3></li>
      </ul>
    </div>
  </section>

  <section class="aiml-sec deep" id="bda-platform">
    <div class="wrap">
      <div class="rev">
        <p class="kick">ITHENA&rsquo;s ONE Data Platform</p>
        <h2>ONE Data Platform <em>Framework</em></h2>
        <p class="lead">One platform that carries your data from the source connection all the way to insight in front of end users.</p>
        <ol class="flow" aria-label="Platform layers">
          <li>Ingestion</li><li>Modeling</li><li>Semantic layer</li><li>KPIs</li><li>Analytics</li><li>Workflows</li>
        </ol>
      </div>
      <ol class="cards rev">
        <li class="card"><span class="cnum" aria-hidden="true">01</span><span class="badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#a-plug"/></svg></span><div class="pop-body"><h3>Data Source Connectivity</h3><p>Provides a single interface for managing and configuring your data sources, while separating credential management from data usage.</p></div></li>
        <li class="card"><span class="cnum" aria-hidden="true">02</span><span class="badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#a-ingest"/></svg></span><div class="pop-body"><h3>Data Ingestion</h3><p>Access to several sources of data for ingestion, live stream, integrate to be available for organization, access, and analysis. Single UI to connect, ingest and act.</p></div></li>
        <li class="card"><span class="cnum" aria-hidden="true">03</span><span class="badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#a-layers"/></svg></span><div class="pop-body"><h3>Data Enrichment</h3><p>Builds a data lake that consists of metadata, upsert capabilities, and multiple versions of reading consistency.</p></div></li>
        <li class="card"><span class="cnum" aria-hidden="true">04</span><span class="badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#a-net"/></svg></span><div class="pop-body"><h3>Semantic Layer</h3><p>Framework for discovering, analyzing, and accessing complex data that reduces complexity while making it easier for end-users to discover, learn, explore, access, and analyze data.</p></div></li>
        <li class="card"><span class="cnum" aria-hidden="true">05</span><span class="badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#a-chart"/></svg></span><div class="pop-body"><h3>End User Visualization</h3><p>Consistently visualizing the data by displaying insights on the status of metrics and key performance indicators (KPIs) for an enterprise.</p></div></li>
        <li class="card"><span class="cnum" aria-hidden="true">06</span><span class="badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#a-spark"/></svg></span><div class="pop-body"><h3>Realize True Artificial Intelligence</h3><p>Machine learning algorithms aren&rsquo;t enough in the hands of data science teams alone &ndash; they are best at providing outcomes in an easy and demonstrable fashion to end users.</p></div></li>
      </ol>
    </div>
  </section>

  <section class="aiml-sec" id="aiml-offerings">
    <div class="wrap">
      <div class="rev">
        <p class="kick">Offerings</p>
        <h2>The transformational power of <em>data-embedded intelligence</em></h2>
        <p class="lead">In today&rsquo;s data-centered world, it&rsquo;s easier to acquire vast amounts of data than it is to manage, organize and extract valuable insights from it. Connect with us to discuss how you can best use the transformational power of data-embedded intelligence.</p>
      </div>
      <div class="tabs rev">
        <div class="tablist" role="tablist" aria-label="Big Data &amp; Analytics offerings" id="aimlTabs">
          <button class="tab" type="button" role="tab" id="t-adv" aria-controls="p-adv" aria-selected="true"><span class="tab-in"><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><use href="#a-compass"/></svg></i>Advisory &amp; Consultancy</span></button>
          <button class="tab" type="button" role="tab" id="t-dm" aria-controls="p-dm" aria-selected="false" tabindex="-1"><span class="tab-in"><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><use href="#a-db"/></svg></i>Data Management</span></button>
          <button class="tab" type="button" role="tab" id="t-bi" aria-controls="p-bi" aria-selected="false" tabindex="-1"><span class="tab-in"><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><use href="#a-bars"/></svg></i>Enterprise BI</span></button>
          <button class="tab" type="button" role="tab" id="t-dv" aria-controls="p-dv" aria-selected="false" tabindex="-1"><span class="tab-in"><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><use href="#a-pie"/></svg></i>Data Visualization</span></button>
        </div>
        <div class="panels">
          <div class="panel" role="tabpanel" id="p-adv" style="--pbg:url(https://ithena.ai/wp-content/uploads/2023/07/Group-442-1.webp)" aria-labelledby="t-adv" tabindex="0">
            <span class="num" aria-hidden="true">01</span>
            <h3>Advisory &amp; Consultancy Services</h3>
            <p>ITHENA engages with leaders to define data-driven business models, digital strategy, and transformation roadmaps. Our team of seasoned consultants has been engaged with global organizations in:</p>
            <ul class="ticks">
              <li>ROI &amp; business case identification &amp; development</li>
              <li>Design &amp; architecture of data strategy &amp; roadmap</li>
              <li>Technology evaluation, prototyping &amp; benchmarking</li>
              <li>Change management and training</li>
            </ul>
          </div>
          <div class="panel" role="tabpanel" id="p-dm" style="--pbg:url(https://ithena.ai/wp-content/uploads/2023/07/Group-443.webp)" aria-labelledby="t-dm" tabindex="0" hidden>
            <span class="num" aria-hidden="true">02</span>
            <h3>Data Management</h3>
            <p>ITHENA implements policies &amp; procedures that put the organization in control of their business data regardless of where it resides. Our offerings in this space cover:</p>
            <ul class="ticks">
              <li>Data engineering &amp; enterprise data integration</li>
              <li>IT &amp; OT data integration</li>
              <li>Master data management implementation</li>
              <li>Setup of enterprise data stores, data warehouses, data lakes</li>
              <li>Information architecture on cloud, hybrid, and on-premise</li>
              <li>Migration and integration with big data platform</li>
            </ul>
          </div>
          <div class="panel" role="tabpanel" id="p-bi" style="--pbg:url(https://ithena.ai/wp-content/uploads/2023/07/Group-444.webp)" aria-labelledby="t-bi" tabindex="0" hidden>
            <span class="num" aria-hidden="true">03</span>
            <h3>Enterprise BI</h3>
            <p>ITHENA&rsquo;s Enterprise BI helps both small and large organizations increase productivity and efficiency. We help our customers set up an enterprise-wide business intelligence platform covering:</p>
            <ul class="ticks">
              <li>Reporting, dashboarding, workflows for business &amp; functions</li>
              <li>Advanced analytics using machine learning, AI, and data science features</li>
              <li>Self-service BI frameworks</li>
              <li>Mobile business intelligence</li>
              <li>Migration of BI platforms</li>
            </ul>
          </div>
          <div class="panel" role="tabpanel" id="p-dv" style="--pbg:url(https://ithena.ai/wp-content/uploads/2023/07/Group-445.webp)" aria-labelledby="t-dv" tabindex="0" hidden>
            <span class="num" aria-hidden="true">04</span>
            <h3>Data Visualization</h3>
            <p>ITHENA&rsquo;s DV helps communicate business insights from data through visual representation &ndash; distilling large datasets into visual graphics for an easy understanding of complex relationships within the data.</p>
            <p>These analytics offerings focus on specific business areas and problems across sales, servicing, logistics, inventory, manufacturing, and quality:</p>
            <ul class="ticks">
              <li>Enterprise real-time IoT analytics</li>
              <li>Social intelligence &amp; analytics</li>
              <li>Real-time vehicle analytics platform</li>
              <li>Departmental analytics</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="aiml-sec tint" id="aiml-approach">
    <div class="wrap">
      <div class="rev">
        <p class="kick">Approach</p>
        <h2>A holistic approach for shaping and implementing <em>big data &amp; analytics</em> programs</h2>
        <p class="lead">Six stages, from the first conversation about your needs through to instances running in production.</p>
      </div>
      <div class="roles rev">
        <article class="role"><div class="pop-body"><span class="rnum" aria-hidden="true">01</span><h3>Ideate</h3><p>Interview, empathize &amp; ideate to clearly define needs</p></div></article>
        <article class="role"><div class="pop-body"><span class="rnum" aria-hidden="true">02</span><h3>Understand</h3><p>Understand the business to achieve maximum impact</p></div></article>
        <article class="role"><div class="pop-body"><span class="rnum" aria-hidden="true">03</span><h3>Acquire</h3><p>Data acquisition, modelling &amp; ingestion</p></div></article>
        <article class="role"><div class="pop-body"><span class="rnum" aria-hidden="true">04</span><h3>Build Pipeline</h3><p>Create repeatable ETL based data pipelines</p></div></article>
        <article class="role"><div class="pop-body"><span class="rnum" aria-hidden="true">05</span><h3>Data Modelling</h3><p>Model data as per business requirements for high impact</p></div></article>
        <article class="role"><div class="pop-body"><span class="rnum" aria-hidden="true">06</span><h3>Deployment</h3><p>Deploy and stage instances into production</p></div></article>
      </div>
    </div>
  </section>

  <section class="aiml-sec aiml-sec--stories deep" id="aiml-stories">
    <div class="wrap">
      <div class="rev">
        <p class="kick">Success Stories</p>
        <h2>Where Big Data &amp; Analytics helped clients <em>deliver value</em></h2>
        <p class="lead">Selected success stories where our Big Data &amp; Analytics have helped our clients create and deliver value.</p>
      </div>
      <div class="st-bar rev">
        <div class="st-dots" id="aimlDots">
          <button class="st-dot" type="button" aria-current="true" aria-label="Go to slide group 1"></button>
          <button class="st-dot" type="button" aria-label="Go to slide group 2"></button>
          <button class="st-dot" type="button" aria-label="Go to slide group 3"></button>
        </div>
        <button class="st-btn st-prev" type="button" id="aimlPrev" aria-label="Previous stories" aria-controls="aimlStories" disabled><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#a-arrow"/></svg></button>
        <button class="st-btn st-next" type="button" id="aimlNext" aria-label="Next stories" aria-controls="aimlStories"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#a-arrow"/></svg></button>
      </div>
      <div class="stories rev" id="aimlStories" tabindex="0" role="group" aria-label="Success stories">
        <article class="story">
          <img src="https://ithena.ai/wp-content/uploads/2023/06/1-2.jpg" alt="Caregiver in protective gear handling a COVID-19 test" width="2116" height="1080" loading="lazy" decoding="async">
          <span class="tagn">Healthcare</span>
          <h3>Improved employee safety with COVID-19 risk analytics for a medical caregiving organization</h3>
          <p>To keep employees safe during the pandemic, we integrated live thermographic video analytics and face recognition. The system enabled non-invasive, real-time health screening of employees entering the workplace &ndash; identifying potential COVID-19 cases and minimizing the risk of transmission.</p>
        </article>
        <article class="story">
          <img src="https://ithena.ai/wp-content/uploads/2023/06/2-2.jpg" alt="Cargo ship at sea carrying loads tracked by fleet telematics" width="2116" height="1080" loading="lazy" decoding="async">
          <span class="tagn">Fleet &amp; logistics</span>
          <h3>Fleet optimization with analytics for a US based fleet service provider</h3>
          <p>IoT analytics on telematics &amp; cargo load data helped in route optimization, improving unplanned downtime of trailers &amp; driver safety.</p>
        </article>
        <article class="story">
          <img src="https://ithena.ai/wp-content/uploads/2023/06/3-1.jpg" alt="Customer paying online with a card for an FMCG e-commerce order" width="2116" height="1080" loading="lazy" decoding="async">
          <span class="tagn">FMCG</span>
          <h3>Data &amp; analytics platform for an FMCG e-commerce company</h3>
          <p>ITHENA&rsquo;s persona-based platform transformed e-commerce transaction analysis through customer profiling, basket analysis, web analytics, and SEO/SCM integration &ndash; identifying distinct customer segments, each with unique behaviors, preferences, and purchasing patterns.</p>
        </article>
        <article class="story">
          <img src="https://ithena.ai/wp-content/uploads/2023/06/4.jpg" alt="Industrial plant equipment monitored with advanced analytics" width="2116" height="1080" loading="lazy" decoding="async">
          <span class="tagn">Manufacturing</span>
          <h3>Reduced machine downtime with advanced analytics for a manufacturing company</h3>
          <p>Advanced analytics on IoT-generated machine data &ndash; including performance metrics and potential failure indicators &ndash; enabled proactive issue identification and resolution, significantly reducing unplanned downtime and enhancing overall productivity.</p>
        </article>
        <article class="story">
          <img src="https://ithena.ai/wp-content/uploads/2023/06/5.jpg" alt="Business team reviewing BI insights for a conglomerate" width="2116" height="1080" loading="lazy" decoding="async">
          <span class="tagn">Conglomerate</span>
          <h3>Data, BI strategy, and implementation for a business conglomerate</h3>
          <p>A data-driven self-analytics system empowered the business team of a large conglomerate with valuable insights and strategic decision-making across customers, sales, inventories, and logistics.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="aiml-sec aiml-sec--partners tint" id="aiml-partners">
    <div class="wrap">
      <div class="rev">
        <p class="kick">Partnerships</p>
        <h2>A <em>robust ecosystem</em> of ISVs behind our solutions and services</h2>
        <p class="lead">We have a robust ecosystem of ISVs to support our solutions and services.</p>
      </div>
      <div class="marquee rev" aria-label="Partner technologies">
        <ul>
          <li><img src="https://ithena.ai/wp-content/uploads/2023/06/Rectangle-821.png" alt="Oracle" width="150" height="46" loading="lazy" decoding="async"></li>
          <li><img src="https://ithena.ai/wp-content/uploads/2023/06/Rectangle-820.png" alt="IBM" width="150" height="46" loading="lazy" decoding="async"></li>
          <li><img src="https://ithena.ai/wp-content/uploads/2023/06/Rectangle-818.png" alt="Snowflake" width="150" height="46" loading="lazy" decoding="async"></li>
          <li><img src="https://ithena.ai/wp-content/uploads/2023/06/Rectangle-817.png" alt="AWS" width="150" height="46" loading="lazy" decoding="async"></li>
          <li><img src="https://ithena.ai/wp-content/uploads/2023/06/Group-267.png" alt="Microsoft" width="150" height="46" loading="lazy" decoding="async"></li>
          <li><img src="https://ithena.ai/wp-content/uploads/2023/06/Rectangle-816.png" alt="Sisense" width="150" height="46" loading="lazy" decoding="async"></li>
          <li><img src="https://ithena.ai/wp-content/uploads/2023/06/Rectangle-823.png" alt="SAP" width="150" height="46" loading="lazy" decoding="async"></li>
          <li><img src="https://ithena.ai/wp-content/uploads/2023/06/Rectangle-822.png" alt="Tableau" width="150" height="46" loading="lazy" decoding="async"></li>
          <li aria-hidden="true"><img src="https://ithena.ai/wp-content/uploads/2023/06/Rectangle-821.png" alt="" width="150" height="46" loading="lazy" decoding="async"></li>
          <li aria-hidden="true"><img src="https://ithena.ai/wp-content/uploads/2023/06/Rectangle-820.png" alt="" width="150" height="46" loading="lazy" decoding="async"></li>
          <li aria-hidden="true"><img src="https://ithena.ai/wp-content/uploads/2023/06/Rectangle-818.png" alt="" width="150" height="46" loading="lazy" decoding="async"></li>
          <li aria-hidden="true"><img src="https://ithena.ai/wp-content/uploads/2023/06/Rectangle-817.png" alt="" width="150" height="46" loading="lazy" decoding="async"></li>
          <li aria-hidden="true"><img src="https://ithena.ai/wp-content/uploads/2023/06/Group-267.png" alt="" width="150" height="46" loading="lazy" decoding="async"></li>
          <li aria-hidden="true"><img src="https://ithena.ai/wp-content/uploads/2023/06/Rectangle-816.png" alt="" width="150" height="46" loading="lazy" decoding="async"></li>
          <li aria-hidden="true"><img src="https://ithena.ai/wp-content/uploads/2023/06/Rectangle-823.png" alt="" width="150" height="46" loading="lazy" decoding="async"></li>
          <li aria-hidden="true"><img src="https://ithena.ai/wp-content/uploads/2023/06/Rectangle-822.png" alt="" width="150" height="46" loading="lazy" decoding="async"></li>
        </ul>
      </div>
    </div>
  </section>

  </article>

</section>

<script>
  (function(){
    "use strict";
    var root=document.querySelector('section.aiml-page');
    if(!root||root.dataset.bound) return;
    root.dataset.bound='1';

    var themeToggle=document.getElementById('themeToggle');
    var stored=null; try{ stored=localStorage.getItem('fbb-theme'); }catch(e){}
    setTheme(stored||'dark');

    function setTheme(mode){
      root.setAttribute('data-theme',mode);
      if(themeToggle) themeToggle.setAttribute('aria-pressed',mode==='dark'?'true':'false');
      try{ localStorage.setItem('fbb-theme',mode); }catch(e){}
    }
    if(themeToggle){
      themeToggle.addEventListener('click',function(){
        setTheme(root.getAttribute('data-theme')==='dark'?'light':'dark');
      });
    }

    var reduce=window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches;

    // autoplay (default 3s); pauses while pointer or keyboard focus is inside box, off for reduced motion
    function autoplay(box,step,ms){
      if(reduce||!box) return;
      var t, run=function(){ clearInterval(t); t=setInterval(step,ms||3000); }, stop=function(){ clearInterval(t); };
      box.addEventListener('mouseenter',stop); box.addEventListener('mouseleave',run);
      box.addEventListener('focusin',stop); box.addEventListener('focusout',run);
      run();
    }

    var tabs=[].slice.call(root.querySelectorAll('#aimlTabs .tab'));
    function select(i,focus){
      if(i<0) i=tabs.length-1;
      if(i>=tabs.length) i=0;
      tabs.forEach(function(t,j){
        var on=j===i, p=document.getElementById(t.getAttribute('aria-controls'));
        t.setAttribute('aria-selected',on?'true':'false');
        if(on) t.removeAttribute('tabindex'); else t.setAttribute('tabindex','-1');
        if(p) p.hidden=!on;
      });
      var list=tabs[i].parentNode;
      if(list.scrollWidth>list.clientWidth) list.scrollTo({left:tabs[i].offsetLeft-(list.clientWidth-tabs[i].offsetWidth)/2,behavior:reduce?'auto':'smooth'});
      if(focus) tabs[i].focus();
    }
    tabs.forEach(function(t,i){
      t.addEventListener('click',function(){ select(i,false); });
      t.addEventListener('keydown',function(e){
        var k=e.key;
        if(k==='ArrowRight'||k==='ArrowDown') select(i+1,true);
        else if(k==='ArrowLeft'||k==='ArrowUp') select(i-1,true);
        else if(k==='Home') select(0,true);
        else if(k==='End') select(tabs.length-1,true);
        else return;
        e.preventDefault();
      });
    });
    if(tabs.length) autoplay(root.querySelector('.tabs'),function(){
      select(tabs.findIndex(function(t){ return t.getAttribute('aria-selected')==='true'; })+1,false);
    });

    var roles=[].slice.call(root.querySelectorAll('.roles .role')), ri=0;
    function pop(i){ ri=i%roles.length; roles.forEach(function(r,j){ r.classList.toggle('on',j===ri); }); }
    roles.forEach(function(r,i){ r.addEventListener('mouseenter',function(){ pop(i); }); });
    if(roles.length){
      if(!reduce) pop(0);
      autoplay(root.querySelector('.roles'),function(){ pop(ri+1); });
    }

    // key features: one feature lights up every 2s (same rhythm as the platform cards)
    var kfBox=root.querySelector('.kf'), kfs=[].slice.call(root.querySelectorAll('.kf li')), kn=0;
    function glowKf(i){ kn=i%kfs.length; kfs.forEach(function(k,j){ k.classList.toggle('on',j===kn); }); }
    kfs.forEach(function(k,i){ k.addEventListener('mouseenter',function(){ glowKf(i); }); });
    if(kfs.length&&!reduce){ kfBox.classList.add('live'); glowKf(0); autoplay(kfBox,function(){ glowKf(kn+1); },2000); }

    // platform: card n and flow layer n light up together every 2s
    var cards=[].slice.call(root.querySelectorAll('#bda-platform .card')),
        layers=[].slice.call(root.querySelectorAll('#bda-platform .flow li')), ci=0;
    function lift(i){
      ci=i%cards.length;
      cards.forEach(function(c,j){ c.classList.toggle('on',j===ci); });
      layers.forEach(function(l,j){ l.classList.toggle('on',j===ci); });
    }
    cards.forEach(function(c,i){ c.addEventListener('mouseenter',function(){ lift(i); }); });
    if(cards.length&&!reduce){
      root.querySelector('#bda-platform .flow').classList.add('live');
      lift(0);
      autoplay(root.querySelector('#bda-platform .cards'),function(){ lift(ci+1); },2000);
    }

    var rail=root.querySelector('#aimlStories'),
        sPrev=root.querySelector('#aimlPrev'),
        sNext=root.querySelector('#aimlNext'),
        sDots=[].slice.call(root.querySelectorAll('#aimlDots .st-dot'));
    if(rail&&sPrev&&sNext){
      var lastPage=-1;
      var maxPage=function(){ return Math.max(0,Math.round((rail.scrollWidth-rail.clientWidth)/rail.clientWidth)); };
      var curPage=function(){ return rail.clientWidth?Math.round(rail.scrollLeft/rail.clientWidth):0; };
      var go=function(p){ rail.scrollTo({left:p*rail.clientWidth,behavior:reduce?'auto':'smooth'}); };
      var sync=function(){
        var p=curPage(), m=maxPage();
        if(p===lastPage) return;
        lastPage=p;
        sPrev.disabled=p<=0;
        sNext.disabled=p>=m;
        sDots.forEach(function(d,i){
          d.hidden=i>m;
          if(i===p) d.setAttribute('aria-current','true'); else d.removeAttribute('aria-current');
        });
      };
      sPrev.addEventListener('click',function(){ go(curPage()-1); });
      sNext.addEventListener('click',function(){ go(curPage()+1); });
      sDots.forEach(function(d,i){ d.addEventListener('click',function(){ go(i); }); });
      rail.addEventListener('scroll',function(){ sync(); },{passive:true});
      addEventListener('resize',function(){ lastPage=-1; sync(); });
      sync();
      autoplay(rail.parentNode,function(){ go(curPage()>=maxPage()?0:curPage()+1); });
    }

    var revs=[].slice.call(root.querySelectorAll('.rev'));
    revs.forEach(function(el){
      var sibs=[].filter.call(el.parentNode.children,function(c){return c.classList.contains('rev')});
      el.style.transitionDelay=(Math.min(sibs.indexOf(el),4)*0.07)+'s';
    });

    var links=[].slice.call(root.querySelectorAll('#aiml-nav a')),
        secs=links.map(function(a){return document.getElementById(a.getAttribute('href').slice(1))}),
        bar=links.length?links[0].parentNode:null;

    function onScroll(){
      var best=0;
      secs.forEach(function(s,j){ if(s&&s.getBoundingClientRect().top<innerHeight*0.4) best=j; });
      links.forEach(function(a,j){
        if(j!==best){ a.removeAttribute('aria-current'); return; }
        if(a.getAttribute('aria-current')!=='true'&&bar&&bar.scrollWidth>bar.clientWidth){
          bar.scrollTo({left:a.offsetLeft-20,behavior:reduce?'auto':'smooth'});
        }
        a.setAttribute('aria-current','true');
      });
      for(var n=revs.length-1;n>=0;n--){
        if(revs[n].getBoundingClientRect().top>innerHeight*0.9) continue;
        revs[n].classList.add('in'); revs.splice(n,1);
      }
    }
    addEventListener('scroll',onScroll,{passive:true});
    addEventListener('resize',onScroll);
    onScroll();
  })();

</script>
