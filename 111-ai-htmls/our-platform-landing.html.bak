-webkit-backdrop-filter:blur(8px)!important;backdrop-filter:blur(8px)!important;border-radius:999px!important;flex-wrap:wrap!important;justify-content:center!important}section#main-section.platform .jrail li{display:flex!important;align-items:center!important;gap:8px!important;padding:6px 13px!important;border-radius:999px!important;font-size:12px!important;font-weight:600!important;color:var(--j-ink3)!important;transition:background-color .4s var(--ease),color .4s var(--ease)!important;white-space:nowrap!important;cursor:pointer!important}section#main-section.platform .jrail li i{width:6px!important;height:6px!important;border-radius:50%!important;background:currentColor!important;opacity:.5!important}section#main-section.platform .jrail li.on{background:var(--blue-deep)!important;color:#fff!important}section#main-section.platform .jrail li.on i{opacity:1!important;background:#fff!important}section#main-section.platform .jstack{display:none!important}section#main-section.platform .jstack{gap:18px!important;width:100%!important;max-width:var(--maxw)!important;margin-inline:auto!important;padding:0 var(--pad) clamp(44px,5vw,72px)!important}section#main-section.platform .js{border:1px solid var(--j-line)!important;border-radius:var(--r2)!important;overflow:hidden!important;background:var(--j-plate)!important}section#main-section.platform .jsfig .lfig{display:block!important;width:100%!important;height:auto!important}section#main-section.platform .js .t{padding:20px!important;display:grid!important;gap:10px!important}section#main-section.platform .js .t span{font-size:12px!important;font-weight:700!important;letter-spacing:.12em!important;text-transform:uppercase!important;color:var(--j-accent)!important}section#main-section.platform .js .t h3{color:var(--j-ink)!important;font-size:20px!important;margin:0!important;letter-spacing:-.015em!important}section#main-section.platform .js .t p{color:var(--j-ink2)!important;font-size:15px!important;line-height:1.6!important;font-weight:300!important;margin:0!important}section#main-section.platform .js .t p.jd{color:var(--j-ink3)!important;font-size:13.5px!important;padding-top:12px!important;border-top:1px solid var(--j-line)!important}@media (max-width:1100px){section#main-section.platform .jpin,section#main-section.platform .jtravel{display:none!important}section#main-section.platform .jstack{display:grid!important}section#main-section.platform .jpin{display:none!important}section#main-section.platform .jhead{padding:clamp(44px,5vw,72px) var(--pad) clamp(24px,3vw,32px)!important}}@media (prefers-reduced-motion:reduce){section#main-section.platform .jpin,section#main-section.platform .jtravel{display:none!important}section#main-section.platform .jstack{display:grid!important}}@media (prefers-reduced-motion:reduce){section#main-section.platform .jplate .lfig{transition:none!important;transform:none!important}section#main-section.platform .jcopy>div{transition:none!important}}section#main-section.platform [hidden]{display:none!important}
/* ===== a fresh approach: single centred column now the banner is gone ===== */
section#main-section.platform .introwrap{display:block!important}
section#main-section.platform .prose{max-width:760px!important;margin-inline:auto!important;text-align:center!important}
section#main-section.platform .wfig figcaption{text-align:center!important}
/* the CTA below no longer fades into this section, so give Explore its space back */
section#main-section.platform .ph-explore.sec{padding-bottom:clamp(56px,6vw,88px)!important}

/* kicker is 12px bold, so it needs 4.5:1, not the large-text 3:1. --blue gave 4.13/4.19. */
section#main-section.platform[data-theme="dark"] .kicker{color:var(--blue-soft)!important}

/* ===== wfig: the platform path, drawn rather than photographed ===== */
section#main-section.platform .wfig{background:var(--card)!important}
section#main-section.platform .pipewrap{overflow-x:auto!important;overflow-y:hidden!important;background:linear-gradient(168deg,var(--card) 0%,var(--wash) 100%)!important}
section#main-section.platform .pipeinner{position:relative!important;min-width:760px!important}
section#main-section.platform .pipe{display:block!important;width:100%!important;height:auto!important}
section#main-section.platform .pipe .art path,section#main-section.platform .pipe .art rect,section#main-section.platform .pipe .art circle{fill:none!important;stroke:var(--blue)!important;stroke-width:2!important;stroke-linecap:round!important;stroke-linejoin:round!important}
section#main-section.platform .pipe .hair{stroke-width:1.5!important;opacity:.55!important}
section#main-section.platform .pipe .arc path{opacity:.5!important}
section#main-section.platform .pipe .ring{stroke:var(--blue-soft)!important;stroke-width:1.5!important;stroke-dasharray:3 7!important;opacity:.75!important}
section#main-section.platform .pipe .bar rect{fill:color-mix(in srgb,var(--blue) 16%,transparent)!important;stroke-width:1.5!important}
section#main-section.platform .pipe .tick circle,section#main-section.platform .pipe .node circle{fill:var(--card)!important}
section#main-section.platform .pipe .node .hot{fill:var(--blue)!important;stroke:none!important}
section#main-section.platform .pipe .trend{fill:none!important;stroke:var(--green)!important;stroke-width:2.4!important;stroke-linecap:round!important;stroke-linejoin:round!important}
section#main-section.platform .pipe .spine{fill:none!important;stroke:var(--blue)!important;stroke-width:1.5!important;opacity:.28!important}
section#main-section.platform .pipe .chev path{fill:none!important;stroke:var(--blue)!important;stroke-width:2!important;stroke-linecap:round!important;stroke-linejoin:round!important;opacity:.5!important}
section#main-section.platform .pipe .gnd path{fill:none!important;stroke:var(--line)!important;stroke-width:1.5!important}
section#main-section.platform .pipe .lead{fill:none!important;stroke:var(--blue)!important;stroke-width:1.5!important;stroke-dasharray:4 5!important;opacity:.45!important}
section#main-section.platform .pipe .dot{fill:var(--blue)!important;stroke:var(--card)!important;stroke-width:2.5!important}
section#main-section.platform .pipe .dot.ok{fill:var(--green)!important}
section#main-section.platform .pipe .lbl text{fill:var(--ink3)!important;font-family:var(--body)!important;font-size:20px!important;font-weight:700!important;letter-spacing:.16em!important}
@keyframes phflow{to{stroke-dashoffset:-100}}
section#main-section.platform .pipe .flow{fill:none!important;stroke:var(--blue-hi)!important;stroke-width:5!important;stroke-linecap:round!important;stroke-dasharray:4 96!important;animation:phflow 4.2s linear infinite}
@media (prefers-reduced-motion:reduce){section#main-section.platform .pipe .flow{display:none!important}}
section#main-section.platform .ppill{position:absolute!important;left:var(--x)!important;top:var(--y)!important;transform:translate(-50%,-50%)!important;display:inline-flex!important;align-items:center!important;gap:8px!important;white-space:nowrap!important;padding:9px 15px!important;border-radius:999px!important;background:var(--card)!important;border:1px solid var(--line)!important;box-shadow:0 12px 26px -14px rgba(13,27,46,.45)!important;font-size:13px!important;font-weight:500!important;color:var(--ink3)!important}
section#main-section.platform .ppill b{font-family:var(--display)!important;font-weight:700!important;color:var(--blue-deep)!important}
section#main-section.platform .ppill .pd{width:7px!important;height:7px!important;border-radius:50%!important;background:var(--blue)!important;flex:none!important}
section#main-section.platform .ppill .pd.ok{background:var(--green)!important}
section#main-section.platform[data-theme="dark"] .ppill b{color:var(--blue-soft)!important}
section#main-section.platform[data-theme="dark"] .ppill{box-shadow:0 12px 26px -14px rgba(0,0,0,.8)!important}

/* ===== layer plates: drawn in the .wfig grammar, tuned for the dark plate ===== */
section#main-section.platform .lfig{display:block!important;width:100%!important;height:auto!important}
section#main-section.platform .lfig .chip rect,section#main-section.platform .lfig .core rect,section#main-section.platform .lfig .core circle{fill:var(--j-fill)!important;stroke:var(--j-stroke)!important;stroke-width:2!important}
section#main-section.platform .lfig .core path{fill:none!important;stroke:var(--j-stroke)!important;stroke-width:2!important;stroke-linecap:round!important;stroke-linejoin:round!important}
section#main-section.platform .lfig .chip circle{fill:var(--j-stroke)!important;stroke:none!important}
section#main-section.platform .lfig .hair{stroke:var(--j-stroke2)!important;stroke-width:1.6!important;opacity:.6!important;fill:none!important}
section#main-section.platform .lfig .core .hot{fill:var(--j-hot)!important;stroke:none!important}
section#main-section.platform .lfig .ring{fill:none!important;stroke:var(--j-stroke2)!important;stroke-width:1.6!important;stroke-dasharray:3 8!important;opacity:.7!important}
section#main-section.platform .lfig .bar rect{fill:var(--j-fill2)!important;stroke-width:1.6!important}
section#main-section.platform .lfig .trend{fill:none!important;stroke:var(--j-ok)!important;stroke-width:2.6!important;stroke-linecap:round!important;stroke-linejoin:round!important}
section#main-section.platform .lfig .wire{fill:none!important;stroke:var(--j-stroke2)!important;stroke-width:1.6!important;opacity:.4!important}
section#main-section.platform .lfig .spine{fill:none!important;stroke:var(--j-stroke2)!important;stroke-width:1.6!important;opacity:.22!important}
section#main-section.platform .lfig .gnd path{fill:none!important;stroke:var(--j-grid)!important;stroke-width:1.6!important}
section#main-section.platform .lfig text{font-family:var(--body)!important;fill:var(--j-ink)!important;font-size:23px!important;font-weight:500!important}
section#main-section.platform .lfig .cap{fill:var(--j-ink3)!important;font-size:21px!important;font-weight:700!important;letter-spacing:.15em!important}
section#main-section.platform .lfig .fn{text-anchor:middle!important;font-size:20px!important;font-weight:700!important;letter-spacing:.1em!important}
section#main-section.platform .lfig .fn.dim{fill:var(--j-ink3)!important;font-weight:500!important;letter-spacing:.03em!important}
section#main-section.platform .lfig .spill rect{fill:var(--j-pill)!important;stroke:var(--j-pill-line)!important;stroke-width:1.6!important}
section#main-section.platform .lfig .spill text{font-size:22px!important;fill:var(--j-ink3)!important}
section#main-section.platform .lfig .spill .v{fill:var(--j-accent)!important;font-weight:700!important;font-family:var(--display)!important}
section#main-section.platform .lfig .spill .pd{fill:var(--j-stroke)!important;stroke:none!important}
section#main-section.platform .lfig .spill .pd.ok{fill:var(--j-ok)!important}
section#main-section.platform .lfig .flow{fill:none!important;stroke:var(--j-stroke2)!important;stroke-width:6!important;stroke-linecap:round!important;stroke-dasharray:4 96!important;animation:phflow 4.2s linear infinite}
@media (prefers-reduced-motion:reduce){section#main-section.platform .lfig .flow{display:none!important}}
section#main-section.platform .jsfig{overflow-x:auto!important;overflow-y:hidden!important}
@media (max-width:900px){section#main-section.platform .jsfig .lfig{min-width:680px!important}}

/* ===== "The platform": one palette, two themes =====
   The section used to be hardcoded dark. These tokens carry the dark values by
   default and are redefined for light, so the copy AND the SVG layer graphics
   follow the page theme instead of fighting it. */
section#main-section.platform .jwrap{
--j-bg:#0B1726;--j-plate:#0F2236;--j-ink:#FFFFFF;--j-ink2:rgba(215,236,246,.82);--j-ink3:#8FAFC4;
--j-accent:#5FC1F5;--j-stroke:#4FB3E8;--j-stroke2:#7FC8F2;--j-hot:#33A1E0;--j-ok:#4FD1A0;
--j-line:rgba(255,255,255,.13);--j-surf:rgba(255,255,255,.06);--j-grid:rgba(255,255,255,.11);
--j-fill:rgba(0,131,200,.10);--j-fill2:rgba(79,179,232,.28);
--j-pill:rgba(9,22,38,.9);--j-pill-line:rgba(127,200,242,.34);--j-shadow:rgba(0,0,0,.9)}
section#main-section.platform[data-theme="light"] .jwrap{
--j-bg:#EAF5FB;--j-plate:#FFFFFF;--j-ink:#0D1B2E;--j-ink2:#333333;--j-ink3:#4E6273;
--j-accent:#006AA3;--j-stroke:#0083C8;--j-stroke2:#5AA8D4;--j-hot:#0083C8;--j-ok:#1EA672;
--j-line:#E1EAF0;--j-surf:rgba(13,27,46,.05);--j-grid:rgba(13,27,46,.10);
--j-fill:rgba(0,131,200,.07);--j-fill2:rgba(0,131,200,.20);
--j-pill:#FFFFFF;--j-pill-line:rgba(0,131,200,.28);--j-shadow:rgba(13,27,46,.28)}

/* ===== "Get started": symmetric breathing room so the copy sits optically centred ===== */
section#main-section.platform .ph-cta.sec{padding-top:clamp(84px,9vw,132px)!important;padding-bottom:clamp(84px,9vw,132px)!important}
section#main-section.platform .ph-cta>.frame{display:flex!important;flex-direction:column!important;align-items:center!important;justify-content:center!important}

/* ===== stat row: the number is the hero, the label sits under it =====
   No card, no fill, no border. The only structure is a hairline in the brand
   blue between columns, which draws in with the existing .stg cascade. */
section#main-section.platform .figs{display:grid!important;grid-template-columns:repeat(4,minmax(0,1fr))!important;gap:0!important;
  border:0!important;border-radius:0!important;background:none!important;overflow:visible!important;
  box-shadow:none!important;max-width:1120px!important;margin-inline:auto!important;align-items:start!important}
section#main-section.platform .fig{position:relative!important;padding:clamp(8px,1.2vw,16px) clamp(12px,1.8vw,26px)!important;
  text-align:center!important;border:0!important;border-radius:0!important;background:none!important;box-shadow:none!important}
section#main-section.platform .fig:hover{background:none!important}
section#main-section.platform .fig b{display:block!important;font-family:var(--display)!important;
  font-size:clamp(42px,5.2vw,76px)!important;font-weight:700!important;letter-spacing:-.045em!important;
  line-height:.94!important;font-variant-numeric:tabular-nums!important;transform:none!important}
section#main-section.platform .fig:hover b{transform:none!important}
section#main-section.platform .fig span{display:block!important;margin-top:14px!important;font-size:13px!important;
  font-weight:600!important;letter-spacing:.02em!important;line-height:1.45!important;
  color:var(--ink3)!important;max-width:19ch!important;margin-inline:auto!important}
section#main-section.platform .fig:hover span{color:var(--ink3)!important}

/* the divider: brand blue, faded at both ends so it reads as a rule, not a bar */
section#main-section.platform .fig+.fig::before{content:""!important;position:absolute!important;left:0!important;top:50%!important;
  width:1px!important;height:66%!important;translate:0 -50%!important;
  background:linear-gradient(180deg,transparent 0%,var(--blue) 26%,var(--blue) 74%,transparent 100%)!important;
  transform:scaleY(0)!important;transform-origin:50% 50%!important;
  transition:transform var(--m-slow,520ms) var(--m-emph) var(--d,0ms)!important}
section#main-section.platform .fig.rv.on::before{transform:scaleY(1)!important}

@media (max-width:900px){
section#main-section.platform .figs{grid-template-columns:repeat(2,minmax(0,1fr))!important;row-gap:clamp(26px,4vw,40px)!important}
section#main-section.platform .fig:nth-child(odd)::before{display:none!important}
section#main-section.platform .fig b{font-size:clamp(38px,8vw,56px)!important}
}
@media (max-width:560px){
section#main-section.platform .figs{grid-template-columns:1fr!important;row-gap:0!important}
/* stacked: the rule turns horizontal so the row still reads as one set */
section#main-section.platform .fig{padding:clamp(18px,5vw,24px) 0!important}
section#main-section.platform .fig+.fig::before{left:50%!important;top:0!important;translate:-50% 0!important;
  width:64%!important;height:1px!important;transform:scaleX(0)!important;
  background:linear-gradient(90deg,transparent 0%,var(--blue) 26%,var(--blue) 74%,transparent 100%)!important}
section#main-section.platform .fig:nth-child(odd)::before{display:block!important}
section#main-section.platform .fig.rv.on::before{transform:scaleX(1)!important}
}
@media (prefers-reduced-motion:reduce){
section#main-section.platform .fig+.fig::before{transform:none!important;transition:none!important}
}

section#main-section.platform .ph-figures.sec{padding:clamp(34px,4vw,58px) 0!important;background:var(--bg)!important}

section#main-section.platform .fig b{color:var(--blue)!important}
section#main-section.platform[data-theme="dark"] .fig b{color:var(--blue-hi)!important}

section#main-section.platform .fig b em{font-style:normal!important;color:var(--blue)!important}

/* stat type matched to aether-landing, same clamp verbatim */
section#main-section.platform .figs{max-width:none!important}
section#main-section.platform .fig{padding-left:clamp(8px,1.2vw,20px)!important;padding-right:clamp(8px,1.2vw,20px)!important}
section#main-section.platform .fig b{font-family:var(--display)!important;font-weight:700!important;letter-spacing:-.045em!important;line-height:.94!important;font-variant-numeric:tabular-nums!important;font-size:clamp(42px,5.2vw,76px)!important}
@media (max-width:900px){section#main-section.platform .fig b{font-size:clamp(38px,8vw,56px)!important}}
</style>
<section id="main-section" class="platform" data-theme="dark"><div class="pg"><svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false"><symbol id="p-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></symbol><symbol id="p-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></symbol><symbol id="p-x" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></symbol><symbol id="p-users" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/></symbol><symbol id="p-clock" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></symbol><symbol id="p-flow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h6M14 7h6M4 17h6M14 17h6"/><circle cx="12" cy="7" r="2"/><circle cx="12" cy="17" r="2"/></symbol></svg><section class="ph-sec ph-hero hero" id="top"><video autoplay muted loop playsinline preload="none" poster="https://dev-website.ithena.app/wp-content/uploads/2026/08/ith-home-aerial-plant-poster.jpg"><source src="https://dev-website.ithena.app/wp-content/uploads/2026/08/ith-home-aerial-plant.mp4" type="video/mp4"></video><div class="frame"><p class="kicker">Our platform</p><h1>Human Intelligence meets Artificial Intelligence</h1><p class="lede">Build your smart connected enterprise with ITHENA&rsquo;s generative AI persona platform. Engage in the best connected experience.</p><div class="btn-row"><a class="btn btn-primary" href="#start" data-schedule-demo>Schedule a demo <svg class="i"><use href="#p-arrow"/></svg></a><a class="btn btn-glass" href="#layers">See the four layers</a></div><div class="hbar"><span><svg class="i"><use href="#p-check"/></svg>Industrial IoT</span><span><svg class="i"><use href="#p-check"/></svg>Enterprise data assets</span><span><svg class="i"><use href="#p-check"/></svg>Big data</span><span><svg class="i"><use href="#p-check"/></svg>Generative AI outcomes</span></div></div></section><section class="ph-sec ph-figures sec"><div class="frame"><div class="figs stg"><div class="fig rv"><b data-count="4">4</b><span>Layers, edge to outcome</span></div><div class="fig rv"><b data-count="0">0</b><span>ETL pipelines to build</span></div><div class="fig rv"><b data-count="3">3</b><span>Domains on one platform</span></div><div class="fig rv"><b><em>Weeks</em></b><span>To measurable outcomes, not quarters</span></div></div></div></section><section class="ph-sec ph-intro sec"><div class="frame"><div class="shead center rv"><p class="kicker center">A fresh approach</p><h2>A fresh approach to business transformation!</h2></div><div class="introwrap"><div class="prose rv"><p>The ITHENA platform uses the best-of-breed approach for bringing together Industrial IoT, enterprise Data Assets, and Big Data &ndash; providing outcomes with generative AI that are incredibly user-friendly, ready to use, and integrated within a unified experience! Conceived with an unwavering focus on delivering role-specific outcomes within the enterprise, our technology empowers customers to achieve measurable success in a matter of weeks.</p><p>From data connectivity, data collection, ingestion &amp; classification, and complex data management to generative AI-driven outcomes &ndash; our platform provides the easiest experience across production | service | supply chain to improve industrial operations at scale!</p></div></div><figure class="wfig rv"><div class="pipewrap"><div class="pipeinner"><svg class="pipe" viewBox="0 0 1200 520" role="img" aria-labelledby="phPipeT phPipeD"><title id="phPipeT">The ITHENA platform, edge to answer</title><desc id="phPipeD">Machines at the edge send live signals into multi-stream ingest, which feeds an intelligence core that correlates non-obvious relationships, and the result is rendered as a role-specific answer on screen.</desc>
