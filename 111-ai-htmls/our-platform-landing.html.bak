inset:0!important;background:rgba(13,27,46,.7)!important}section#main-section.platform .cta>.frame{position:relative!important;z-index:2!important}section#main-section.platform .cta h2{color:#fff!important}section#main-section.platform .cta .kicker{color:var(--blue-soft)!important;justify-content:center!important}section#main-section.platform .cta .lede{color:rgba(215,236,246,.85)!important;margin-left:auto!important;margin-right:auto!important}section#main-section.platform .cta .btn-row{justify-content:center!important}section#main-section.platform .rv{opacity:0!important;translate:0 14px!important;transition:opacity var(--m-slow) var(--m-ease) var(--d,0ms),translate var(--m-slow) var(--m-emph) var(--d,0ms)!important}section#main-section.platform .rv.on{opacity:1!important;translate:none!important}section#main-section.platform .stg{--sd:70ms!important}section#main-section.platform .stg>.rv:nth-child(1){--d:0ms!important}section#main-section.platform .stg>.rv:nth-child(2){--d:calc(1 * var(--sd))!important}section#main-section.platform .stg>.rv:nth-child(3){--d:calc(2 * var(--sd))!important}section#main-section.platform .stg>.rv:nth-child(4){--d:calc(3 * var(--sd))!important}section#main-section.platform .stg>.rv:nth-child(5){--d:calc(4 * var(--sd))!important}section#main-section.platform .stg>.rv:nth-child(6){--d:calc(5 * var(--sd))!important}section#main-section.platform :focus-visible{outline:2px solid var(--blue)!important;outline-offset:3px!important;border-radius:4px!important}section#main-section.platform .schedule-popup-overlay{position:fixed!important;inset:0!important;z-index:999999!important;display:flex!important;align-items:center!important;justify-content:center!important;padding:20px!important;background:rgba(13,27,46,.62)!important;-webkit-backdrop-filter:blur(6px)!important;backdrop-filter:blur(6px)!important;opacity:0!important;visibility:hidden!important;transition:opacity .25s var(--ease),visibility .25s var(--ease)!important}section#main-section.