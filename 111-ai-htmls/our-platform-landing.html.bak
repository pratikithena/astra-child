<style>section#main-section.platform{--bg:#FFFFFF!important;--bg2:#D7ECF6!important;--card:#FFFFFF!important;--wash:#EAF5FB!important;--ink:#000000!important;--ink2:#333333!important;--ink3:#666666!important;--line:#E6EAEE!important;--blue:#0083C8!important;--blue-deep:#006AA3!important;--blue-hi:#33A1E0!important;--blue-soft:#7FC8F2!important;--green:#1EA672!important;--red:#C00000!important;--navy:#0D1B2E!important;--navy2:#123049!important;--navy3:#15334F!important;--shadow:0 24px 48px -28px rgba(13,27,46,.32)!important;--r:12px!important;--r2:16px!important;--r3:22px!important;--maxw:1240px!important;--pad:clamp(20px,4vw,40px)!important;--display:"Noto Sans",-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif!important;--body:"Inter",-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif!important;--m-quick:160ms!important;--m-std:280ms!important;--m-slow:420ms!important;--m-ease:cubic-bezier(.2,0,0,1)!important;--m-emph:cubic-bezier(.05,.7,.1,1)!important;--ease:cubic-bezier(.16,1,.3,1)!important;font-family:var(--body)!important;background:var(--bg)!important;color:var(--ink)!important;font-size:16px!important;line-height:1.6!important;-webkit-font-smoothing:antialiased!important;margin:0!important;display:block!important}section#main-section.platform[data-theme="dark"]{--bg:#0D1B2E!important;--bg2:#123049!important;--card:#123049!important;--wash:rgba(0,131,200,.16)!important;--ink:#FFFFFF!important;--ink2:rgba(215,236,246,.82)!important;--ink3:#8FAFC4!important;--line:rgba(255,255,255,.13)!important;--shadow:0 24px 48px -28px rgba(0,0,0,.7)!important}section#main-section.platform *{box-sizing:border-box!important}section#main-section.platform .pg{overflow-x:clip!important}section#main-section.platform .frame{width:100%!important;max-width:var(--maxw)!important;margin-inline:auto!important;padding-inline:var(--pad)!important}section#main-section.platform h1,section#main-section.platform h2,section#main-section.platform h3,section#main-section.platform h4{f