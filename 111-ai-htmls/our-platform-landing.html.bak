atform .schedule-popup-form .frm_forms,section#main-section.platform .schedule-popup-form .elementor-widget-shortcode{max-width:100%!important;margin:0!important}section#main-section.platform .schedule-popup-form input[type=text],section#main-section.platform .schedule-popup-form input[type=email],section#main-section.platform .schedule-popup-form input[type=tel],section#main-section.platform .schedule-popup-form input[type=number],section#main-section.platform .schedule-popup-form select,section#main-section.platform .schedule-popup-form textarea{font:inherit!important;font-family:var(--body)!important;font-size:15px!important;padding:12px 15px!important;border-radius:999px!important;border:1px solid var(--line)!important;background:var(--bg2)!important;color:var(--ink)!important;width:100%!important}section#main-section.platform .schedule-popup-form textarea{border-radius:var(--r)!important;resize:vertical!important}section#main-section.platform .schedule-popup-form label{font-size:13px!important;font-weight:600!important;color:var(--ink2)!important}section#main-section.platform .schedule-popup-form .frm_submit button,section#main-section.platform .schedule-popup-form button[type=submit]{background:var(--blue)!important;color:#fff!important;border:0!important;border-radius:999px!important;font-family:var(--body)!important;font-weight:700!important;font-size:15px!important;padding:14px 26px!important;cursor:pointer!important}section#main-section.platform .schedule-popup-empty{font-size:14px!important;line-height:1.6!important;color:var(--ink2)!important}section#main-section.platform .schedule-popup-empty a{color:var(--blue)!important;font-weight:600!important}@media (max-width:980px){section#main-section.platform .explore{grid-template-columns:1fr 1fr!important}}@media (max-width:900px){section#main-section.platform .chips{grid-template-columns:1fr!important;gap:30px!important;max-width:430px!important}}@media (max-width:720px){section#main-section.platform .explor