r(--j-ink)!important;max-width:20ch!important}section#main-section.platform .jhead>p{margin-top:14px!important;font-size:17px!important;font-weight:300!important;color:var(--j-ink2)!important;max-width:60ch!important}section#main-section.platform .jpin{position:sticky!important;top:0!important;height:100vh!important;overflow:hidden!important;display:flex!important;align-items:center!important}section#main-section.platform .jpin::before{content:""!important;position:absolute!important;inset:0!important;background:radial-gradient(120% 90% at 18% 40%,rgba(0,131,200,.18),transparent 60%)!important;z-index:0!important}section#main-section.platform .jprog{position:absolute!important;left:0!important;top:0!important;height:3px!important;width:0!important;background:var(--blue)!important;z-index:3!important;transition:width .18s linear!important}section#main-section.platform .jstage{position:relative!important;z-index:1!important;width:100%!important;max-width:var(--maxw)!important;margin:0 auto!important;padding:0 28px!important;display:grid!important;grid-template-columns:minmax(0,1.2fr) minmax(0,.8fr)!important;gap:0!important;align-items:center!important}section#main-section.platform .jplate{position:relative!important;width:100%!important;aspect-ratio:1376/768!important;height:auto!important;max-height:min(66vh,600px)!important;align-self:center!important;border-radius:18px!important;overflow:hidden!important;background:var(--j-plate)!important;box-shadow:0 50px 110px -50px var(--j-shadow)!important}section#main-section.platform .jplate .lfig{position:absolute!important;inset:0!important;width:100%!important;height:100%!important;object-fit:contain!important;opacity:0!important;transform:scale(1.06)!important;transition:opacity .75s var(--ease),transform 1.4s var(--ease)!important}section#main-section.platform .jplate .lfig.on{opacity:1!important;transform:scale(1)!important}section#main-section.platform .jside{padding-left:40px!important;display:grid!important;align-c