{"nodes": [{"id": "111_ai_htmls_pkng_page_prompt_packaging_landing_brief", "label": "Packaging Landing Page Brief", "file_type": "document", "source_file": "pkng-page-prompt.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Authoring prompt for the Packaging vertical. The stated objective is to sell business transformation and measurable outcomes, not a list of software features, and to feel like a premium enterprise platform built specifically for packaging machinery."}, {"id": "111_ai_htmls_pkng_page_prompt_design_constraints", "label": "Packaging Page Design Constraints", "file_type": "rationale", "source_file": "pkng-page-prompt.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Explicit negative constraints: avoid generic corporate design, excessive gradients, excessive glassmorphism, neon AI styling and unnecessary animation. Positive constraints restate the brand system \u2014 #0083c8 primary, light #FFFFFF/#D7ECF6 and dark #123049/#0D1B2E section backgrounds, smoothly blended section intersections with no hard border, even-px font sizes, professional SVG icons instead of emojis."}, {"id": "111_ai_htmls_pkng_page_prompt_iserv_spare_parts_commerce", "label": "iSERV AI-Powered Spare Parts Commerce", "file_type": "concept", "source_file": "pkng-page-prompt.txt", "source_location": "Section 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Interactive visual cataloguing plus AI image-to-part recognition and automated order routing; presented as a workflow (part image \u2192 AI recognition \u2192 correct part \u2192 catalogue \u2192 cart \u2192 order \u2192 routing) rather than a feature list, to make the revenue mechanism legible."}, {"id": "111_ai_htmls_pkng_page_prompt_machine_telemetry_iiot", "label": "Machine Telemetry & IIoT Analytics", "file_type": "concept", "source_file": "pkng-page-prompt.txt", "source_location": "Section 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Real-time throughput, OEE and wear-and-tear forecasting for packaging equipment; the analytics interface must be visually connected back to the physical machine so telemetry reads as attached to an asset, not abstract."}, {"id": "111_ai_htmls_pkng_page_prompt_intelligent_packaging_ecosystem", "label": "Intelligent Packaging Ecosystem Flow", "file_type": "concept", "source_file": "pkng-page-prompt.txt", "source_location": "Intelligent Packaging Ecosystem", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Machine \u2192 Telemetry \u2192 AI Insights \u2192 Predictive Maintenance \u2192 Spare Parts Identification \u2192 Digital Commerce \u2192 Order \u2192 Service \u2192 Customer, drawn with animated data-flow connections to communicate that ITHENA links the physical machine to digital commerce and service operations."}, {"id": "111_ai_htmls_pkng_page_prompt_tangible_outcomes", "label": "Tangible Outcomes Stats", "file_type": "concept", "source_file": "pkng-page-prompt.txt", "source_location": "Section 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Up to 40% aftermarket revenue increase, 50% faster order processing, 30% reduction in field unplanned downtime \u2014 each paired with its causal mechanism so the section communicates measurable business outcomes rather than displaying bare statistics."}, {"id": "111_ai_htmls_pkng_page_prompt_challenges_section", "label": "Packaging Challenges Section", "file_type": "concept", "source_file": "pkng-page-prompt.txt", "source_location": "Section 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unplanned downtime, complex spare parts, multi-SKU changeovers, lost aftermarket revenue, fragmented customer experience \u2014 followed by a visual transition from traditional to intelligent, self-servicing equipment."}, {"id": "111_ai_htmls_pkng_page_prompt_business_value", "label": "Packaging Business Value Section", "file_type": "concept", "source_file": "pkng-page-prompt.txt", "source_location": "Business Value", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Five outcomes \u2014 increase aftermarket revenue, reduce service costs, improve customer experience, increase machine availability, create connected equipment \u2014 framing installed equipment as a continuous digital revenue channel."}, {"id": "111_ai_htmls_pkng_page_prompt_accessibility_requirements", "label": "Packaging Page Accessibility Requirements", "file_type": "concept", "source_file": "pkng-page-prompt.txt", "source_location": "Accessibility", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Heading hierarchy, contrast, keyboard navigation, visible focus, accessible video controls, alt text, semantic HTML and reduced-motion support requested up-front in the brief rather than retrofitted."}], "edges": [{"source": "111_ai_htmls_pkng_page_prompt_packaging_landing_brief", "target": "111_ai_htmls_pkng_page_prompt_design_constraints", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "pkng-page-prompt.txt", "source_location": null, "weight": 1.0}, {"source": "111_ai_htmls_pkng_page_prompt_packaging_landing_brief", "target": "111_ai_htmls_pkng_page_prompt_challenges_section", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "pkng-page-prompt.txt", "source_location": "Section 1", "weight": 1.0}, {"source": "111_ai_htmls_pkng_page_prompt_packaging_landing_brief", "target": "111_ai_htmls_pkng_page_prompt_tangible_outcomes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "pkng-page-prompt.txt", "source_location": "Section 2", "weight": 1.0}, {"source": "111_ai_htmls_pkng_page_prompt_packaging_landing_brief", "target": "111_ai_htmls_pkng_page_prompt_iserv_spare_parts_commerce", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "pkng-page-prompt.txt", "source_location": "Section 3", "weight": 1.0}, {"source": "111_ai_htmls_pkng_page_prompt_packaging_landing_brief", "target": "111_ai_htmls_pkng_page_prompt_machine_telemetry_iiot", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "pkng-page-prompt.txt", "source_location": "Section 3", "weight": 1.0}, {"source": "111_ai_htmls_pkng_page_prompt_packaging_landing_brief", "target": "111_ai_htmls_pkng_page_prompt_intelligent_packaging_ecosystem", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "pkng-page-prompt.txt", "source_location": null, "weight": 1.0}, {"source": "111_ai_htmls_pkng_page_prompt_packaging_landing_brief", "target": "111_ai_htmls_pkng_page_prompt_business_value", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "pkng-page-prompt.txt", "source_location": null, "weight": 1.0}, {"source": "111_ai_htmls_pkng_page_prompt_packaging_landing_brief", "target": "111_ai_htmls_pkng_page_prompt_accessibility_requirements", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "pkng-page-prompt.txt", "source_location": null, "weight": 1.0}, {"source": "111_ai_htmls_pkng_page_prompt_design_constraints", "target": "111_ai_htmls_ithena_brand_guidelines_section_alternation_soft_blend", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "pkng-page-prompt.txt", "source_location": null, "weight": 1.0}, {"source": "111_ai_htmls_pkng_page_prompt_design_constraints", "target": "111_ai_htmls_ithena_brand_guidelines_brand_colour_system", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0,