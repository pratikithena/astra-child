{"nodes": [{"id": "111_ai_htmls_industry_pages_feature_visual_image_spec_upload_rules", "label": "WordPress -scaled Upload Rules", "file_type": "rationale", "source_file": "industry-pages/feature-visual-image-spec.md", "source_location": "Upload rules", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Markup already references /wp-content/uploads/2026/08/<slug>-scaled.webp, and WordPress only appends -scaled when the upload is wider than 2560px. Exporting at 3840\u00d72160 and uploading in August 2026 is therefore mandatory \u2014 a narrower or later upload 404s."}, {"id": "111_ai_htmls_industry_pages_feature_visual_image_spec_art_direction", "label": "Feature Visual Art Direction", "file_type": "rationale", "source_file": "industry-pages/feature-visual-image-spec.md", "source_location": "Art direction", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prefer real ITHENA app screenshots; where generating instead, stay in the illustration register with no ITHENA logo and no specific metric values \u2014 a photoreal fake of the product UI with invented OEE numbers reads to a marketing-page visitor as evidence of what the software actually does. Palette locked to page tokens, bright and low-contrast at the edges so the image does not punch a white hole in dark mode."}, {"id": "111_ai_htmls_industry_pages_feature_visual_image_spec_image_slots", "label": "17 Feature-Visual Image Slots", "file_type": "concept", "source_file": "industry-pages/feature-visual-image-spec.md", "source_location": "The 17 slots", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CSS .feature-visual mockups on 8 industry pages were replaced by <img> tags following the packaging page pattern; the 17 referenced images do not exist yet, so this spec is the production brief. Alt text is already written into each <img>."}], "edges": [{"source": "111_ai_htmls_industry_pages_fe