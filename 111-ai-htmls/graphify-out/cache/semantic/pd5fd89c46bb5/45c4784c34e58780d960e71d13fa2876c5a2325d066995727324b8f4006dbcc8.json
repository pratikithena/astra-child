{"nodes": [{"id": "111_ai_htmls_navigation_site_navigation", "label": "ITHENA Site Navigation Hierarchy", "file_type": "document", "source_file": "NAVIGATION.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Five top-level branches (Solutions, Services, Industries, Case Studies, Company). Solutions is segmented by audience (OEM|Distributors, Manufacturer, Enterprise) rather than by product, so a visitor self-selects by role before meeting product names."}, {"id": "111_ai_htmls_navigation_solutions", "label": "Solutions Branch", "file_type": "concept", "source_file": "NAVIGATION.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three audience columns \u2014 OEM|Distributors (Front Office Ops, After Market Services), Manufacturer (Planning, Production, Quality, Maintenance), Enterprise (Supply Chain, Data Analytics, Apps)."}, {"id": "111_ai_htmls_navigation_services", "label": "Services Branch", "file_type": "concept", "source_file": "NAVIGATION.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Advisory Consulting, Data Management, Cloud Modernization, Business Transformation, Manufacturing Integration \u2014 each a group with two leaf offerings."}, {"id": "111_ai_htmls_navigation_industries", "label": "Industries Branch", "file_type": "concept", "source_file": "NAVIGATION.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Grouped OEM / Manufacturing / Strategic Industries; these leaves are exactly the vertical landing pages the brand guidelines and design specs are written to produce."}, {"id": "111_ai_htmls_navigation_case_studies", "label": "Case Studies Branch", "file_type": "concept", "source_file": "NAVIGATION.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The only top-level branch with no children \u2014 a flat link rather than a mega-panel, which the dynamic header's tree-shape inference renders differently."}, {"id": "111_ai_htmls_navigation_company", "label": "Company Branch", "file_type": "concept", "source_file": "NAVIGATION.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Flat leaf list (Who We Are, Blogs, Announcements, Partnerships, Careers) \u2014 renders as a flat-card mega-panel rather than a column/group layout."}, {"id": "111_ai_htmls_navigation_icrm", "label": "iCRM", "file_type": "concept", "source_file": "NAVIGATION.txt", "source_location": "Solutions > OEM|Distributors > Front Office Ops", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "111_ai_htmls_navigation_performance_monitoring", "label": "Performance Monitoring", "file_type": "concept", "source_file": "NAVIGATION.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Appears twice in the tree \u2014 under After Market Services and under Manufacturer > Production \u2014 so the same offering is reached from two audience paths."}, {"id": "111_ai_htmls_navigation_b2b_ecommerce", "label": "B2B eCommerce", "file_type": "concept", "source_file": "NAVIGATION.txt", "source_location": "Solutions > OEM|Distributors > After Market Services", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "111_ai_htmls_navigation_service_portal", "label": "Service Portal", "file_type": "concept", "source_file": "NAVIGATION.txt", "source_location": "Solutions > OEM|Distributors > After Market Services", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "111_ai_htmls_navigation_aether", "label": "Aether", "file_type": "concept", "source_file": "NAVIGATION.txt", "source_