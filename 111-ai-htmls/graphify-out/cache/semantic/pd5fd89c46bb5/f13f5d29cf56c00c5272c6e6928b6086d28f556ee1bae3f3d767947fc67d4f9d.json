{"nodes": [{"id": "111_ai_htmls_b2b_ecommerce_solutions_v2_page", "label": "iSERV B2B eCommerce Solutions Landing (v2)", "file_type": "document", "source_file": "b2b-ecommerce-solutions-v2.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "111_ai_htmls_b2b_ecommerce_solutions_v2_aftermarket_revenue_leak", "label": "Aftermarket Revenue Leak (hero problem framing)", "file_type": "concept", "source_file": "b2b-ecommerce-solutions-v2.html", "source_location": "section.hero#top", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "111_ai_htmls_b2b_ecommerce_solutions_v2_quote_to_invoice_flow", "label": "Search-to-Invoice Flow (no rekey)", "file_type": "concept", "source_file": "b2b-ecommerce-solutions-v2.html", "source_location": "section.sec.deep#flow", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "111_ai_htmls_b2b_ecommerce_solutions_v2_part_visualisation", "label": "3D/360 Part Visualisation Section", "file_type": "concept", "source_file": "b2b-ecommerce-solutions-v2.html", "source_location": "section.sec#visualisation", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "111_ai_htmls_b2b_ecommerce_solutions_v2_sixteen_modules", "label": "Sixteen Modules Grid (catalogue, pricing engine, ERP integration)", "file_type": "concept", "source_file": "b2b-ecommerce-solutions-v2.html", "source_location": "section.sec.alt#modules", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "111_ai_htmls_b2b_ecommerce_solutions_v2_settheme", "label": "setTheme (b2b page)", "file_type": "code", "source_file": "b2b-ecommerce-solutions-v2.html", "source_location": "line 252", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "111_ai_htmls_b2b_ecommerce_solutions_v2_bindtoggle", "label": "bindToggle (b2b page)", "file_type": "code", "source_file": "b2b-ecommerce-solutions-v2.html", "source_location": "line 261", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "111_ai_htmls_b2b_ecommerce_solutions_v2_openschedulepopup", "label": "openSchedulePopup (b2b page)", "file_type": "code", "source_file": "b2b-ecommerce-solutions-v2.html", "source_location": "line 531", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "111_ai_htmls_b2b_ecommerce_solutions_v2_closeschedulepopup", "label": "closeSchedulePopup (b2b page)", "file_type": "code", "source_file": "b2b-ecommerce-solutions-v2.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "111_ai_htmls_b2b_ecommerce_solutions_v2_onschedulekeydown", "label": "onScheduleKeydown (b2b page)", "file_type": "code", "source_file": "b2b-ecommerce-solutions-v2.html", "source_location": "line 530", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "111_ai_htmls_b2b_ecommerce_solutions_v2_adoptscheduleform", "label": "adoptScheduleForm (b2b page)", "file_type": "code", "source_file": "b2b-ecommerce-solutions-v2.html", "source_location": "line 512", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "111_ai_htmls_b2b_ecommerce_solutions_v2_schedule_demo_modal", "label": "Schedule-Demo Modal Pattern", "file_type": "rationale", "source_file": "b2b-ecommerce-solutions-v2.html", "source_location": "#schedulePopup / #schedulePopupFormSlot", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every landing page ships an inert #schedulePopup shell with an empty #schedulePopupFormSlot, opened by any [data-schedule-demo] trigger. Rather than embedding a form per page, adoptScheduleForm() hunts the live DOM for a Formidable form (#schedule-demo-form, .schedule-demo-form, an Elementor .elementor-widget-shortcode containing .frm_forms, or a bare .frm_forms) and physically relocates that node into the slot, guarded by a scheduleFormMoved latch. This keeps the static HTML prototype identical to the WordPress-deployed page: the marketing team drops a Formidable widget anywhere on the page and it is silently teleported into the modal, so the prototype never has to hardcode form markup that WP would duplicate. Adoption is attempted on DOMContentLoaded, on window load, and again on modal open to survive late-rendering Elementor widgets."}, {"id": "111_ai_htmls_b2b_ecommerce_solutions_v2_rv_scroll_reveal", "label": ".rv / .stg Scroll-Reveal Pattern", "file_type": "rationale", "source_file": "b2b-ecommerce-solutions-v2.html", "source_location": "lines 474-505", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shared reveal mechanism across all landing pages: elements tagged .rv are observed by an IntersectionObserver (threshold .16, rootMargin 0 0 -40px 0) that adds .on once and unobserves, so reveals never replay. .stg staggers children via per-index transition-delay. Any [data-count] descendant inside a revealed block animates a cubic ease-out counter over 1100ms. A second observer (threshold .55) toggles .on on .stop elements for scroll-pinned narrative beats. Critically the whole block is gated on prefers-reduced-motion: when reduced, every .rv and .stop is given .on immediately so content is never hidden from users who disabled motion - the reveal is progressive enhancement, not a display dependency."}, {"id": "111_ai_htmls_b2b_ecommerce_solutions_v2_motion_tokens", "label": "--m-std / --m-ease Motion Tokens", "file_type": "rationale", "source_file": "b2b-ecommerce-solutions-v2.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two CSS custom properties carry the entire motion vocabulary: --m-std for the standard duration and --m-ease for the shared easing curve. Every transition on every page references these instead of literal values, so the whole design system's motion feel is retuned from one declaration block. The b2b page alone references them ~76 times."}, {"id": "111_ai_htmls_b2b_ecommerce_solutions_v2_color_tokens", "label": "Brand Color Tokens (--blue / --ink / --navy)", "file_type": "concept", "source_file": "b2b-ecommerce-solutions-v2.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "111_ai_htmls_b2b_ecommerce_solutions_v2_main_section_theme_root", "label": "#main-section data-theme Contract", "file_type": "rationale", "source_file": "b2b-ecommerce-solutions-v2.html", "source_location": "section#main-section", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every landing page scopes its whole light/dark palette to a data-theme attribute on its own section#main-section wrapper (not <html>), because the page is injected into an existing WordPress/Astra document whose root element the page does not own. The header plugin independently sets data-theme on the same #main-section, making that attribute the de-facto integration contract between the site header and any page body. Divergence risk: the pages persist their choice under localStorage key 'fbb-theme' while wp-header-shortcode.php persists under 'ithena-theme', so header and page can disagree after reload."}], "edges": [{"source": "111_ai_htmls_b2b_ecommerce_solutions_v2_openschedulepopup", "target": "111_ai_htmls_b2b_ecommerce_solutions_v2_adoptscheduleform", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "b2b-ecommerce-solutions-v2.html", "source_location": "line 533", "weight": 1.0}, {"source": "111_ai_htmls_b2b_ecommerce_solutions_v2_onschedulekeydown", "target": "111_ai_htmls_b2b_ecommerce_solutions_v2_closeschedulepopup", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "b2b-ecommerce-solutions-v2.html", "source_location": "line 530", "weight": 1.0}, {"source": "111_ai_htmls_b2b_ecommerce_solutions_v2_openschedulepopup", "target": "111_ai_htmls_b2b_ecommerce_solutions_v2_onschedulekeydown", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "b2b-ecommerce-solutions-v2.html", "source_location": "line 537 keydown listener registration", "weight": 1.0}, {"source": "111_ai_htmls_b2b_ecommerce_solutions_v2_bindtoggle", "target": "111_ai_htmls_b2b_ecommerce_solutions_v2_settheme", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "b2b-ecommerce-solutions-v2.html", "source_location": "line 265", "weight": 1.0}, {"source": "111_ai_htmls_b2b_ecommerce_solutions_v2_settheme", "target": "111_ai_htmls_b2b_ecommerce_solutions_v2_main_section_theme_root", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "b2b-ecommerce-solutions-v2.html", "source_location": "line 253", "weight": 1.0}, {"source": "111_ai_htmls_b2b_ecommerce_solutions_v2_adoptscheduleform", "target": "111_ai_htmls_b2b_ecommerce_solutions_v2_schedule_demo_modal", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "b2b-ecommerce-solutions-v2.html", "source_location": "lines 512-529", "weight": 1.0}, {"source": "111_ai_htmls_b2b_ecommerce_solutions_v2_page", "target": "111_ai_htmls_b2b_ecommerce_solutions_v2_rv_scroll_reveal", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "b2b-ecommerce-solutions-v2.html", "source_location": null, "weight": 1.0}, {"source": "111_ai_htmls_b2b_ecommerce_solutions_v2_rv_scroll_reveal", "target": "111_ai_htmls_b2b_ecommerce_solutions_v2_motion_tokens", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "b2b-ecommerce-solutions-v2.html", "source_location": null, "weight": 1.0}, {"source": "111_ai_htmls_b2b_ecommerce_solutions_v2_page", "target": "111_ai_htmls_b2b_ecommerce_solutions_v2_aftermarket_revenue_leak", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "b2b-ecommerce-solutions-v2.html", "source_location": null, "weight": 1.0}, {"source": "111_ai_htmls_b2b_ecommerce_solutions_v2_page", "target": "111_ai_htmls_b2b_ecommerce_solutions_v2_quote_to_invoice_flow", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "b2b-ecommerce-solutions-v2.html", "source_location": null, "weight": 1.0}, {"source": "111_ai_htmls_b2b_ecommerce_solutions_v2_page", "target": "111_ai_htmls_b2b_ecommerce_solutions_v2_sixteen_modules", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "b2b-ecommerce-solutions-v2.html", "source_location": null, "weight": 1.0}, {"source": "111_ai_htmls_b2b_ecommerce_solutions_v2_page", "target": "111_ai_htmls_b2b_ecommerce_solutions_v2_part_visualisation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "b2b-ecommerce-solutions-v2.html", "source_location": null, "weight": 1.0}, {"source": "111_ai_htmls_b2b_ecommerce_solutions_v2_quote_to_invoice_flow", "target": "111_ai_htmls_b2b_ecommerce_solutions_v2_sixteen_modules", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "b2b-ecommerce-solutions-v2.html", "source_location": null, "weight": 1.0}, {"source": "111_ai_htmls_b2b_ecommerce_solutions_v2_aftermarket_revenue_leak", "target": "111_ai_htmls_b2b_ecommerce_solutions_v2_part_visualisation", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "b2b-ecommerce-solutions-v2.html", "source_location": null, "weight": 1.0}, {"source": "111_ai_htmls_b2b_ecommerce_solutions_v2_page", "target": "111_ai_htmls_our_platform_landing_page", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "b2b-ecommerce-solutions-v2.html", "source_location": "product landing vs. umbrella platform page in the same site's information architecture", "weight": 1.0}], "hyperedges": [{"id": "ithena_landing_design_system", "label": "Shared Landing-Page Design System (theme root, reveal, motion tokens, demo modal)", "nodes": ["111_ai_htmls_b2b_ecommerce_solutions_v2_page", "111_ai_htmls_our_platform_landing_page", "111_ai_htmls_aether_landing_page", "111_ai_htmls__ae_page", "111_ai_htmls__ph_page", "111_ai_htmls_b2b_ecommerce_solutions_v2_rv_scroll_reveal", "111_ai_htmls_b2b_ecommerce_solutions_v2_motion_tokens", "111_ai_htmls_b2b_ecommerce_solutions_v2_schedule_demo_modal", "111_ai_htmls_b2b_ecommerce_solutions_v2_main_section_theme_root"], "relation": "participate_in", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "b2b-ecommerce-solutions-v2.html"}, {"id": "schedule_demo_form_adoption_flow", "label": "Schedule-Demo Formidable Adoption Flow", "nodes": ["111_ai_htmls_b2b_ecommerce_solutions_v2_openschedulepopup", "111_ai_htmls_b2b_ecommerce_solutions_v2_closeschedulepopup", "111_ai_htmls_b2b_ecommerce_solutions_v2_onschedulekeydown", "111_ai_htmls_b2b_ecommerce_solutions_v2_adoptscheduleform", "111_ai_htmls_our_platform_landing_adoptscheduleform", "111_ai_htmls_b2b_ecommerce_solutions_v2_schedule_demo_modal"], "relation": "form", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "b2b-ecommerce-solutions-v2.html"}]}