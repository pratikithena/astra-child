{"@type":"Question","name":"Will switching to ITHENA change how my team uses Microsoft?","acceptedAnswer":{"@type":"Answer","text":"No. You keep the same subscriptions, users and applications. What changes is who you buy from, and how much you pay."}},
{"@type":"Question","name":"Where does the \"up to 15%\" savings come from?","acceptedAnswer":{"@type":"Answer","text":"As an authorized Microsoft reseller, ITHENA can offer pricing on your existing subscriptions that's lower than buying direct. Actual savings depend on your products, seat counts and agreement type."}},
{"@type":"Question","name":"Is the Licensing & Renewal Review really free, and when should I book it?","acceptedAnswer":{"@type":"Answer","text":"Yes, there's no cost and no obligation. Ideally book it 90 to 120 days before your renewal date, but we can help at any time. Approximate seat counts and products are enough to get started."}},
{"@type":"Question","name":"Do you offer support after the sale?","acceptedAnswer":{"@type":"Answer","text":"Yes. Tenant support, quarterly architecture and security evaluations, bi-annual optimization reviews, renewal assistance and AI workshops are part of the partnership."}}]}
</script>

<script>
(function () {
  "use strict";
  var root = document.querySelector("section.pt-page");
  if (!root) return;
  var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  var canAnimate = !reduce && "IntersectionObserver" in window;
  var $$ = function (s, c) { return Array.prototype.slice.call((c || root).querySelectorAll(s)); };
  function css(el, k, v) { if (v === "") el.style.removeProperty(k); else el.style.setProperty(k, v, "important"); }

  if (window.ithenaTheme) {
    window.ithenaTheme.sync();
  } else {
    var toggle = document.getElementById("themeToggle");
    var stored = null; try { stored = localStorage.getItem("fbb-theme"); } catch (e) {}
    var setTheme = function (m) {
      root.setAttribute("data-theme", m);
      if (toggle) toggle.setAttribute("aria-pressed", m === "dark" ? "true" : "false");
      try { localStorage.setItem("fbb-theme", m); } catch (e) {}
    };
    setTheme(stored || "dark");
    if (toggle) toggle.addEventListener("click", function () { setTheme(root.getAttribute("data-theme") === "dark" ? "light" : "dark"); });
  }

  /* sticky header offset, so the subnav and scroll-margins clear a fixed site header */
  var hdr = document.getElementById("site-header") || document.querySelector("header.site-header");
  function syncHdr() {
    var h = 0;
    if (hdr && /fixed|sticky/.test(getComputedStyle(hdr).position)) h = Math.max(0, Math.round(hdr.getBoundingClientRect().height));
    css(root, "--hdr", h + "px");
  }
  syncHdr();
  window.addEventListener("load", syncHdr);
  window.addEventListener("resize", syncHdr);

  /* "On this page" rail: active entry plus a thumb that slides to it */
  var navLinks = $$("#ptNav a"), thumb = document.getElementById("ptThumb");
  var navSecs = navLinks.map(function (a) { return document.getElementById(a.getAttribute("href").slice(1)); });
  function syncNav() {
    var best = 0;
    for (var i = 0; i < navSecs.length; i++) if (navSecs[i] && navSecs[i].getBoundingClientRect().top - 220 <= 0) best = i;
    navLinks.forEach(function (a, i) { a.classList.toggle("on", i === best); });
    var link = navLinks[best];
    if (thumb && link) {
      css(thumb, "height", link.offsetHeight + "px");
      css(thumb, "transform", "translateY(" + link.offsetTop + "px)");
    }
  }
  var ticking = false;
  window.addEventListener("scroll", function () {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(function () { syncNav(); ticking = false; });
  }, { passive: true });
  window.addEventListener("resize", syncNav);
  syncNav();

  /* entry animations: slow, staggered, one-shot */
  if (canAnimate) {
    $$(".stg").forEach(function (g) {
      Array.prototype.forEach.call(g.children, function (el, i) { css(el, "transition-delay", 140 + i * 180 + "ms"); });
    });
    var io = new IntersectionObserver(function (es) {
      es.forEach(function (e) {
        if (!e.isIntersecting) return;
        e.target.classList.add("in");
        io.unobserve(e.target);
      });
    }, { threshold: 0.12, rootMargin: "0px 0px -60px 0px" });
    $$(".rev, .stg").forEach(function (el) { io.observe(el); });
  } else {
    $$(".rev, .stg").forEach(function (el) { el.classList.add("in"); });
  }

  /* counters: hero figure and the proof strip */
  function runCounter(host) {
    var el = host.querySelector("[data-count]");
    if (!el) return;
    var target = parseInt(el.getAttribute("data-count"), 10);
    if (host._done) return;
    function finish() { if (host._done) return; host._done = true; el.textContent = target; document.removeEventListener("visibilitychange", onHide); }
    function onHide() { if (document.hidden) finish(); }
    if (reduce || !isFinite(target)) { finish(); return; }
    var start = null, dur = 1600;
    document.addEventListener("visibilitychange", onHide);
    setTimeout(finish, dur + 260);
    (function step(now) {
      if (host._done) return;
      if (start === null) start = now;
      var p = Math.min(1, (now - start) / dur);
      el.textContent = Math.round(target * (1 - Math.pow(1 - p, 4)));
      if (p < 1) requestAnimationFrame(step); else finish();
    })(performance.now());
  }
  var counters = $$(".h-fig, .stat");
  if (canAnimate) {
    var cio = new IntersectionObserver(function (es) {
      es.forEach(function (e) { if (!e.isIntersecting) return; cio.unobserve(e.target); runCounter(e.target); });
    }, { threshold: 0.5 });
    counters.forEach(function (c) { cio.observe(c); });
  } else {
    counters.forEach(function (c) { var el = c.querySelector("[data-count]"); if (el) el.textContent = el.getAttribute("data-count"); });
  }

  /* offerings: card n and lifecycle stage n light up together; pauses off-screen */
  var cards = $$("#platform .card"), flowLis = $$("#platform .flow li"), flow = root.querySelector("#platform .flow");
  if (cards.length && !reduce) {
    var at = -1, cyc = null;
    function lightNext() {
      at = (at + 1) % cards.length;
      cards.forEach(function (c, i) { c.classList.toggle("on", i === at); });
      flowLis.forEach(function (l, i) { l.classList.toggle("on", i === at); });
    }
    function play() { if (cyc) return; if (flow) flow.classList.add("live"); lightNext(); cyc = setInterval(lightNext, 2400); }
    function stop() {
      clearInterval(cyc); cyc = null;
      if (flow) flow.classList.remove("live");
      cards.forEach(function (c) { c.classList.remove("on"); });
      flowLis.forEach(function (l) { l.classList.remove("on"); });
    }
    if ("IntersectionObserver" in window) {
      new IntersectionObserver(function (es) {
        es.forEach(function (e) { if (e.isIntersecting) play(); else stop(); });
      }, { threshold: 0.25 }).observe(cards[0].parentNode);
    } else play();
    document.addEventListener("visibilitychange", function () { if (document.hidden) stop(); });
    var cardGrid = cards[0].parentNode;
    cardGrid.addEventListener("mouseenter", stop);
    cardGrid.addEventListener("mouseleave", play);
  }

  /* approach: one step at a time, same cadence */
  var roles = $$("#approach .role");
  if (roles.length && !reduce) {
    var ra = -1, rcyc = null;
    function rNext() { ra = (ra + 1) % roles.length; roles.forEach(function (r, i) { r.classList.toggle("on", i === ra); }); }
    function rPlay() { if (rcyc) return; rNext(); rcyc = setInterval(rNext, 2400); }
    function rStop() { clearInterval(rcyc); rcyc = null; roles.forEach(function (r) { r.classList.remove("on"); }); }
    if ("IntersectionObserver" in window) {
      new IntersectionObserver(function (es) {
        es.forEach(function (e) { if (e.isIntersecting) rPlay(); else rStop(); });
      }, { threshold: 0.3 }).observe(roles[0].parentNode);
    } else rPlay();
    document.addEventListener("visibilitychange", function () { if (document.hidden) rStop(); });
    var roleGrid = roles[0].parentNode;
    roleGrid.addEventListener("mouseenter", rStop);
    roleGrid.addEventListener("mouseleave", rPlay);
  }

  $$(".pt-modal").forEach(function (d) {
    if (typeof d.showModal !== "function") return;
    function open() { if (!d.open) { d.showModal(); document.documentElement.style.overflow = "hidden"; } }
    d.addEventListener("close", function () { if (!root.querySelector(".pt-modal[open]")) document.documentElement.style.overflow = ""; });
    d.addEventListener("click", function (e) { if (e.target === d) d.close(); });
    var x = d.querySelector("[data-pt-close]");
    if (x) x.addEventListener("click", function () { d.close(); });
    $$('[data-pt-modal="' + d.id + '"]').forEach(function (a) {
      a.addEventListener("click", function (e) { e.preventDefault(); open(); });
    });
    if (d.querySelector(".frm_message, .frm_error_style, .frm_blank_field")) open();
  });
})();
</script>
