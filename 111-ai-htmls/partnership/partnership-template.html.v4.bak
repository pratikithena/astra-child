<!-- ============================== HERO ============================== -->
<header class="pt-sec pt-hero">
  <div class="hero-bg" aria-hidden="true">
    <img src="https://dev-website.ithena.app/wp-content/uploads/2026/09/ms-banner.webp" alt="" width="1920" height="1080" fetchpriority="high" decoding="async">
  </div>
  <div class="wrap hero-in">
    <div class="rev">
      <span class="lockup">
        <span class="lk-us">ITHENA</span>
        <span class="lk-r" aria-hidden="true"></span>
        <img src="https://dev-website.ithena.app/wp-content/uploads/2026/09/ith-home-partners-microsoft.png" alt="Microsoft" loading="lazy" width="120" height="19">
      </span>
      <h1 class="h-title">Same Microsoft. Smarter spend. <em>Real AI results.</em></h1>
      <p class="h-deck">As an authorized Microsoft reseller and Cloud &amp; AI Solutions Partner, ITHENA helps you save up to 15% on your existing Microsoft subscriptions &mdash; and secure, optimize and get more out of every license.</p>
      <ul class="h-tags">
        <li>Authorized reseller</li>
        <li>Cloud &amp; AI Solutions Partner</li>
        <li>Licensing &amp; renewals</li>
        <li>Security &amp; compliance</li>
        <li>Data &amp; AI</li>
      </ul>
      <div class="btns">
        <a class="btn btn-p" href="https://ithena.ai/contact-us/" data-pt-modal="ptModalReview" aria-haspopup="dialog">Get your free licensing review <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#p-arr"/></svg></a>
        <a class="btn btn-o" href="https://ithena.ai/contact-us/" data-pt-modal="ptModalCall" aria-haspopup="dialog" style="border-color:rgba(255,255,255,.28)!important;color:#fff!important">Schedule a call</a>
      </div>
    </div>
    <aside class="h-fig rev">
      <p class="fig-cap">Save up to</p>
      <p class="num"><span data-count="15">15</span><i>%</i></p>
      <p class="fig-sub">off the Microsoft subscriptions you already run. Same products, same users, same experience &mdash; bought through ITHENA.</p>
      <!-- disclaimer wording pending legal/licensing sign-off -->
      <p class="fig-foot">Savings vary by product, seat count and agreement type.</p>
    </aside>
  </div>
</header>

