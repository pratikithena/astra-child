<!-- ═══════ 4 PILLARS ═══════ -->
<section class="pillars-section">
  <div class="imex-container">
    <div class="pillars-header">
      <span class="tag" style="margin-bottom:1.25rem">The IMEX Framework</span>
      <h2>Key Pillars to <span>AI-Driven<br>Intelligent Manufacturing</span></h2>
      <p>Four integrated pillars that transform disconnected shop-floor operations into a self-optimizing, data-driven manufacturing ecosystem.</p>
    </div>
    <div class="pillars-grid">
      <!-- P1 -->
      <div class="pillar-card">
        <div class="pillar-top">
          <svg viewBox="0 0 280 150" xmlns="http://www.w3.org/2000/svg">
            <rect width="280" height="150" fill="var(--bg-secondary)"/>
            <g transform="translate(30,20)">
              <rect width="220" height="110" rx="8" fill="var(--bg-card-hover)" stroke="var(--border)"/>
              <text x="12" y="18" fill="var(--text-secondary)" font-family="Space Mono" font-size="7" font-weight="600">DAILY HUDDLE BOARD</text>
              <line x1="80" y1="26" x2="80" y2="105" stroke="var(--border)"/><line x1="153" y1="26" x2="153" y2="105" stroke="var(--border)"/>
              <text x="30" y="36" fill="var(--text-muted)" font-family="Space Mono" font-size="6" text-anchor="middle">TODO</text>
              <text x="116" y="36" fill="var(--text-muted)" font-family="Space Mono" font-size="6" text-anchor="middle">IN PROGRESS</text>
              <text x="190" y="36" fill="var(--text-muted)" font-family="Space Mono" font-size="6" text-anchor="middle">DONE</text>
              <rect x="8" y="42" width="64" height="18" rx="3" fill="var(--tag-bg)" stroke="var(--tag-border)"/><rect x="5" y="42" width="3" height="18" rx="1.5" fill="var(--cyan)"/><text x="14" y="54" fill="var(--cyan)" font-family="DM Sans" font-size="6">Safety Check</text>
              <rect x="8" y="64" width="64" height="18" rx="3" fill="rgba(255,181,71,.06)" stroke="rgba(255,181,71,.12)"/><rect x="5" y="64" width="3" height="18" rx="1.5" fill="var(--amber)"/><text x="14" y="76" fill="var(--amber)" font-family="DM Sans" font-size="6">5S Audit</text>
              <rect x="86" y="42" width="60" height="18" rx="3" fill="var(--surface-tint)" stroke="var(--tag-border)"/><rect x="83" y="42" width="3" height="18" rx="1.5" fill="var(--accent)"/><text x="92" y="54" fill="var(--accent)" font-family="DM Sans" font-size="6">Line Review</text>
              <rect x="86" y="64" width="60" height="18" rx="3" fill="rgba(0,232,143,.06)" stroke="rgba(0,232,143,.12)"/><rect x="83" y="64" width="3" height="18" rx="1.5" fill="var(--green)"/><text x="92" y="76" fill="var(--green)" font-family="DM Sans" font-size="6">KPI Update</text>
              <rect x="159" y="42" width="54" height="18" rx="3" fill="rgba(0,232,143,.06)" stroke="rgba(0,232,143,.12)"/><text x="165" y="54" fill="var(--green)" font-family="DM Sans" font-size="6">✓ Shift Brief</text>
              <rect x="159" y="64" width="54" height="18" rx="3" fill="rgba(0,232,143,.06)" stroke="rgba(0,232,143,.12)"/><text x="165" y="76" fill="var(--green)" font-family="DM Sans" font-size="6">✓ Escalation</text>
              <rect x="159" y="86" width="54" height="18" rx="3" fill="rgba(0,232,143,.06)" stroke="rgba(0,232,143,.12)"/><text x="165" y="98" fill="var(--green)" font-family="DM Sans" font-size="6">✓ WIP Count</text>
            </g>
            <circle cx="48" cy="140" r="3" fill="var(--accent)" opacity=".4"/><circle cx="140" cy="140" r="3" fill="var(--accent)" opacity=".6"/><circle cx="232" cy="140" r="3" fill="var(--accent)" opacity=".8"/>
            <path d="M48,140 L140,140 L232,140" stroke="var(--accent)" stroke-width=".5" stroke-dasharray="3" opacity=".3"/>
          </svg>
          <div class="pillar-num">1</div>
        </div>
        <div class="pillar-body"><h3>Digital Gemba Walks</h3><div class="pillar-tag-row"><span class="pillar-tag">Daily Huddles</span><span class="pillar-tag">Kanban Boards</span><span class="pillar-tag">Action Tracking</span></div><p>Digitize daily huddles, shop-floor walks, and Kanban boards into structured, trackable workflows that drive accountability and continuous improvement.</p></div>
        <div class="pillar-accent"></div>
      </div>
      <!-- P2 -->
      <div class="pillar-card">
        <div class="pillar-top">
          <svg viewBox="0 0 280 150" xmlns="http://www.w3.org/2000/svg">
            <rect width="280" height="150" fill="var(--bg-secondary)"/>
            <g transform="translate(30,15)">
              <rect width="220" height="120" rx="8" fill="var(--bg-card-hover)" stroke="var(--border)"/>
              <text x="12" y="18" fill="var(--text-secondary)" font-family="Space Mono" font-size="7" font-weight="600">TRACK &amp; TRACE — GENEALOGY</text>
              <rect x="80" y="28" width="60" height="18" rx="4" fill="rgba(188,26,0,.1)" stroke="rgba(188,26,0,.25)"/><text x="92" y="40" fill="var(--maroon)" font-family="Space Mono" font-size="6">FG-2847</text>
              <line x1="90" y1="46" x2="50" y2="56" stroke="var(--border)"/><line x1="110" y1="46" x2="110" y2="56" stroke="var(--border)"/><line x1="130" y1="46" x2="170" y2="56" stroke="var(--border)"/>
              <rect x="24" y="56" width="52" height="16" rx="3" fill="var(--tag-bg)" stroke="var(--tag-border)"/><text x="32" y="67" fill="var(--accent)" font-family="Space Mono" font-size="5">RM-A031</text>
              <rect x="84" y="56" width="52" height="16" rx="3" fill="var(--tag-bg)" stroke="var(--tag-border)"/><text x="92" y="67" fill="var(--accent)" font-family="Space Mono" font-size="5">SA-B019</text>
              <rect x="144" y="56" width="52" height="16" rx="3" fill="var(--tag-bg)" stroke="var(--tag-border)"/><text x="152" y="67" fill="var(--accent)" font-family="Space Mono" font-size="5">RM-C044</text>
              <rect x="12" y="82" width="196" height="28" rx="5" fill="var(--bg-primary)" stroke="var(--border)"/>
              <text x="18" y="94" fill="var(--text-muted)" font-family="Space Mono" font-size="5">STATION</text>
              <rect x="52" y="88" width="24" height="14" rx="3" fill="rgba(0,232,143,.08)"/><text x="56" y="98" fill="var(--green)" font-family="Space Mono" font-size="5">CUT</text>
              <rect x="80" y="88" width="30" height="14" rx="3" fill="var(--surface-tint)"/><text x="84" y="98" fill="var(--accent)" font-family="Space Mono" font-size="5">WELD</text>
              <rect x="114" y="88" width="22" height="14" rx="3" fill="rgba(255,181,71,.08)"/><text x="118" y="98" fill="var(--amber)" font-family="Space Mono" font-size="5">QC</text>
              <rect x="140" y="88" width="30" height="14" rx="3" fill="rgba(0,232,143,.08)"/><text x="144" y="98" fill="var(--green)" font-family="Space Mono" font-size="5">ASSY</text>
              <rect x="174" y="88" width="28" height="14" rx="3" fill="var(--tag-bg)"/><text x="178" y="98" fill="var(--cyan)" font-family="Space Mono" font-size="5">PACK</text>
            </g>
          </svg>
          <div class="pillar-num">2</div>
        </div>
        <div class="pillar-body"><h3>Performance Management</h3><div class="pillar-tag-row"><span class="pillar-tag">Track &amp; Trace</span><span class="pillar-tag">Genealogy</span><span class="pillar-tag">OEE &amp; KPIs</span></div><p>End-to-end track and trace with full product genealogy — from raw material intake through finished goods, with real-time OEE and performance KPIs.</p></div>
        <div class="pillar-accent"></div>
      </div>
      <!-- P3 -->
      <div class="pillar-card">
        <div class="pillar-top">
          <svg viewBox="0 0 280 150" xmlns="http://www.w3.org/2000/svg">
            <rect width="280" height="150" fill="var(--bg-secondary)"/>
            <g transform="translate(30,15)">
              <rect width="220" height="120" rx="8" fill="var(--bg-card-hover)" stroke="var(--border)"/>
              <text x="12" y="18" fill="var(--text-secondary)" font-family="Space Mono" font-size="7" font-weight="600">MAINTENANCE MANAGEMENT</text>
              <rect x="12" y="28" width="96" height="40" rx="5" fill="var(--bg-primary)" stroke="rgba(0,232,143,.2)"/>
              <text x="18" y="42" fill="var(--green)" font-family="Outfit" font-size="7" font-weight="600">Preventive</text>
              <text x="18" y="54" fill="var(--text-muted)" font-family="Space Mono" font-size="5">WO-3291 | CNC-A01</text>
              <text x="18" y="64" fill="var(--text-secondary)" font-family="Space Mono" font-size="5">Due: 2d 4h</text>
              <rect x="114" y="28" width="96" height="40" rx="5" fill="var(--bg-primary)" stroke="rgba(255,181,71,.2)"/>
              <text x="120" y="42" fill="var(--amber)" font-family="Outfit" font-size="7" font-weight="600">Breakdown</text>
              <text x="120" y="54" fill="var(--text-muted)" font-family="Space Mono" font-size="5">WO-3294 | PRESS-B</text>
              <text x="120" y="64" fill="var(--amber)" font-family="Space Mono" font-size="5">⚠ URGENT</text>
              <rect x="12" y="74" width="198" height="36" rx="5" fill="var(--bg-primary)" stroke="var(--border)"/>
              <text x="18" y="88" fill="var(--text-secondary)" font-family="DM Sans" font-size="6">Parts Consumption</text>
              <rect x="18" y="94" width="80" height="6" rx="3" fill="var(--border)"/><rect x="18" y="94" width="52" height="6" rx="3" fill="var(--amber)"/>
              <text x="104" y="100" fill="var(--text-muted)" font-family="Space Mono" font-size="5">Bearings: 65%</text>
            </g>
          </svg>
          <div class="pillar-num">3</div>
        </div>
        <div class="pillar-body"><h3>Automated Maintenance</h3><div class="pillar-tag-row"><span class="pillar-tag">Preventive</span><span class="pillar-tag">Breakdown</span><span class="pillar-tag">Work Orders</span><span class="pillar-tag">Parts</span></div><p>Preventive, breakdown, and performance-based maintenance with automated work orders, parts consumption tracking, and direct machine integration.</p></div>
        <div class="pillar-accent"></div>
      </div>
      <!-- P4 -->
      <div class="pillar-card">
        <div class="pillar-top">
          <svg viewBox="0 0 280 150" xmlns="http://www.w3.org/2000/svg">
            <rect width="280" height="150" fill="var(--bg-secondary)"/>
            <g transform="translate(30,15)">
              <rect width="220" height="120" rx="8" fill="var(--bg-card-hover)" stroke="var(--border)"/>
              <text x="12" y="18" fill="var(--text-secondary)" font-family="Space Mono" font-size="7" font-weight="600">MANUFACTURING BUS</text>
              <rect x="12" y="62" width="196" height="8" rx="4" fill="var(--accent)" opacity=".6"/>
              <text x="80" y="68" fill="#fff" font-family="Space Mono" font-size="5" font-weight="700">ANY ↔ ANY</text>
              <rect x="14" y="28" width="42" height="24" rx="4" fill="var(--bg-primary)" stroke="var(--tag-border)"/><text x="22" y="38" fill="var(--accent)" font-family="Space Mono" font-size="5">ERP</text><text x="22" y="46" fill="var(--text-muted)" font-family="Space Mono" font-size="4">SAP</text><line x1="35" y1="52" x2="35" y2="62" stroke="var(--accent)" opacity=".4"/>
              <rect x="62" y="28" width="42" height="24" rx="4" fill="var(--bg-primary)" stroke="var(--tag-border)"/><text x="70" y="38" fill="var(--accent)" font-family="Space Mono" font-size="5">MES</text><line x1="83" y1="52" x2="83" y2="62" stroke="var(--accent)" opacity=".4"/>
              <rect x="110" y="28" width="42" height="24" rx="4" fill="var(--bg-primary)" stroke="rgba(0,232,143,.15)"/><text x="116" y="38" fill="var(--green)" font-family="Space Mono" font-size="5">QMS</text><line x1="131" y1="52" x2="131" y2="62" stroke="var(--green)" opacity=".4"/>
              <rect x="158" y="28" width="50" height="24" rx="4" fill="var(--bg-primary)" stroke="rgba(255,181,71,.15)"/><text x="164" y="38" fill="var(--amber)" font-family="Space Mono" font-size="5">SCADA</text><line x1="183" y1="52" x2="183" y2="62" stroke="var(--amber)" opacity=".4"/>
              <rect x="14" y="80" width="42" height="24" rx="4" fill="var(--bg-primary)" stroke="rgba(188,26,0,.2)"/><text x="22" y="90" fill="var(--maroon)" font-family="Space Mono" font-size="5">PLC</text><line x1="35" y1="70" x2="35" y2="80" stroke="var(--maroon)" opacity=".4"/>
              <rect x="62" y="80" width="42" height="24" rx="4" fill="var(--bg-primary)" stroke="var(--tag-border)"/><text x="68" y="90" fill="var(--accent)" font-family="Space Mono" font-size="5">IoT</text><line x1="83" y1="70" x2="83" y2="80" stroke="var(--accent)" opacity=".4"/>
              <rect x="110" y="80" width="42" height="24" rx="4" fill="var(--bg-primary)" stroke="var(--tag-border)"/><text x="118" y="90" fill="var(--accent)" font-family="Space Mono" font-size="5">WMS</text><line x1="131" y1="70" x2="131" y2="80" stroke="var(--accent)" opacity=".4"/>
              <rect x="158" y="80" width="50" height="24" rx="4" fill="var(--bg-primary)" stroke="rgba(0,232,143,.15)"/><text x="166" y="90" fill="var(--green)" font-family="Space Mono" font-size="5">LIMS</text><line x1="183" y1="70" x2="183" y2="80" stroke="var(--green)" opacity=".4"/>
            </g>
          </svg>
          <div class="pillar-num">4</div>
        </div>
        <div class="pillar-body"><h3>Manufacturing Bus</h3><div class="pillar-tag-row"><span class="pillar-tag">Any-to-Any</span><span class="pillar-tag">Plant Integration</span><span class="pillar-tag">Edge + Cloud</span></div><p>Universal any-to-any connectivity layer integrating ERP, MES, SCADA, PLCs, IoT, QMS, WMS, and LIMS into a single unified plant data fabric.</p></div>
        <div class="pillar-accent"></div>
      </div>
