<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>IMEX — Manufacturing Intelligence Platform | ITHENA.AI</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
*, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }
html { scroll-behavior:smooth; font-size:16px; }

/* ═══════ ITHENA DUAL THEME ═══════ */
:root {
  --maroon: #bc1a00;
  --maroon-light: #d43a1e;
  --ithena-blue: #0082c8;
  --blue-light: #5eabff;
  --bg-primary: #090d14;
  --bg-secondary: #0e1219;
  --bg-card: #111827;
  --bg-card-hover: #1a2332;
  --text-primary: #f0f2f5;
  --text-secondary: #8a94a6;
  --text-muted: #5a6478;
  --border: #1c2536;
  --accent: #0082c8;
  --accent-light: #5eabff;
  --accent-glow: rgba(0,130,200,.2);
  --maroon-glow: rgba(188,26,0,.18);
  --surface-tint: rgba(0,130,200,.04);
  --tag-bg: rgba(0,130,200,.08);
  --tag-border: rgba(0,130,200,.2);
  --tag-color: #5eabff;
  --pill-bg: rgba(17,24,39,.8);
  --green: #00e88f;
  --amber: #ffb547;
  --cyan: #00d4ff;
  --red: #ff4d4d;
  --toggle-bg: #111827;
  --btt-bg: rgba(17,24,39,.85);
  --btt-border: #1c2536;
  --btt-color: #5a6478;
  --btt-hover-color: #5eabff;
  --btt-hover-border: rgba(0,130,200,.3);
}
body.light {
  --bg-primary: #f5f7fb;
  --bg-secondary: #edf0f7;
  --bg-card: #ffffff;
  --bg-card-hover: #f8f9fc;
  --text-primary: #111827;
  --text-secondary: #4b5563;
  --text-muted: #9ca3af;
  --border: #e2e5ec;
  --accent: #bc1a00;
  --accent-light: #d43a1e;
  --accent-glow: rgba(188,26,0,.1);
  --maroon-glow: rgba(188,26,0,.12);
  --surface-tint: rgba(188,26,0,.03);
  --tag-bg: rgba(188,26,0,.06);
  --tag-border: rgba(188,26,0,.18);
  --tag-color: #bc1a00;
  --pill-bg: #f3f4f6;
  --green: #059669;
  --amber: #d97706;
  --cyan: #0082c8;
  --red: #dc2626;
  --toggle-bg: #e2e5ec;
  --btt-bg: rgba(255,255,255,.9);
  --btt-border: #e2e5ec;
  --btt-color: #9ca3af;
  --btt-hover-color: #bc1a00;
  --btt-hover-border: rgba(188,26,0,.3);
}
body {
  background: var(--bg-primary);
  color: var(--text-primary);
  font-family: 'DM Sans', system-ui, sans-serif;
  line-height: 1.6;
  overflow-x: hidden;
  transition: background .4s ease, color .4s ease;
}

/* ═══ THEME TOGGLE ═══ */
.theme-toggle {
  position: fixed; top: 90px; right: 24px; z-index: 99999;
  display: flex; background: var(--toggle-bg);
  border: 1px solid var(--border);
  border-radius: 10px; padding: 3px;
  box-shadow: 0 4px 20px rgba(0,0,0,.25);
  transition: all .4s ease;
}
.theme-toggle button {
  all: unset; cursor: pointer;
  padding: 6px 14px; border-radius: 8px;
  font-family: 'Space Mono', monospace;
  font-size: 12px; font-weight: 700;
  color: var(--text-muted); transition: all .3s ease;
}
.theme-toggle button.active {
  background: var(--accent); color: #fff;
  box-shadow: 0 2px 10px var(--accent-glow);
}

/* ═══ UTILITY ═══ */
.imex-container { max-width: 1200px; margin: 0 auto; padding: 0 2rem; }
.mono { font-family: 'Space Mono', monospace; }
.tag {
  display: inline-flex; align-items: center; gap: .4rem;
  font-family: 'Space Mono', monospace;
  font-size: .68rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase;
  color: var(--tag-color);
  border: 1px solid var(--tag-border);
  border-radius: 100px; padding: .35rem .9rem;
  background: var(--tag-bg); transition: all .4s ease;
}
.tag::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--tag-color); animation: pulse-dot 2s infinite; }
@keyframes pulse-dot { 0%,100%{opacity:1} 50%{opacity:.3} }

/* ═══ BACK TO TOP ═══ */
.btt-row { display: flex; justify-content: center; padding: 2.25rem 0 0; }
.btt-link {
  display: inline-flex; align-items: center; gap: .45rem;
  font-family: 'Space Mono', monospace;
  font-size: .7rem; font-weight: 400;
  letter-spacing: .06em; text-transform: uppercase;
  text-decoration: none; color: var(--btt-color);
  padding: .4rem 1rem; border-radius: 100px;
  border: 1px solid var(--btt-border);
  background: var(--btt-bg);
  backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
  transition: all .3s ease;
}
.btt-link:hover {
  color: var(--btt-hover-color); border-color: var(--btt-hover-border);
  transform: translateY(-2px); box-shadow: 0 4px 16px var(--accent-glow);
}
.btt-link svg { width: 13px; height: 13px; transition: transform .3s ease; }
.btt-link:hover svg { transform: translateY(-2px); }

/* ═══ BTN ═══ */
.btn {
  display: inline-flex; align-items: center; gap: .5rem;
  padding: .85rem 2rem; border-radius: 8px;
  font-family: 'DM Sans', sans-serif; font-size: .95rem; font-weight: 600;
  text-decoration: none; cursor: pointer; border: none; transition: all .3s ease;
}
.btn-primary { background: var(--accent); color: #fff; box-shadow: 0 4px 24px var(--accent-glow); }
.btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 32px var(--accent-glow); }
.btn-outline { background: transparent; color: var(--text-primary); border: 1px solid var(--border); }
.btn-outline:hover { border-color: var(--accent); background: var(--surface-tint); }
.btn svg { width: 18px; height: 18px; }

/* ═══ HERO ═══ */
.imex-hero { position: relative; padding: 7rem 0 5rem; text-align: center; overflow: hidden; }
.imex-hero::before {
  content: ''; position: absolute; inset: 0;
  background: radial-gradient(ellipse 70% 50% at 50% 0%, var(--maroon-glow), transparent), radial-gradient(ellipse 50% 60% at 80% 20%, var(--accent-glow), transparent);
  pointer-events: none; transition: all .4s ease;
}
.imex-hero-grid {
  position: absolute; inset: 0;
  background-image: linear-gradient(rgba(28,37,54,.3) 1px, transparent 1px), linear-gradient(90deg, rgba(28,37,54,.3) 1px, transparent 1px);
  background-size: 60px 60px;
  mask-image: radial-gradient(ellipse 80% 60% at 50% 30%, black, transparent);
  -webkit-mask-image: radial-gradient(ellipse 80% 60% at 50% 30%, black, transparent);
  transition: opacity .4s ease;
}
body.light .imex-hero-grid { opacity: .25; }
.imex-hero .imex-container { position: relative; z-index: 1; }
.imex-hero h1 { font-family: 'Outfit', sans-serif; font-size: clamp(2.8rem, 6vw, 4.6rem); font-weight: 800; line-height: 1.08; letter-spacing: -.03em; margin-bottom: 1.5rem; }
.imex-hero h1 span { background: linear-gradient(135deg, var(--maroon), var(--accent)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
.hero-sub { font-size: 1.15rem; color: var(--text-secondary); max-width: 640px; margin: 0 auto 2.5rem; line-height: 1.7; }
.hero-actions { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; margin-bottom: 3.5rem; }
.hero-visual { position: relative; max-width: 960px; margin: 0 auto; border-radius: 16px; overflow: hidden; border: 1px solid var(--border); box-shadow: 0 40px 80px rgba(0,0,0,.4); transition: all .4s ease; }
body.light .hero-visual { box-shadow: 0 20px 60px rgba(0,0,0,.08); }
.hero-visual::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 70%, var(--bg-primary)); pointer-events: none; transition: all .4s ease; }

/* ═══ STATS ═══ */
.stats-bar { padding: 3rem 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); background: var(--bg-secondary); transition: all .4s ease; }
.stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem; text-align: center; }
.stat-num { font-family: 'Outfit', sans-serif; font-size: 2.6rem; font-weight: 800; background: linear-gradient(135deg, var(--accent), var(--accent-light)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
.stat-label { font-size: .85rem; color: var(--text-secondary); margin-top: .25rem; }

/* ═══ PILLARS ═══ */
.pillars-section { padding: 6rem 0; position: relative; overflow: hidden; }
.pillars-section::before { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse 50% 60% at 30% 50%, var(--maroon-glow), transparent), radial-gradient(ellipse 50% 60% at 70% 50%, var(--accent-glow), transparent); pointer-events: none; }
.pillars-header { text-align: center; margin-bottom: 3.5rem; position: relative; z-index: 1; }
.pillars-header h2 { font-family: 'Outfit', sans-serif; font-size: clamp(2rem, 3.5vw, 2.8rem); font-weight: 800; letter-spacing: -.02em; margin-bottom: .75rem; }
.pillars-header h2 span { background: linear-gradient(135deg, var(--maroon), var(--accent)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
.pillars-header p { color: var(--text-secondary); font-size: 1.05rem; max-width: 600px; margin: 0 auto; }
.pillars-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.25rem; position: relative; z-index: 1; }
.pillar-card { position: relative; border-radius: 16px; background: var(--bg-card); border: 1px solid var(--border); overflow: hidden; transition: all .4s cubic-bezier(.22,1,.36,1); }
.pillar-card:hover { transform: translateY(-6px); border-color: rgba(188,26,0,.35); box-shadow: 0 24px 64px rgba(0,0,0,.3); }
body.light .pillar-card:hover { box-shadow: 0 16px 48px rgba(0,0,0,.08); }
.pillar-top { position: relative; height: 150px; overflow: hidden; display: flex; align-items: center; justify-content: center; }
.pillar-top svg { width: 100%; height: 100%; }
.pillar-num { position: absolute; top: 12px; left: 14px; width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-family: 'Space Mono', monospace; font-size: .75rem; font-weight: 700; color: #fff; background: linear-gradient(135deg, var(--maroon), var(--accent)); z-index: 2; }
.pillar-body { padding: 1.5rem 1.4rem 1.75rem; }
.pillar-body h3 { font-family: 'Outfit', sans-serif; font-size: 1.05rem; font-weight: 700; margin-bottom: .6rem; }
.pillar-tag-row { display: flex; flex-wrap: wrap; gap: .4rem; margin-bottom: .7rem; }
.pillar-tag { font-family: 'Space Mono', monospace; font-size: .64rem; font-weight: 500; padding: .22rem .6rem; border-radius: 100px; border: 1px solid var(--border); color: var(--text-muted); background: var(--pill-bg); transition: all .3s ease; }
.pillar-card:hover .pillar-tag { border-color: var(--tag-border); color: var(--text-secondary); }
.pillar-body p { font-size: .82rem; color: var(--text-secondary); line-height: 1.6; }
.pillar-accent { position: absolute; bottom: 0; left: 0; right: 0; height: 3px; opacity: 0; transition: opacity .3s; }
.pillar-card:hover .pillar-accent { opacity: 1; }
.pillar-card:nth-child(1) .pillar-accent { background: linear-gradient(90deg, var(--cyan), var(--accent)); }
.pillar-card:nth-child(2) .pillar-accent { background: linear-gradient(90deg, var(--maroon), var(--maroon-light)); }
.pillar-card:nth-child(3) .pillar-accent { background: linear-gradient(90deg, var(--amber), var(--green)); }
.pillar-card:nth-child(4) .pillar-accent { background: linear-gradient(90deg, var(--accent), var(--cyan)); }

/* ═══ PERF WRAPPER ═══ */
.perf-wrapper-header { text-align: center; padding: 5rem 0 1rem; position: relative; }
.perf-wrapper-header::before { content: ''; position: absolute; left: 50%; top: 0; width: 1px; height: 3rem; background: linear-gradient(180deg, transparent, var(--maroon)); }
.perf-wrapper-header h2 { font-family: 'Outfit', sans-serif; font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 800; letter-spacing: -.02em; margin-bottom: .5rem; }
.perf-wrapper-header p { color: var(--text-secondary); font-size: 1rem; max-width: 520px; margin: 0 auto; }
.perf-badge { display: inline-flex; align-items: center; gap: .4rem; font-family: 'Space Mono', monospace; font-size: .65rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--maroon); border: 1px solid rgba(188,26,0,.2); border-radius: 100px; padding: .3rem .85rem; background: rgba(188,26,0,.06); margin-bottom: 1rem; }
.perf-badge::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--maroon); }

/* ═══ FEATURES ═══ */
.feature-section { padding: 6rem 0; transition: background .4s ease; }
.feature-section:nth-child(even) { background: var(--bg-secondary); }
.feature-row { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center; }
.feature-row.reverse .feature-content { order: 2; }
.feature-row.reverse .feature-media { order: 1; }
.feature-label { display: inline-block; font-family: 'Space Mono', monospace; font-size: .7rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--maroon); margin-bottom: .75rem; }
.feature-title { font-family: 'Outfit', sans-serif; font-size: clamp(1.8rem, 3vw, 2.4rem); font-weight: 800; line-height: 1.15; letter-spacing: -.02em; margin-bottom: 1rem; }
.feature-desc { color: var(--text-secondary); font-size: 1.05rem; line-height: 1.75; margin-bottom: 1.75rem; }
.feature-pills { display: flex; flex-wrap: wrap; gap: .6rem; margin-bottom: 1.5rem; }
.pill { font-family: 'Space Mono', monospace; font-size: .74rem; font-weight: 500; padding: .4rem .9rem; border-radius: 100px; background: var(--pill-bg); border: 1px solid var(--border); color: var(--text-secondary); transition: all .3s ease; }
.pill:hover { border-color: var(--accent); color: var(--text-primary); background: var(--surface-tint); }
.feature-media { position: relative; border-radius: 14px; overflow: hidden; border: 1px solid var(--border); background: var(--bg-card); transition: all .4s ease; }
.feature-media::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: linear-gradient(90deg, var(--maroon), var(--accent)); z-index: 2; }
.sub-features { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 1.5rem; }
.sub-feat { display: flex; gap: .65rem; align-items: flex-start; padding: .75rem; border-radius: 10px; background: var(--surface-tint); border: 1px solid transparent; transition: all .3s ease; }
.sub-feat:hover { border-color: var(--border); background: var(--bg-card); }
.sub-feat-icon { flex-shrink: 0; width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: .9rem; }
.sub-feat h4 { font-family: 'Outfit', sans-serif; font-size: .82rem; font-weight: 600; margin-bottom: .15rem; }
.sub-feat p { font-size: .75rem; color: var(--text-muted); line-height: 1.45; }

/* ═══ CAPABILITIES ═══ */
.cap-section { padding: 6rem 0; text-align: center; }
.section-title { font-family: 'Outfit', sans-serif; font-size: clamp(2rem, 3.5vw, 2.8rem); font-weight: 800; letter-spacing: -.02em; margin-bottom: .75rem; }
.section-sub { color: var(--text-secondary); font-size: 1.05rem; max-width: 560px; margin: 0 auto 3.5rem; }
.cap-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
.cap-card { text-align: left; padding: 1.75rem; border-radius: 14px; background: var(--bg-card); border: 1px solid var(--border); transition: all .35s ease; position: relative; overflow: hidden; }
.cap-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; background: linear-gradient(90deg, var(--maroon), var(--accent)); opacity: 0; transition: opacity .3s; }
.cap-card:hover { border-color: rgba(188,26,0,.25); transform: translateY(-4px); box-shadow: 0 16px 48px rgba(0,0,0,.2); }
body.light .cap-card:hover { box-shadow: 0 12px 36px rgba(0,0,0,.06); }
.cap-card:hover::before { opacity: 1; }
.cap-icon { width: 44px; height: 44px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; margin-bottom: 1rem; }
.cap-card h3 { font-family: 'Outfit', sans-serif; font-size: 1.05rem; font-weight: 600; margin-bottom: .5rem; }
.cap-card p { font-size: .88rem; color: var(--text-secondary); line-height: 1.6; }

/* ═══ WORKFLOW ═══ */
.workflow-section { padding: 6rem 0; background: var(--bg-secondary); transition: background .4s ease; }
.workflow-steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; margin-top: 3rem; }
.wf-step { position: relative; padding: 2rem 1.5rem; border-radius: 14px; background: var(--bg-card); border: 1px solid var(--border); text-align: center; transition: all .35s ease; }
.wf-step:hover { border-color: var(--maroon); box-shadow: 0 12px 40px rgba(0,0,0,.2); }
body.light .wf-step:hover { box-shadow: 0 8px 28px rgba(0,0,0,.06); }
.wf-num { display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 50%; background: linear-gradient(135deg, var(--maroon), var(--accent)); color: #fff; font-family: 'Outfit', sans-serif; font-weight: 700; font-size: .85rem; margin-bottom: 1rem; }
.wf-step h4 { font-family: 'Outfit', sans-serif; font-size: 1rem; font-weight: 600; margin-bottom: .5rem; }
.wf-step p { font-size: .82rem; color: var(--text-secondary); line-height: 1.55; }

/* ═══ INTEGRATIONS ═══ */
.integrations { padding: 5rem 0; text-align: center; }
.logo-ticker { display: flex; gap: 2.5rem; align-items: center; justify-content: center; flex-wrap: wrap; opacity: .6; }
.logo-ticker span { font-family: 'DM Sans', sans-serif; font-size: 1.1rem; font-weight: 600; color: var(--text-secondary); padding: .6rem 1.2rem; border: 1px solid var(--border); border-radius: 8px; background: var(--bg-card); transition: all .3s ease; }
.logo-ticker span:hover { opacity: 1; border-color: var(--accent); color: var(--text-primary); }

/* ═══ CTA ═══ */
.cta-section { padding: 6rem 0; text-align: center; position: relative; }
.cta-section::before { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse 60% 80% at 50% 100%, var(--maroon-glow), transparent), radial-gradient(ellipse 40% 60% at 20% 60%, var(--accent-glow), transparent); pointer-events: none; }
.cta-box { position: relative; z-index: 1; max-width: 700px; margin: 0 auto; padding: 3.5rem; border-radius: 20px; background: var(--bg-card); border: 1px solid var(--border); box-shadow: 0 32px 64px rgba(0,0,0,.3); transition: all .4s ease; }
body.light .cta-box { box-shadow: 0 16px 48px rgba(0,0,0,.06); }
.cta-box h2 { font-family: 'Outfit', sans-serif; font-size: 2rem; font-weight: 800; margin-bottom: .75rem; letter-spacing: -.02em; }
.cta-box p { color: var(--text-secondary); margin-bottom: 2rem; font-size: 1.05rem; }

/* ═══ RESPONSIVE ═══ */
@media (max-width: 900px) {
  .feature-row { display: flex; flex-direction: column; gap: 2.5rem; }
  .feature-row.reverse .feature-content, .feature-row.reverse .feature-media { order: unset !important; }
  .cap-grid, .pillars-grid { grid-template-columns: 1fr 1fr; }
  .workflow-steps, .stats-grid { grid-template-columns: 1fr 1fr; }
  .sub-features { grid-template-columns: 1fr; }
}
@media (max-width: 600px) {
  .cap-grid, .workflow-steps, .stats-grid, .pillars-grid { grid-template-columns: 1fr; }
  .imex-hero { padding: 5rem 0 3rem; }
  .imex-container { padding: 0 1.25rem; }
  .theme-toggle { top: 70px; right: 12px; }
}

@keyframes fadeUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: none; } }
.anim { opacity: 0; animation: fadeUp .7s ease forwards; }
.anim-d1 { animation-delay: .1s; } .anim-d2 { animation-delay: .2s; } .anim-d3 { animation-delay: .3s; } .anim-d4 { animation-delay: .4s; }
</style>
</head>
<body id="top">

<!-- ═══════ HERO ═══════ -->
<section class="imex-hero">
  <div class="imex-hero-grid"></div>
  <div class="imex-container">
<!-- THEME TOGGLE -->


    <div style="margin-bottom:1.5rem" class="anim"><span class="tag">ITHENA Manufacturing Intelligence</span></div>

<div class="theme-toggle">
  <button id="darkBtn" class="active" onclick="setTheme('dark')">DARK</button>
  <button id="lightBtn" onclick="setTheme('light')">LIGHT</button>
</div>

    <h1 class="anim anim-d1">The Intelligence Layer<br>for <span>Modern Manufacturing</span></h1>
    <p class="hero-sub anim anim-d2">IMEX connects your machines, sensors, and workforce into a unified intelligence platform — turning raw operational data into real-time insights, predictive actions, and measurable outcomes.</p>
    <div class="hero-actions anim anim-d3">
      <a href="https://ithena.aicontact-us" class="btn btn-primary">Request a Demo <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
      <a href="#capabilities" class="btn btn-outline">Explore Platform</a>
    </div>
    <div class="hero-visual anim anim-d4">
      <svg viewBox="0 0 960 520" xmlns="http://www.w3.org/2000/svg" style="width:100%;display:block">
        <rect width="960" height="520" fill="var(--bg-secondary)"/>
        <rect x="0" y="0" width="960" height="44" fill="var(--bg-card)"/>
