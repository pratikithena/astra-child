.is .dcard .ph.vis{background:none;overflow:hidden;display:block}
.is .dcard .ph.vis .pvis{display:block;width:100%;height:100%}
.is .dcard .pvis .sh{filter:drop-shadow(0 4px 10px rgba(6,42,68,.10))}
.is .dcard .pvis .flow{animation:pvflow 3.2s linear infinite}
.is .dcard .pvis .pulse{transform-box:fill-box;transform-origin:center;animation:pvpulse 2.4s ease-in-out infinite}
.is .dcard .pvis .spin{transform-box:fill-box;transform-origin:center;animation:pvspin 14s linear infinite}
.is .dcard .pvis .halo{transform-box:fill-box;transform-origin:center;animation:pvhalo 2.6s ease-out infinite}
.is .dcard .pvis .ring{animation:pvring 1.8s ease-out infinite;animation-delay:var(--d,0s)}
.is .dcard .pvis .badge{transform-box:fill-box;transform-origin:center;animation:pvbadge 3s ease-in-out infinite}
.is .dcard .pvis .sway{transform-box:fill-box;transform-origin:top left;animation:pvsway 5s ease-in-out infinite}
.is .dcard .pvis .tick{transform-box:fill-box;transform-origin:center;animation:pvpulse 1.6s ease-in-out infinite}
.is .dcard .pvis .truck{animation:pvbob 2.2s ease-in-out infinite}
.is .dcard .pvis .pop{opacity:0;transform:translateY(8px) scale(.96);transform-box:fill-box;transform-origin:center;transition:opacity .6s ease,transform .6s cubic-bezier(.2,.8,.2,1);transition-delay:var(--d,0s)}
.is .dcard .pvis .bar{transform-box:fill-box;transform-origin:bottom;transform:scaleY(0);transition:transform .9s cubic-bezier(.2,.8,.2,1);transition-delay:var(--d,0s)}
.is .dcard .pvis .draw{stroke-dasharray:1;stroke-dashoffset:1;transition:stroke-dashoffset 1.2s ease-out .2s}
.is .dcard .pvis .draw.late{transition-delay:.8s}
.is .in .pvis .pop{opacity:1;transform:none}
.is .in .pvis .bar{transform:scaleY(1)}
.is .in .pvis .draw{stroke-dashoffset:0}
@keyframes pvflow{to{stroke-dashoffset:-18}}
@keyframes pvpulse{0%,100%{transform:scale(1);opacity:1}50%{transform:scale(1.12);opacity:.75}}
@keyframes pvspin{to{transform:rotate(360deg)}}
@keyframes pvhalo{0%{transform:scale(1);opacity:.6}100%{transform:scale(1.7);opacity:0}}
@keyframes pvring{0%{opacity:0}30%{opacity:.9}100%{opacity:0}}
@keyframes pvbadge{0%,80%,100%{transform:scale(1)}88%{transform:scale(1.25)}}
@keyframes pvsway{0%,100%{transform:rotate(0)}50%{transform:rotate(2.5deg)}}
@keyframes pvbob{0%,100%{transform:translateY(0)}50%{transform:translateY(-3px)}}
