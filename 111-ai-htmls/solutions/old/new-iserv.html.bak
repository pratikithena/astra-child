<link href="https://fonts.googleapis.com/css2?family=Noto+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">
<style>
.is *,.is *::before,.is *::after{box-sizing:border-box}.is{
  --bg:#FAFAFA;--white:#FFFFFF;
  --ink:#1F2023;--ink-2:rgba(0,0,0,.70);--ink-3:#797979;--ink-4:#A2A2A2;
  --line:#EAEAEA;--line-2:#F4F4F4;
  --blue:#0083C8;--blue-deep:#006AA3;--blue-2:#33A1E0;--blue-3:#7FC8F2;
  --wash:#EAF5FB;--wash-2:#D7ECF6;
  --navy:#0D1B2E;--deep:#062A44;--line-d:rgba(255,255,255,.12);
  --w-2:rgba(255,255,255,.72);--w-3:rgba(255,255,255,.55);
  --grn:#1EA672;--amb:#E8A33D;--red:#D9534F;
  --r:12px;--r2:16px;--r3:24px;--pad:clamp(16px,4vw,48px);--max:1344px;
  font-family:"Noto Sans",-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
  background:var(--bg);color:var(--ink);font-size:16px;line-height:1.6;
}.is img{display:block;max-width:100%}.is a{color:inherit;text-decoration:none}.is .i{width:1em;height:1em;flex:none}.is .wrap{max-width:var(--max);margin:0 auto;padding:0 var(--pad)}.is h1,.is h2,.is h3,.is h4{font-weight:800;letter-spacing:-.02em;line-height:1.1;color:var(--ink);text-wrap:balance}.is h1{font-size:clamp(34px,3.9vw,54px);line-height:1.08;text-wrap:pretty}.is h2{font-size:clamp(30px,3.4vw,44px)}.is h3{font-size:18px;font-weight:700;letter-spacing:0;line-height:1.3}.is .lede{font-size:17px;color:var(--ink-2);line-height:1.6;max-width:62ch;text-wrap:pretty}.is .grad,.is .hl{color:var(--blue)}.is .eb{display:flex;align-items:center;gap:10px;font-size:12px;font-weight:700;
  letter-spacing:.16em;text-transform:uppercase;color:var(--blue)}.is .btn{display:inline-flex;align-items:center;gap:8px;border-radius:100px;font-weight:600;font-size:14px;
  line-height:1;padding:14px 18px 14px 22px;transition:transform .18s,background .18s,box-shadow .18s,color .18s}.is .btn .i{width:16px;height:16px}.is .btn.pri{background:var(--blue);color:#fff}.is .btn.pri:hover{background:var(--blue-deep)}.is .btn.ghost{background:rgba(0,0,0,.07);color:var(--ink)}.is .btn.ghost:hover{background:rgba(0,0,0,.11)}.is .btn:hover .arw{transform:translateX(3px)}.is .arw{display:inline-flex;transition:transform .18s}.is .btns{display:flex;gap:10px;flex-wrap:wrap;margin-top:28px}.is section{position:relative}.is .sec{padding:clamp(58px,7vw,104px) 0}.is .lt{background:var(--white);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.is .dk{background:var(--navy);color:#fff}.is .dk h2,.is .dk h3{color:#fff}.is .dk .lede{color:var(--w-2)}.is .dk .eb{color:var(--blue-3)}.is .dk .grad,.is .dk .hl{color:var(--blue-3)}.is .dk .btn.ghost{background:rgba(255,255,255,.14);color:#fff}.is .dk .btn.ghost:hover{background:rgba(255,255,255,.22)}.is .head{max-width:820px;margin-bottom:clamp(30px,3.6vw,48px)}.is .head h2{margin:14px 0 14px}.is .head.ctr{max-width:760px;margin-left:auto;margin-right:auto;text-align:center}.is .head.ctr .eb{justify-content:center}.is .head.ctr .lede{margin:0 auto}.is .hero{position:relative;padding:clamp(64px,7vw,104px) 0 0;overflow:hidden;background:var(--bg)}.is .mesh{position:absolute;inset:-20% -10% auto -10%;height:80%;pointer-events:none;
  background:radial-gradient(60% 60% at 20% 20%,rgba(0,131,200,.16),transparent 60%),
             radial-gradient(40% 50% at 85% 10%,rgba(51,161,224,.14),transparent 60%);
  filter:blur(40px)}.is .final .mesh{display:none}.is .hero .wrap{position:relative}.is .hgrid{display:grid;grid-template-columns:minmax(0,1.02fr) minmax(0,.98fr);gap:clamp(26px,3.4vw,56px);align-items:center}.is .hero h1{margin:16px 0 18px}.is .hero h1 .grad{white-space:nowrap}.is .hero .lede{font-size:18px;max-width:52ch}.is .hero .lede+.lede{margin-top:12px;font-size:16.5px;color:var(--ink-3)}.is .hkeys{display:flex;flex-wrap:wrap;gap:8px;margin-top:24px}.is .hkeys span{font-size:13px;font-weight:600;color:var(--ink-2);border:1px solid var(--line);
  border-radius:100px;padding:7px 14px;background:#fff}.is .hstage .ui{transform:rotateY(-7deg) rotateX(3deg);transform-origin:center;
  transition:transform .7s cubic-bezier(.2,.7,.2,1)}.is .hstage:hover .ui{transform:rotateY(-3deg) rotateX(1deg)}.is .hfloat{position:absolute;z-index:3;background:#fff;border:1px solid var(--line);border-radius:12px;
  padding:11px 16px;box-shadow:0 18px 40px -14px rgba(0,40,70,.28);animation:bob 7s ease-in-out infinite}.is .hfloat b{display:block;font-size:20px;font-weight:800;letter-spacing:-.03em;color:var(--ink)}.is .hfloat span{font-size:11.5px;color:var(--ink-3)}.is .hfloat.a{left:-34px;top:22%}.is .hfloat.b{right:-14px;bottom:-48px;animation-delay:1.6s}@keyframes bob{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}.is .panel{position:relative;border-radius:24px;padding:clamp(16px,2.2vw,30px);overflow:hidden;
  background:linear-gradient(36deg,#0083C8 0%,#33A1E0 30%,#9AD4F1 58%,#DCEEF9 82%,#F4FAFD 100%)}.is .panel::before{content:"";position:absolute;inset:0;pointer-events:none;
  background:radial-gradient(70% 60% at 90% 0%,rgba(255,255,255,.55),transparent 70%)}.is .glass{position:relative;border:1.2px solid rgba(255,255,255,.85);border-radius:18px;padding:5px;
  background:rgba(255,255,255,.26);backdrop-filter:blur(3px);
  box-shadow:inset -1.3px -2.6px 2.6px rgba(0,0,0,.04),inset 1.3px 2.6px 5.1px rgba(255,255,255,.72)}.is .glass .ui{border-radius:13px;box-shadow:0 26px 54px -30px rgba(0,40,70,.55)}.is .hstage .panel{background:linear-gradient(36deg,#0083C8 0%,#33A1E0 34%,#BFE5F8 72%,#EAF5FB 100%)}.is .dk .panel{background:linear-gradient(36deg,#062A44 0%,#0083C8 44%,#7FC8F2 82%,#DCEEF9 100%)}.is .hvis{position:relative;aspect-ratio:640/520;width:100%;max-width:640px;justify-self:end}.is .bp{width:100%;height:100%;display:block;overflow:visible}.is .gridl line{stroke:#0083C8;stroke-opacity:.07;stroke-width:1}.is .enc .dr{fill:none;stroke:#0083C8;stroke-width:1.4;stroke-linecap:round;stroke-linejoin:round;stroke-opacity:.85}.is .enc .face{fill:url(#hg)}.is .enc .door{stroke:#33A1E0}.is .enc .wire{stroke:#D98523;stroke-width:1.3;stroke-opacity:.8}.is .dr{stroke-dasharray:1;stroke-dashoffset:1;animation:draw 1.4s cubic-bezier(.4,0,.2,1) forwards;animation-delay:var(--d,0s)}@keyframes draw{to{stroke-dashoffset:0}}.is .node .core{fill:#0083C8;stroke:#fff;stroke-width:2.5;opacity:0;animation:nodein .5s ease-out forwards}.is .node .ring{fill:none;stroke:#0083C8;stroke-width:1.5;opacity:0;transform-origin:center;transform-box:fill-box;animation:pulse 2.4s ease-out infinite}.is .n1 .core{animation-delay:2.2s}.is .n1 .ring{animation-delay:2.4s}.is .n2 .core{animation-delay:2.5s}.is .n2 .ring{animation-delay:2.7s}.is .n3 .core{animation-delay:2.8s}.is .n3 .ring{animation-delay:3.0s}.is .n2 .core,.is .n2 .ring{stroke:#D98523}.is .n2 .core{fill:#D98523;stroke:#fff}.is .n3 .core{fill:#1EA672}.is .n3 .ring{stroke:#1EA672}@keyframes nodein{from{opacity:0;transform:scale(.4)}to{opacity:1;transform:none}}@keyframes pulse{0%{opacity:.7;transform:scale(.6)}70%,100%{opacity:0;transform:scale(3)}}.is .lead{stroke:#1F2023;stroke-opacity:.25;stroke-width:1;stroke-dasharray:1;stroke-dashoffset:1;
  animation:draw .8s ease-out forwards}.is .l1{animation-delay:2.5s}.is .l2{animation-delay:2.8s}.is .l3{animation-delay:3.1s}.is .hflow{fill:none;stroke:#0083C8;stroke-opacity:.55;stroke-width:1.4;stroke-dasharray:5 6;opacity:0;
  animation:hfin .5s ease forwards,hfrun 2.4s linear infinite}.is .hflow.a{animation-delay:2.1s,2.6s}@keyframes hfin{to{opacity:1}}@keyframes hfrun{to{stroke-dashoffset:-22}}.is .chip{position:absolute;display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,.92);
  backdrop-filter:blur(8px);border:1px solid var(--line);border-radius:100px;padding:8px 14px 8px 10px;
  font-size:13px;font-weight:500;color:var(--ink);box-shadow:0 10px 30px -12px rgba(0,40,70,.3);opacity:0;
  animation:chipin .6s cubic-bezier(.34,1.4,.5,1) forwards,float 6s ease-in-out infinite;white-space:nowrap}.is .chip .i{width:16px;height:16px;color:var(--blue)}.is .chip b{font-weight:700;color:var(--blue);margin-left:2px}.is .chip b.ok{color:#177A54}.is .chip span small{display:block;font-size:10.5px;color:var(--ink-3);line-height:1.1}.is .c0{left:6%;top:8%;border-radius:18px;padding:8px 16px 8px 8px;font-size:15px;font-weight:700;animation-delay:2.9s,3.5s}.is .c1{left:4%;top:40%;animation-delay:3.1s,4s}.is .c2{right:2%;top:50%;animation-delay:3.3s,5s}.is .c3{right:6%;bottom:4%;animation-delay:3.5s,4.5s}.is .gauge{position:relative;width:40px;height:40px;display:grid;place-items:center}.is .gauge svg{position:absolute;inset:0;transform:rotate(-90deg)}.is .gauge .gb{fill:none;stroke:var(--line);stroke-width:4}.is .gauge .gf{fill:none;stroke:#1EA672;stroke-width:4;stroke-linecap:round;stroke-dasharray:94.2;
  stroke-dashoffset:94.2;animation:gfill 1.4s ease-out 3.2s forwards}@keyframes gfill{to{stroke-dashoffset:7.5}}.is .gauge b{font-size:13px;color:#177A54;margin:0}@keyframes chipin{from{opacity:0;transform:translateY(10px) scale(.92)}to{opacity:1;transform:none}}@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}.is .mq{border-top:1px solid var(--line);border-bottom:1px solid var(--line);overflow:hidden;
  padding:16px 0;background:var(--white);margin-top:clamp(40px,5vw,72px);
  -webkit-mask-image:linear-gradient(90deg,transparent,#000 7%,#000 93%,transparent);
  mask-image:linear-gradient(90deg,transparent,#000 7%,#000 93%,transparent)}.is .mq ul{display:flex;gap:52px;width:max-content;animation:run 34s linear infinite;list-style:none}.is .mq li{display:flex;align-items:center;gap:52px;font-size:15px;font-weight:700;letter-spacing:-.01em;
  color:var(--ink-2);white-space:nowrap}.is .mq li::after{content:"";width:6px;height:6px;border-radius:50%;background:var(--blue);opacity:.55}@keyframes run{to{transform:translateX(-50%)}}.is .trust{border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:var(--bg)}.is .trust .row{display:flex;align-items:stretch;height:123px;gap:0}.is .tcell{display:flex;align-items:center;gap:14px;padding:0 28px;flex:none;min-width:280px;
  border-left:1px solid var(--line);border-right:1px solid var(--line)}.is .tcell p{font-size:14px;line-height:1.5;color:var(--ink);font-weight:600}.is .tcell .tlab{font-size:11px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;
  color:var(--blue);margin-bottom:7px}.is .ticker{flex:1;overflow:hidden;display:flex;align-items:center;border-right:1px solid var(--line);
  -webkit-mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent);
  mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent)}.is .ticker ul{list-style:none;display:flex;align-items:center;gap:72px;padding-left:72px;
  width:max-content;animation:run 40s linear infinite}.is .ticker li{flex:none}.is .ticker li img{height:60px;width:auto;max-width:none}.is .nums{display:grid;grid-template-columns:repeat(5,1fr);border:1px solid var(--line);
  border-radius:var(--r2);overflow:hidden;background:#fff}.is .nums div{position:relative;padding:clamp(22px,2.6vw,34px) 18px;text-align:center;
  border-right:1px solid var(--line);transition:background-color .35s}.is .nums div:last-child{border-right:0}.is .nums div::before{content:"";position:absolute;left:0;right:0;top:0;height:3px;
  background:linear-gradient(90deg,var(--blue),var(--blue-2));transform:scaleX(0);
  transition:transform .4s cubic-bezier(.2,.8,.2,1)}.is .nums div:hover{background:var(--wash)}.is .nums div:hover::before{transform:scaleX(1)}.is .nums b{display:block;font-size:clamp(30px,3.2vw,44px);font-weight:800;letter-spacing:-.03em;
  line-height:1;color:var(--blue);font-variant-numeric:tabular-nums;
  transition:transform .35s cubic-bezier(.34,1.4,.5,1),color .35s}.is .nums div:hover b{transform:translateY(-3px) scale(1.04);color:var(--blue-deep)}.is .nums span{display:block;margin-top:9px;font-size:14px;color:var(--ink-2);line-height:1.4;
  transition:color .35s}.is .nums div:hover span{color:var(--ink)}.is .bento{display:grid;grid-template-columns:repeat(6,1fr);gap:14px}.is .bc{background:#fff;border:1px solid var(--line);border-radius:var(--r2);padding:26px;
  position:relative;overflow:hidden;transition:box-shadow .3s,transform .3s,border-color .3s}.is .bc::after{content:"";position:absolute;left:0;right:0;top:0;height:2px;background:var(--blue);
  transform:scaleX(0);transform-origin:left;transition:transform .35s ease}.is .bc:hover{transform:translateY(-3px);box-shadow:0 22px 46px -28px rgba(6,42,68,.42);border-color:#DCE6ED}.is .bc:hover::after{transform:scaleX(1)}.is .bc h3{margin:16px 0 8px}.is .bc p{font-size:14.5px;color:var(--ink-2);line-height:1.55}.is .bc .ic{width:38px;height:38px;border-radius:10px;display:grid;place-items:center;
  background:var(--wash);color:var(--blue);transition:transform .35s cubic-bezier(.34,1.56,.64,1),background-color .3s,color .3s}.is .bc:hover .ic{transform:translateY(-3px) scale(1.06);background:var(--blue);color:#fff}.is .bc .ic .i{width:19px;height:19px}.is .dk .bc{background:rgba(255,255,255,.05);border-color:var(--line-d)}.is .dk .bc p{color:var(--w-2)}.is .dk .bc .ic{background:rgba(0,131,200,.22);color:var(--blue-3)}.is .tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:16px}.is .tags i{font-style:normal;font-size:11.5px;font-weight:600;color:var(--ink-2);
  background:var(--line-2);border-radius:100px;padding:5px 10px;transition:background-color .3s,color .3s}.is .bc:hover .tags i,.is .lstep:hover .tags i{background:var(--wash);color:var(--blue-deep)}.is .dk .tags i{background:rgba(255,255,255,.08);color:var(--w-2)}.is .s2{grid-column:span 2}.is .s3{grid-column:span 3}.is .s4{grid-column:span 4}.is .s6{grid-column:span 6}.is .mods{border-top:1px solid var(--line)}.is .mrow{display:grid;
  grid-template-columns:minmax(0,clamp(240px,29vw,380px)) minmax(0,1fr);
  gap:clamp(20px,3vw,48px);align-items:center;
  
  padding:clamp(16px,1.8vw,26px) 0;
  border-bottom:1px solid var(--line)}.is .mrow:nth-child(even){grid-template-columns:minmax(0,1fr) minmax(0,clamp(240px,29vw,380px))}.is .mrow:nth-child(even) .mfig{grid-area:1/2}.is .mrow:nth-child(even) .mtx{grid-area:1/1}.is .mfig{margin:0;overflow:hidden;border-radius:12px;aspect-ratio:4/3}.is .mfig img{display:block;width:100%;height:100%;object-fit:contain;mix-blend-mode:multiply}.is .mrow:nth-child(odd) .mfig img{object-position:left center}.is .mrow:nth-child(even) .mfig img{object-position:right center}.is .mno{display:flex;align-items:center;gap:12px;margin-bottom:13px}.is .mno b{font-size:12px;font-weight:800;letter-spacing:.14em;color:var(--ink-4)}.is .mno .ic{width:38px;height:38px;border-radius:10px;display:grid;place-items:center;flex:none;
  background:var(--wash);color:var(--blue)}.is .mno .ic .i{width:19px;height:19px}.is .mtx h3{font-size:20px;letter-spacing:-.01em;margin-bottom:7px}.is .mtx p{font-size:14.5px;color:var(--ink-2);line-height:1.55;max-width:52ch}.is .mrow .tags{margin-top:14px;justify-content:flex-start}.is .agrid{display:grid;grid-template-columns:minmax(0,1.02fr) minmax(0,.98fr);
  gap:clamp(26px,3.4vw,52px);align-items:start}.is .asticky{position:sticky;top:24px}.is .afeat{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid var(--line)}.is .afeat article{padding:22px 26px 24px;border-bottom:1px solid var(--line)}.is .afeat article:nth-child(odd){border-right:1px solid var(--line);padding-left:0}.is .afeat .ic{width:36px;height:36px;border-radius:10px;display:grid;place-items:center;
  background:var(--wash);color:var(--blue);margin-bottom:14px;
  transition:transform .35s cubic-bezier(.34,1.56,.64,1),background-color .3s,color .3s}.is .afeat article:hover .ic{transform:translateY(-3px) scale(1.06);background:var(--blue);color:#fff}.is .afeat .ic .i{width:18px;height:18px}.is .afeat h3{margin-bottom:7px;font-size:clamp(15.5px,1.25vw,17.5px)}.is .afeat p{font-size:14.5px;color:var(--ink-2);line-height:1.55}.is .cols3{display:grid;grid-template-columns:repeat(3,1fr);margin-top:clamp(24px,3vw,40px);
  border-top:1px solid var(--line)}.is .cols3 article{padding:26px 26px 4px;border-right:1px solid var(--line)}.is .cols3 article:first-child{padding-left:0}.is .cols3 article:last-child{border-right:0;padding-right:0}.is .cols3 .ic{width:38px;height:38px;border-radius:10px;display:grid;place-items:center;
  background:var(--wash);color:var(--blue);margin-bottom:15px;
  transition:transform .35s cubic-bezier(.34,1.56,.64,1),background-color .3s,color .3s}.is .cols3 article:hover .ic{transform:translateY(-3px) scale(1.06);background:var(--blue);color:#fff}.is .cols3 .ic .i{width:19px;height:19px}.is .cols3 h3{font-size:clamp(16px,1.3vw,17.5px);letter-spacing:-.01em;margin-bottom:7px}.is .cols3 p{font-size:14.5px;color:var(--ink-2);line-height:1.55}.is .cols3 article:hover .tags i{background:var(--wash);color:var(--blue-deep)}@media (max-width:950px){.is .cols3{grid-template-columns:1fr}.is .cols3 article{padding:22px 0 4px;border-right:0;border-bottom:1px solid var(--line)}.is .cols3 article:first-child{padding-left:0}.is .cols3 article:last-child{border-bottom:0;padding-right:0}
}.is .ctastrip{position:relative;overflow:hidden;display:flex;align-items:center;justify-content:space-between;
  gap:clamp(20px,3vw,48px);flex-wrap:wrap;margin-top:clamp(28px,3.4vw,44px);
  padding:clamp(28px,3.2vw,42px) clamp(24px,3.4vw,48px);border-radius:24px;color:#fff;
  background:linear-gradient(100deg,#0083C8 0%,#1E93D6 34%,#5DB8E9 66%,#BFE5F8 100%)}.is .ctastrip::before{content:"";position:absolute;inset:0;pointer-events:none;
  background:radial-gradient(60% 80% at 100% 0%,rgba(255,255,255,.45),transparent 70%)}.is .ctastrip>*{position:relative}.is .ctastrip .ctx{max-width:58ch}.is .ctastrip .eb{color:#fff}.is .ctastrip h3{font-size:clamp(20px,2.1vw,25px);letter-spacing:-.015em;margin:12px 0 8px;color:#fff}.is .ctastrip p{font-size:15px;color:rgba(255,255,255,.86);line-height:1.55}.is .cbtn{flex:none}.is .cbtn .btn.pri{background:#fff;color:var(--blue-deep);box-shadow:0 10px 24px -12px rgba(0,40,70,.5)}.is .cbtn .btn.pri:hover{background:#F4FAFD}.is #console{padding-bottom:clamp(24px,3vw,44px)}.is #modules{padding-top:clamp(28px,3.4vw,52px)}.is .pstack{display:flex;flex-direction:column;gap:12vh;max-width:800px;margin:0 auto;
  padding:10px 0 max(10vh,80px)}.is .dcard{position:sticky;top:calc(max(130px, 50vh - 247px) + var(--i,0) * 14px);
  transform:scale(calc(1 - var(--p,0) * .05));transform-origin:top center;
  will-change:transform;
  background:#fff;border:1px solid var(--line);border-radius:var(--r2);overflow:hidden;
  box-shadow:0 -6px 20px -16px rgba(6,42,68,.1),0 30px 70px -34px rgba(6,42,68,.34);
  transition:box-shadow .35s}.is .dcard:hover{box-shadow:0 -6px 20px -16px rgba(6,42,68,.1),0 38px 84px -34px rgba(6,42,68,.44)}.is .dcard .art{aspect-ratio:640/336;background:#F2F8FC;border-bottom:1px solid var(--line)}.is .dcard .art svg{display:block;width:100%;height:100%}.is .dcard .tx{padding:26px 26px 30px;text-align:center;max-width:640px;margin:0 auto}.is .dcard .n{font-size:12px;font-weight:800;letter-spacing:.16em;color:var(--blue)}.is .dcard h3{font-size:clamp(21px,2.1vw,26px);margin:10px 0 10px;letter-spacing:-.015em}.is .dcard p{font-size:15.5px;color:var(--ink-2)}.is .loop{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;counter-reset:s}.is .lstep{position:relative;display:flex;flex-direction:column;background:var(--bg);
