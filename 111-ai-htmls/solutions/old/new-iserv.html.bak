<!-- ithena-iserv-restructure -->
<section class="ibsec"><div class="wrap">
  <div class="head rv"><p class="eb">iSERV Capabilities</p>
    <h2>Self-Servicing <span class="grad">at Your Fingertips.</span></h2>
    <p class="lede">iSERV enables the various roles at your customers, including service technicians, managers and other team members, with digital, real-time visibility of equipment information. Operators or technicians can log cases and collaborate with the OEM’s service team, all from an integrated, easy-to-use mobile application and a web portal.</p>
    <p class="lede">It gives the OEM’s service team the ability to connect, visualize and act on the customer’s issues within the defined Service Level Agreements (SLA).</p></div>
  <div class="ibrow">
  <a class="ibcard rv" href="#loop" style="--d:0.00s">
    <figure class="ibfig"><img src="https://ithena.ai/wp-content/uploads/2026/08/iserv-mod3-monitoring.webp" width="1200" height="900" alt="Performance Monitoring and Predictive Maintenance" loading="lazy" decoding="async"><span class="ibbadge"><svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 5h18v11H3z"/><path d="M8 20h8M12 16v4"/><path d="m6.5 11.5 2.5-3 2.5 3 2-4 2.5 4.5"/></svg></span></figure>
    <div class="ibbody">
    <div class="ibno"><b>01</b></div>
    <h3>Performance Monitoring and Predictive Maintenance</h3>
    <p>Telemetry from the equipment itself, turned into dashboards and thresholds people act on, with digitized routines and inspections that follow what the equipment is actually reading.</p>
    <ul class="ibfeat"><li><span class="fi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="6" cy="18" r="2.4"/><circle cx="18" cy="18" r="2.4"/><circle cx="12" cy="5" r="2.4"/><path d="M10.4 6.9 7.5 15.7M13.6 6.9l2.9 8.8M8.4 18h7.2"/></svg></span>Asset Connectivity</li><li><span class="fi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 16v-5a6 6 0 0 1 12 0v5l2 2H4Z"/><path d="M10 21h4"/></svg></span>Proactive Alerts</li><li><span class="fi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 15a8 8 0 0 1 16 0"/><path d="m12 15 4-5"/><path d="M2 19h20"/></svg></span>Asset KPI Monitoring</li><li><span class="fi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18h6"/><path d="M10 21h4"/><path d="M8 13a4.5 4.5 0 1 1 8 0c-.8 1-1.5 2-1.5 3h-5c0-1-.7-2-1.5-3Z"/></svg></span>Actionable Insights</li><li><span class="fi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/><path d="M7.5 12.5V10M11 12.5V7.8M14.5 12.5V9"/></svg></span>Real Time Dashboards</li><li><span class="fi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="3.5" width="16" height="17" rx="3"/><path d="m8.6 12.2 2.5 2.5 4.3-5"/></svg></span>Digitized Service</li><li><span class="fi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6"/><path d="m19.5 19.5-4.4-4.4"/><path d="m8.6 10.9 1.6 1.6 3.1-3.3"/></svg></span>Automated Inspections</li><li><span class="fi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9.5 6H20M9.5 12H20M9.5 18H20"/><path d="m3 5.6 1.3 1.3L6.9 4.3M3 11.6l1.3 1.3 2.6-2.6M3 17.6l1.3 1.3 2.6-2.6"/></svg></span>Work Order Management</li><li><span class="fi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12h4l2.4-6.4 4 12.8L16 12h5"/></svg></span>Condition-Based</li><li><span class="fi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg></span>Schedule-Based</li></ul>
    <span class="ibcta"><svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/></svg><span>Connect, collect, visualise, predict, act</span><svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></span>
    </div>
  </a>
  <a class="ibcard rv" href="#mobile" style="--d:0.08s">
    <figure class="ibfig"><img src="https://ithena.ai/wp-content/uploads/2026/08/iserv-mod3-service.webp" width="1200" height="900" alt="Service Management and Knowledge Portal" loading="lazy" decoding="async"><span class="ibbadge"><svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9V7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v2a2.5 2.5 0 0 0 0 5v2a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-2a2.5 2.5 0 0 0 0-5Z"/><path d="M13 5v3M13 11v2M13 16v3"/></svg></span></figure>
    <div class="ibbody">
    <div class="ibno"><b>02</b></div>
    <h3>Service Management and Knowledge Portal</h3>
    <p>Ticketing, allocation, scheduling and reporting across the whole request queue, with the procedure the shift needs in a format they can search on the floor.</p>
    <ul class="ibfeat"><li><span class="fi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 8a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v1.6a2.4 2.4 0 0 0 0 4.8V16a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-1.6a2.4 2.4 0 0 0 0-4.8Z"/><path d="M13.5 8.5v7"/></svg></span>Integrated Ticketing</li><li><span class="fi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h4l2 2.6h8a2 2 0 0 1 2 2V18a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"/></svg></span>Case Management</li><li><span class="fi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3.2"/><path d="M2.5 19.5a6.5 6.5 0 0 1 13 0"/><path d="M16.2 5.4a3.2 3.2 0 0 1 0 5.2M17.8 19.5a6.6 6.6 0 0 0-1.9-4.6"/></svg></span>Technician Allocation</li><li><span class="fi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="10" cy="8" r="3.2"/><path d="M3.5 19.5a6.5 6.5 0 0 1 13 0"/><path d="M19 11v6M16 14h6"/></svg></span>Customer Onboarding</li><li><span class="fi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6.5 3h6.5l4.5 4.5V20a1 1 0 0 1-1 1h-10a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Z"/><path d="M13 3v5h4.5"/><path d="M8.5 13h7M8.5 17h4.5"/></svg></span>Quotes | Proposals | Service Reports</li><li><span class="fi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7.5" height="7.5" rx="1.6"/><rect x="13.5" y="3" width="7.5" height="7.5" rx="1.6"/><rect x="3" y="13.5" width="7.5" height="7.5" rx="1.6"/><rect x="13.5" y="13.5" width="7.5" height="7.5" rx="1.6"/></svg></span>Content Hub</li><li><span class="fi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="4.5" width="19" height="15" rx="3"/><path d="m10 8.8 5.2 3.2-5.2 3.2Z"/></svg></span>How-to Videos</li><li><span class="fi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4.6A1.6 1.6 0 0 1 5.6 3H10a2.8 2.8 0 0 1 2 .9A2.8 2.8 0 0 1 14 3h4.4A1.6 1.6 0 0 1 20 4.6v12.8a1.6 1.6 0 0 1-1.6 1.6H14a2 2 0 0 0-2 1 2 2 0 0 0-2-1H5.6A1.6 1.6 0 0 1 4 17.4Z"/><path d="M12 4.9V19"/></svg></span>Training Manuals</li><li><span class="fi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9.6 9.5a2.5 2.5 0 1 1 3.4 2.3c-.7.3-1 .9-1 1.6v.4"/><path d="M12 17.2h.01"/></svg></span>Self-Service Knowledge Artifacts</li><li><span class="fi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 5 6v5.4c0 4.3 2.9 7.7 7 9.6 4.1-1.9 7-5.3 7-9.6V6Z"/><path d="m9 12 2.2 2.2 4.3-4.4"/></svg></span>Regulatory Compliance</li></ul>
    <span class="ibcta"><svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/></svg><span>The app in their pocket</span><svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></span>
    </div>
  </a>
  <a class="ibcard rv" href="#console" data-stage="4" style="--d:0.16s">
    <figure class="ibfig"><img src="https://ithena.ai/wp-content/uploads/2026/08/iserv-mod3-commerce.webp" width="1200" height="900" alt="E-commerce and ERP System Integration" loading="lazy" decoding="async"><span class="ibbadge"><svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/><path d="M2 3h2.2l2.3 12.2a1.6 1.6 0 0 0 1.6 1.3h8.5a1.6 1.6 0 0 0 1.6-1.3L21 7H5"/></svg></span></figure>
    <div class="ibbody">
    <div class="ibno"><b>03</b></div>
    <h3>E-commerce and ERP System Integration</h3>
    <p>Ordering built into the service application, with 3D views so buyers pick the right item, reading the systems of record you already run so nothing is keyed twice.</p>
    <ul class="ibfeat"><li><span class="fi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 3 8 4.5v9L12 21l-8-4.5v-9Z"/><path d="m4 7.5 8 4.5 8-4.5M12 12v9"/></svg></span>Spare Parts Ordering with 3D Views</li><li><span class="fi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20.3s-7-4.5-7-9.4A3.9 3.9 0 0 1 12 8a3.9 3.9 0 0 1 7 2.9c0 4.9-7 9.4-7 9.4Z"/></svg></span>RSPL Provision | Wishlist</li><li><span class="fi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 2.8 7.5 4.3v8.6L12 20l-7.5-4.3V7.1Z"/><circle cx="12" cy="11.9" r="3.2"/></svg></span>Orderable Parts</li><li><span class="fi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21.2s7-5.7 7-11.2a7 7 0 1 0-14 0c0 5.5 7 11.2 7 11.2Z"/><circle cx="12" cy="10" r="2.6"/></svg></span>Track to Delivery</li><li><span class="fi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="5" width="19" height="14" rx="2.5"/><path d="M2.5 10h19M6 15h4.5"/></svg></span>Payment | Shipping</li><li><span class="fi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="12.6" width="7.8" height="7.8" rx="1.2"/><rect x="13.2" y="12.6" width="7.8" height="7.8" rx="1.2"/><rect x="8.1" y="3.6" width="7.8" height="7.8" rx="1.2"/></svg></span>Inventory | Cost</li><li><span class="fi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m7.9 12.2 2.7 2.7 5.5-5.7"/></svg></span>ATP | CTP Checks</li><li><span class="fi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 3h14v18l-2.3-1.6L14.3 21 12 19.4 9.7 21 7.3 19.4 5 21Z"/><path d="M8.5 8h7M8.5 12h7"/></svg></span>View Sales Orders | Work Orders</li><li><span class="fi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="2.6" width="6" height="4.9" rx="1.2"/><rect x="2.6" y="16.5" width="6" height="4.9" rx="1.2"/><rect x="15.4" y="16.5" width="6" height="4.9" rx="1.2"/><path d="M12 7.5V12M5.6 16.5V12h12.8v4.5"/></svg></span>Bills of Material</li><li><span class="fi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><ellipse cx="12" cy="5.8" rx="7" ry="2.9"/><path d="M5 5.8v12.4c0 1.6 3.1 2.9 7 2.9s7-1.3 7-2.9V5.8"/><path d="M5 12c0 1.6 3.1 2.9 7 2.9s7-1.3 7-2.9"/></svg></span>Any ERP, One Integration</li></ul>
    <span class="ibcta"><svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/></svg><span>Order the part from the ticket</span><svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></span>
    </div>
  </a>
  </div>
</div></section>
<section class="sec" id="who" style="padding-top:0"><div class="wrap">
  <div class="head rv"><p class="eb">Who benefits from iSERV</p>
    <h2>Three Roles, <span class="grad">One Record.</span></h2>
    <p class="lede">The same fault looks different depending on who opens it. Each role gets the view, and the actions, that belong to their own job.</p></div>
  <div class="tcards"><article class="tcard rv" style="--d:0.00s"><div class="tx"><span class="ic"><svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9V7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v2a2.5 2.5 0 0 0 0 5v2a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-2a2.5 2.5 0 0 0 0-5Z"/><path d="M13 5v3M13 11v2M13 16v3"/></svg></span><h3>OEM Service Managers</h3><p>See every open case across your installed base, who is working on it, and whether it is still inside the agreed response time. Plan visits and parts from the same screen.</p><a class="pill" href="#console" data-stage="2">See the view <svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a></div><div class="tile" aria-hidden="true"><svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9V7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v2a2.5 2.5 0 0 0 0 5v2a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-2a2.5 2.5 0 0 0 0-5Z"/><path d="M13 5v3M13 11v2M13 16v3"/></svg></div></article><article class="tcard rv" style="--d:0.07s"><div class="tx"><span class="ic"><svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3.2"/><path d="M3 20a6 6 0 0 1 12 0"/><path d="m17.5 12.5 1.8 1.8"/><path d="M21 9.2a2.8 2.8 0 0 1-3.7 3.7l-2.4 2.4a1.3 1.3 0 0 1-1.9-1.9l2.4-2.4A2.8 2.8 0 0 1 19.1 7.3Z"/></svg></span><h3>OEM Service Technicians</h3><p>Get the machine’s live data and fault history before you travel, talk to the customer in one thread, and follow the procedure and parts list on your phone.</p><a class="pill" href="#console" data-stage="1">See the view <svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a></div><div class="tile" aria-hidden="true"><svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3.2"/><path d="M3 20a6 6 0 0 1 12 0"/><path d="m17.5 12.5 1.8 1.8"/><path d="M21 9.2a2.8 2.8 0 0 1-3.7 3.7l-2.4 2.4a1.3 1.3 0 0 1-1.9-1.9l2.4-2.4A2.8 2.8 0 0 1 19.1 7.3Z"/></svg></div></article><article class="tcard rv" style="--d:0.14s"><div class="tx"><span class="ic"><svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 5h18v11H3z"/><path d="M8 20h8M12 16v4"/><path d="m6.5 11.5 2.5-3 2.5 3 2-4 2.5 4.5"/></svg></span><h3>OEM’s Customer’s Operators</h3><p>Report a fault on the machine where it happens, follow the how-to guides, see which engineer is coming and when, and order spares from the same app.</p><a class="pill" href="#console" data-stage="3">See the view <svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a></div><div class="tile" aria-hidden="true"><svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 5h18v11H3z"/><path d="M8 20h8M12 16v4"/><path d="m6.5 11.5 2.5-3 2.5 3 2-4 2.5 4.5"/></svg></div></article></div>
</div></section>
<!-- /ithena-iserv-restructure -->

<section class="sec" id="problem"><div class="wrap">
  <div class="head ctr rv"><p class="eb">The challenge</p>
    <h2>After the Machine Ships, <span class="grad">You Go Blind.</span></h2>
    <p class="lede">The equipment is on someone else’s floor, running shifts you cannot see. Every hour it is down is your reputation, and most of the delay happens before an engineer has even been&nbsp;told.</p></div>
  <div class="pstack"><article class="dcard rv" style="--i:0;--d:0.00s"><div class="art" role="img" aria-label="Three shifts of machine state, with one unplanned stop that cost six hours"><svg class="pvis" viewBox="36 24 568 288" xmlns="http://www.w3.org/2000/svg" font-family="Noto Sans,-apple-system,Segoe UI,Roboto,sans-serif" aria-hidden="true"><defs><linearGradient id="pvg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#F7FBFE"/><stop offset="1" stop-color="#E6F2FA"/></linearGradient><pattern id="pvd" width="14" height="14" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r="1" fill="#D7E3EE"/></pattern></defs><rect width="640" height="336" fill="url(#pvg)"/><rect width="640" height="336" fill="url(#pvd)" opacity=".8"/><text class="" x="48" y="66" font-size="10.5" font-weight="700" fill="#5B6470" text-anchor="start">Shift A</text><rect x="48" y="74" width="544" height="34" rx="5" fill="#fff" stroke="#D7E3EE"/><rect class="blk" style="--d:0.00s" x="51" y="79" width="249" height="24" rx="3" fill="#2E9E6B" opacity=".62"/><rect class="blk" style="--d:0.17s" x="302" y="79" width="52" height="24" rx="3" fill="#E8A33D" opacity=".62"/><rect class="blk" style="--d:0.20s" x="356" y="79" width="231" height="24" rx="3" fill="#2E9E6B" opacity=".62"/><text class="" x="48" y="116" font-size="10.5" font-weight="700" fill="#5B6470" text-anchor="start">Shift B</text><rect x="48" y="124" width="544" height="34" rx="5" fill="#fff" stroke="#D7E3EE"/><rect class="blk" style="--d:0.12s" x="51" y="129" width="159" height="24" rx="3" fill="#2E9E6B" opacity=".62"/><rect class="blk" style="--d:0.23s" x="212" y="129" width="141" height="24" rx="3" fill="#D9534F" opacity="1"/><rect class="blk" style="--d:0.32s" x="356" y="129" width="231" height="24" rx="3" fill="#2E9E6B" opacity=".62"/><text class="" x="48" y="166" font-size="10.5" font-weight="700" fill="#5B6470" text-anchor="start">Shift C</text><rect x="48" y="174" width="544" height="34" rx="5" fill="#fff" stroke="#D7E3EE"/><rect class="blk" style="--d:0.24s" x="51" y="179" width="213" height="24" rx="3" fill="#2E9E6B" opacity=".62"/><rect class="blk" style="--d:0.38s" x="266" y="179" width="34" height="24" rx="3" fill="#E8A33D" opacity=".62"/><rect class="blk" style="--d:0.41s" x="302" y="179" width="285" height="24" rx="3" fill="#2E9E6B" opacity=".62"/><line class="flow" x1="283" y1="158" x2="283" y2="240" stroke="#D9534F" stroke-width="1.2" stroke-dasharray="4 5"/><g class="pop" style="--d:.55s"><rect class="sh" x="178" y="240" width="284" height="62" rx="10" fill="#fff" stroke="#D9534F" stroke-width="1.3"/><g class="tick"><circle cx="204" cy="264" r="9" fill="#D9534F"/><text class="" x="204" y="268" font-size="12" font-weight="800" fill="#fff" text-anchor="middle">!</text></g><text class="" x="222" y="262" font-size="12" font-weight="800" fill="#0D1B2E" text-anchor="start">Unplanned stop</text><text class="" x="222" y="282" font-size="10.5" font-weight="600" fill="#5B6470" text-anchor="start">Line 3 spindle drive, 6 h 20 m lost</text><text class="" x="446" y="272" font-size="13" font-weight="800" fill="#D9534F" text-anchor="end">−6h 20m</text></g><text class="" x="48" y="44" font-size="10" font-weight="700" fill="#5B6470" text-anchor="start">MACHINE STATE, LAST THREE SHIFTS</text><rect x="48" y="52" width="544" height="1" fill="#D7E3EE"/></svg></div><div class="tx"><span class="n">01</span><h3>Breakdowns Nobody Saw Coming</h3><p>Machines fail between planned services, and the first anyone hears of it is a stopped line.</p></div></article><article class="dcard rv" style="--i:1;--d:0.06s"><div class="art" role="img" aria-label="Four inbound channels arriving at a case record that does not exist"><svg class="pvis" viewBox="36 24 568 288" xmlns="http://www.w3.org/2000/svg" font-family="Noto Sans,-apple-system,Segoe UI,Roboto,sans-serif" aria-hidden="true"><defs><linearGradient id="pvg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#F7FBFE"/><stop offset="1" stop-color="#E6F2FA"/></linearGradient><pattern id="pvd" width="14" height="14" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r="1" fill="#D7E3EE"/></pattern></defs><rect width="640" height="336" fill="url(#pvg)"/><rect width="640" height="336" fill="url(#pvd)" opacity=".8"/><line class="flow" x1="217" y1="91" x2="321" y2="123" stroke="#33A1E0" stroke-width="1.2" stroke-dasharray="4 5" opacity=".8"/><g class="pop" style="--d:0.08s"><rect class="sh" x="48" y="46" width="176" height="40" rx="8" fill="#fff" stroke="#D7E3EE" /><circle cx="70" cy="66" r="10" fill="#EEF6FC"/><circle cx="70" cy="66" r="3.2" fill="#0083C8"/><text class="" x="82" y="71" font-size="11" font-weight="600" fill="#0D1B2E" text-anchor="start">Phone call</text></g><line class="flow" x1="229" y1="136" x2="321" y2="148" stroke="#33A1E0" stroke-width="1.2" stroke-dasharray="4 5" opacity=".8"/><g class="pop" style="--d:0.18s"><rect class="sh" x="48" y="104" width="176" height="40" rx="8" fill="#fff" stroke="#D7E3EE" /><circle cx="70" cy="124" r="10" fill="#EEF6FC"/><circle cx="70" cy="124" r="3.2" fill="#0083C8"/><text class="" x="82" y="129" font-size="11" font-weight="600" fill="#0D1B2E" text-anchor="start">Email thread</text></g><line class="flow" x1="229" y1="177" x2="321" y2="173" stroke="#33A1E0" stroke-width="1.2" stroke-dasharray="4 5" opacity=".8"/><g class="pop" style="--d:0.28s"><rect class="sh" x="48" y="162" width="176" height="40" rx="8" fill="#fff" stroke="#D7E3EE" /><circle cx="70" cy="182" r="10" fill="#EEF6FC"/><circle cx="70" cy="182" r="3.2" fill="#0083C8"/><text class="" x="82" y="187" font-size="11" font-weight="600" fill="#0D1B2E" text-anchor="start">Chat message</text></g><line class="flow" x1="229" y1="219" x2="321" y2="198" stroke="#33A1E0" stroke-width="1.2" stroke-dasharray="4 5" opacity=".8"/><g class="pop" style="--d:0.38s"><rect class="sh" x="48" y="220" width="176" height="40" rx="8" fill="#fff" stroke="#D7E3EE" /><circle cx="70" cy="240" r="10" fill="#EEF6FC"/><circle cx="70" cy="240" r="3.2" fill="#0083C8"/><text class="" x="82" y="245" font-size="11" font-weight="600" fill="#0D1B2E" text-anchor="start">Site visit</text></g><rect class="sh" x="326" y="108" width="268" height="116" rx="12" fill="#fff" stroke="#D9534F" stroke-width="1.4" stroke-dasharray="6 5"/><text class="" x="460" y="140" font-size="10" font-weight="700" fill="#5B6470" text-anchor="middle">CASE RECORD</text><text class="pulse" x="460" y="184" font-size="36" font-weight="800" fill="#D9534F" text-anchor="middle">?</text><rect x="356" y="196" width="208" height="1" fill="#D7E3EE"/><text class="" x="460" y="214" font-size="10.5" font-weight="600" fill="#5B6470" text-anchor="middle">no owner, no SLA clock</text><g class="pop" style="--d:.6s"><rect class="sh" x="326" y="244" width="268" height="34" rx="8" fill="#fff" stroke="#D7E3EE" /><circle cx="348" cy="261" r="6" fill="#E8A33D"/><text class="" x="364" y="265" font-size="10.5" font-weight="600" fill="#0D1B2E" text-anchor="start">Answered twice, resolved once</text></g></svg></div><div class="tx"><span class="n">02</span><h3>Nowhere to Raise a Query</h3><p>Calls, emails and messages arrive on four channels and none of them creates a record that anyone owns.</p></div></article><article class="dcard rv" style="--i:2;--d:0.12s"><div class="art" role="img" aria-label="A 312-page printed manual returning no results for a shop-floor search"><svg class="pvis" viewBox="36 24 568 288" xmlns="http://www.w3.org/2000/svg" font-family="Noto Sans,-apple-system,Segoe UI,Roboto,sans-serif" aria-hidden="true"><defs><linearGradient id="pvg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#F7FBFE"/><stop offset="1" stop-color="#E6F2FA"/></linearGradient><pattern id="pvd" width="14" height="14" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r="1" fill="#D7E3EE"/></pattern></defs><rect width="640" height="336" fill="url(#pvg)"/><rect width="640" height="336" fill="url(#pvd)" opacity=".8"/><line class="flow" x1="258" y1="134" x2="298" y2="127" stroke="#33A1E0" stroke-width="1.2" stroke-dasharray="4 5" opacity=".8"/><g class="pop" style="--d:.1s"><rect class="sh" x="60" y="84" width="190" height="132" rx="8" fill="#fff" stroke="#0D1B2E" stroke-width="1.4"/><rect x="60" y="84" width="24" height="132" rx="8" fill="#0D1B2E" opacity=".92"/><rect x="60" y="84" width="24" height="132" rx="8" fill="none" stroke="#0D1B2E"/><rect x="100" y="112" width="128" height="4" rx="2" fill="#D7E3EE"/><rect x="100" y="127" width="105" height="4" rx="2" fill="#D7E3EE"/><rect x="100" y="142" width="119" height="4" rx="2" fill="#D7E3EE"/><rect x="100" y="157" width="77" height="4" rx="2" fill="#D7E3EE"/><rect x="100" y="172" width="113" height="4" rx="2" fill="#D7E3EE"/><rect x="100" y="196" width="60" height="6" rx="3" fill="#0083C8" opacity=".55"/></g><text class="" x="155" y="240" font-size="10.5" font-weight="600" fill="#5B6470" text-anchor="middle">Maintenance manual, rev 4</text><text class="" x="155" y="258" font-size="10" font-weight="500" fill="#5B6470" text-anchor="middle">312 pages, one printed copy</text><g class="pop" style="--d:.35s"><rect class="sh" x="306" y="84" width="282" height="40" rx="20" fill="#fff" stroke="#D7E3EE" /><circle cx="332" cy="104" r="7" fill="none" stroke="#5B6470" stroke-width="1.6"/><path d="M337 109l7 7" stroke="#5B6470" stroke-width="1.6" stroke-linecap="round"/><text class="" x="350" y="109" font-size="11.5" font-weight="600" fill="#0D1B2E" text-anchor="start">spindle drive fault</text></g><g class="pop" style="--d:.5s"><rect class="sh" x="306" y="138" width="282" height="106" rx="10" fill="#fff" stroke="#D7E3EE" /><circle cx="447" cy="176" r="14" fill="#EEF6FC"/><circle cx="444" cy="173" r="5.5" fill="none" stroke="#5B6470" stroke-width="1.6"/><path d="M448 177l5 5" stroke="#5B6470" stroke-width="1.6" stroke-linecap="round"/><text class="" x="447" y="208" font-size="11" font-weight="700" fill="#0D1B2E" text-anchor="middle">0 results on the shop floor</text><text class="" x="447" y="226" font-size="10" font-weight="500" fill="#5B6470" text-anchor="middle">the manual is not searchable</text></g><g class="pop" style="--d:.68s"><rect class="sh" x="306" y="258" width="282" height="34" rx="8" fill="#fff" stroke="#E8A33D" stroke-width="1.2"/><circle cx="328" cy="275" r="6" fill="#E8A33D"/><text class="" x="344" y="279" font-size="10.5" font-weight="600" fill="#0D1B2E" text-anchor="start">So the operator calls the OEM</text></g></svg></div><div class="tx"><span class="n">03</span><h3>Manuals the Shift Cannot Use</h3><p>The answer exists in a printed manual the operator cannot search while the machine is down.</p></div></article><article class="dcard rv" style="--i:3;--d:0.18s"><div class="art" role="img" aria-label="Three site visits for one fault because the spare part was ordered after the second"><svg class="pvis" viewBox="36 24 568 288" xmlns="http://www.w3.org/2000/svg" font-family="Noto Sans,-apple-system,Segoe UI,Roboto,sans-serif" aria-hidden="true"><defs><linearGradient id="pvg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#F7FBFE"/><stop offset="1" stop-color="#E6F2FA"/></linearGradient><pattern id="pvd" width="14" height="14" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r="1" fill="#D7E3EE"/></pattern></defs><rect width="640" height="336" fill="url(#pvg)"/><rect width="640" height="336" fill="url(#pvd)" opacity=".8"/><line class="draw" pathLength="1" pathLength="1" x1="60" y1="128" x2="580" y2="128" stroke="#0D1B2E" stroke-width="1.6"/><g class="pop" style="--d:0.20s"><circle cx="110" cy="128" r="9" fill="#fff" stroke="#D9534F" stroke-width="2"/><text class="" x="110" y="158" font-size="12" font-weight="700" fill="#0D1B2E" text-anchor="middle">Visit 1</text><text class="" x="110" y="175" font-size="10.5" font-weight="600" fill="#D9534F" text-anchor="middle">diagnosed</text></g><g class="pop" style="--d:0.40s"><circle cx="280" cy="128" r="9" fill="#fff" stroke="#D9534F" stroke-width="2"/><text class="" x="280" y="158" font-size="12" font-weight="700" fill="#0D1B2E" text-anchor="middle">Visit 2</text><text class="" x="280" y="175" font-size="10.5" font-weight="600" fill="#D9534F" text-anchor="middle">wrong part</text></g><g class="pop" style="--d:0.60s"><circle cx="470" cy="128" r="9" fill="#fff" stroke="#2E9E6B" stroke-width="2"/><text class="" x="470" y="158" font-size="12" font-weight="700" fill="#0D1B2E" text-anchor="middle">Visit 3</text><text class="" x="470" y="175" font-size="10.5" font-weight="600" fill="#2E9E6B" text-anchor="middle">fixed</text></g><g class="truck" style="--d:0.0s"><rect x="78" y="72" width="40" height="26" rx="3" fill="#0D1B2E"/><path d="M118 80h14l10 12v6h-24z" fill="#0D1B2E"/><circle cx="88" cy="100" r="5" fill="#fff" stroke="#0D1B2E" stroke-width="2"/><circle cx="128" cy="100" r="5" fill="#fff" stroke="#0D1B2E" stroke-width="2"/><path d="M60 86h10M52 94h16" stroke="#33A1E0" stroke-width="1.6" stroke-linecap="round"/></g><g class="truck" style="--d:0.4s"><rect x="248" y="72" width="40" height="26" rx="3" fill="#0D1B2E"/><path d="M288 80h14l10 12v6h-24z" fill="#0D1B2E"/><circle cx="258" cy="100" r="5" fill="#fff" stroke="#0D1B2E" stroke-width="2"/><circle cx="298" cy="100" r="5" fill="#fff" stroke="#0D1B2E" stroke-width="2"/><path d="M230 86h10M222 94h16" stroke="#33A1E0" stroke-width="1.6" stroke-linecap="round"/></g><g class="pop" style="--d:.7s"><rect class="sh" x="392" y="44" width="196" height="62" rx="8" fill="#fff" stroke="#E8A33D" stroke-width="1.2"/><path d="M414 62h30v26h-30z" fill="none" stroke="#E8A33D" stroke-width="1.6"/><path d="M414 70h30M429 62v26" stroke="#E8A33D" stroke-width="1.2"/><text class="" x="456" y="68" font-size="10.5" font-weight="700" fill="#5B6470" text-anchor="start">Spare part</text><text class="" x="456" y="88" font-size="10.5" font-weight="700" fill="#0D1B2E" text-anchor="start">ordered after visit 2</text></g><path class="flow" d="M470 106C470 118 470 118 470 119" fill="none" stroke="#33A1E0" stroke-width="1.3" stroke-dasharray="4 5"/><g class="pop" style="--d:.9s"><rect class="sh" x="150" y="240" width="340" height="62" rx="10" fill="#fff" stroke="#D9534F" stroke-width="1.3"/><text class="" x="174" y="262" font-size="12" font-weight="800" fill="#0D1B2E" text-anchor="start">Three site visits, one fault</text><text class="" x="174" y="282" font-size="10.5" font-weight="600" fill="#5B6470" text-anchor="start">Billed as goodwill, and the customer still waited</text><text class="" x="466" y="272" font-size="13" font-weight="800" fill="#D9534F" text-anchor="end">11 days</text></g></svg></div><div class="tx"><span class="n">04</span><h3>Three Visits for One Fault</h3><p>Engineers turn up without the right part, and the customer sits idle until a second trip can be arranged.</p></div></article></div>
</div></section>

<section class="sec lt" id="loop"><div class="wrap">
  <div class="head rv"><p class="eb">Connect, collect, visualise, predict, act</p>
    <h2>From the First Alert to <span class="grad">the Part on the&nbsp;Van.</span></h2>
    <p class="lede">iSERV runs the whole service loop on one record, so the alert, the engineer, the fix and the part all belong to the same asset.</p></div>
  <div class="lrail rv"><i></i></div>
  <div class="loop"><article class="lstep rv" style="--d:0.00s"><span class="ic"><svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 5h18v11H3z"/><path d="M8 20h8M12 16v4"/><path d="m6.5 11.5 2.5-3 2.5 3 2-4 2.5 4.5"/></svg></span><p class="eb" style="margin-bottom:12px">Monitor</p><h3>The Machine Stops Being a Black Box</h3><p>Connectivity, KPI monitoring and real-time dashboards, so you and your customer read the same live numbers.</p><div class="out"><b>A connected asset</b>One record per machine, open to your team and theirs.</div></article><article class="lstep rv" style="--d:0.08s"><span class="ic"><svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v2M12 19v2M4.2 6.2l1.5 1.5M18.3 16.3l1.5 1.5M3 12h2M19 12h2M4.2 17.8l1.5-1.5M18.3 7.7l1.5-1.5"/><circle cx="12" cy="12" r="4"/><path d="M12 10v2l1.5 1"/></svg></span><p class="eb" style="margin-bottom:12px">Predict</p><h3>Act Before the Line Ever Stops</h3><p>Proactive alerts and automated inspections raise the work order while the machine is still turning.</p><div class="out"><b>A planned work order</b>Raised ahead of the stoppage, not after it.</div></article><article class="lstep rv" style="--d:0.16s"><span class="ic"><svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9V7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v2a2.5 2.5 0 0 0 0 5v2a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-2a2.5 2.5 0 0 0 0-5Z"/><path d="M13 5v3M13 11v2M13 16v3"/></svg></span><p class="eb" style="margin-bottom:12px">Resolve</p><h3>Close the Case Inside the Agreement</h3><p>Whatever route the customer took to reach you, the request becomes one record with a name and a timer against it.</p><div class="out"><b>A closed case</b>One owner, one clock, one signed record of the fix.</div></article><article class="lstep rv" style="--d:0.24s"><span class="ic"><svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/><path d="M2 3h2.2l2.3 12.2a1.6 1.6 0 0 0 1.6 1.3h8.5a1.6 1.6 0 0 0 1.6-1.3L21 7H5"/></svg></span><p class="eb" style="margin-bottom:12px">Reorder</p><h3>Order the Part From the Same Screen</h3><p>The spare is bought against the machine that raised the fault, with stock and price straight from your ERP.</p><div class="out"><b>A part on its way</b>Bought against the asset, tracked to delivery.</div></article></div>
</div></section>

<section class="sec" id="console"><div class="wrap">
  <div class="head rv"><p class="eb">On the shop floor</p>
    <h2>The Screens Your Customer <span class="grad">Actually Opens.</span></h2>
    <p class="lede">Persona-based dashboards, so a supervisor, an operator and a plant manager each land on the view that answers their own question — plus the desk your own people run the queue from. These are the iSERV screens themselves, so you can read them before the demo. Every dashboard is customizable to your own manufacturing, equipment and service needs.</p></div>
  <div class="stx">
  <div class="stx-rail"><div class="stx-pills" role="group" aria-label="Dashboards">
      <button class="stx-pill on" type="button" style="--pc:#0083C8" data-stage="0"><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 5h18v11H3z"/><path d="M8 20h8M12 16v4"/><path d="m6.5 11.5 2.5-3 2.5 3 2-4 2.5 4.5"/></svg></i>OEE Dashboard</button>
      <button class="stx-pill" type="button" style="--pc:#006AA3" data-stage="1"><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></i>Machine Uptime Analytics</button>
      <button class="stx-pill" type="button" style="--pc:#1EA672" data-stage="2"><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 17l5-6 4 3 4-6 5 4"/><path d="M3 21h18"/></svg></i>Performance Insights</button>
      <button class="stx-pill" type="button" style="--pc:#E8A33D" data-stage="3"><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 13a8 8 0 0 1 16 0"/><path d="M4 13v4a2 2 0 0 0 2 2h1v-6H4zM20 13v4a2 2 0 0 1-2 2h-1v-6h3z"/><path d="M12 21h3"/></svg></i>Service Desk</button>
      <button class="stx-pill" type="button" style="--pc:#2F5D8C" data-stage="4"><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/><path d="M2 3h2.2l2.3 12.2a1.6 1.6 0 0 0 1.6 1.3h8.5a1.6 1.6 0 0 0 1.6-1.3L21 7H5"/></svg></i>Order Parts</button>
  </div><div class="stx-sb" aria-hidden="true"><i></i></div></div>
  <div class="stx-panels">
    <div class="stx-panel" style="--ac:#0083C8;--ac2:#33A1E0">
      <article class="stx-card">
        <div class="stx-copy">
          <div class="stx-ghost" aria-hidden="true">01</div>
          <p class="stx-num"><b>1</b>Supervisors and operators</p>
          <h3>OEE Dashboard</h3>
          <p class="stx-lede">Enables supervisors and operators to monitor and accelerate production processes and asset performance.</p>
          <ul class="stx-facts"><li>Asset connectivity</li><li>Asset monitoring with OEE</li><li>Root cause analysis</li><li>Quality assurance</li></ul>
          <span class="stx-tag"><span class="dot"></span>iserv.ithena.ai / oee</span>
        </div>
        <div class="stx-vis rv shot">
          <figure class="stx-shot"><img src="https://ithena.ai/wp-content/uploads/2026/09/iserv-scr-oee.webp" alt="iSERV line overview: OLE, line throughput, line utilisation, total downtime and open alerts above a plant line carrying each machine’s own OEE and availability" width="1400" height="863" loading="lazy" decoding="async"></figure>
          <div class="stx-chip"><span><span class="k">Line overview</span><span class="v">OLE 47.95%, 13 alerts</span></span></div>
        </div>
      </article>
    </div>
    <div class="stx-panel" style="--ac:#006AA3;--ac2:#0083C8">
      <article class="stx-card">
        <div class="stx-copy">
          <div class="stx-ghost" aria-hidden="true">02</div>
          <p class="stx-num"><b>2</b>The production floor</p>
          <h3>Machine Uptime Analytics</h3>
          <p class="stx-lede">Enhances actionable insights into the operational status and availability of machines on the production floor.</p>
          <ul class="stx-facts"><li>Tracking machine availability</li><li>Downtime analysis</li><li>Resource optimization</li><li>Proactive alerts, alarms and notifications</li></ul>
          <span class="stx-tag"><span class="dot"></span>iserv.ithena.ai / availability</span>
        </div>
        <div class="stx-vis rv shot">
          <figure class="stx-shot"><img src="https://ithena.ai/wp-content/uploads/2026/09/iserv-scr-uptime.webp" alt="iSERV analyzer plotting one asset’s efficiency and OEE across a shift, with the predicted failure zone shaded and AI insights for anomalies and root cause" width="1400" height="863" loading="lazy" decoding="async"></figure>
          <div class="stx-chip"><span><span class="k">Toyo 2A</span><span class="v">Predicted failure zone</span></span></div>
        </div>
      </article>
    </div>
    <div class="stx-panel" style="--ac:#1EA672;--ac2:#5FD1A3">
      <article class="stx-card">
        <div class="stx-copy">
          <div class="stx-ghost" aria-hidden="true">03</div>
          <p class="stx-num"><b>3</b>Plant managers</p>
          <h3>Performance Insights</h3>
          <p class="stx-lede">Provides a comprehensive overview of key performance indicators (KPIs) related to manufacturing efficiency and quality.</p>
          <ul class="stx-facts"><li>Data visibility in persona-based dashboards</li><li>Data-driven decision-making</li><li>Enhanced performance</li><li>Benchmarking and continuous improvement</li></ul>
          <span class="stx-tag"><span class="dot"></span>iserv.ithena.ai / performance</span>
        </div>
        <div class="stx-vis rv shot">
          <figure class="stx-shot"><img src="https://ithena.ai/wp-content/uploads/2026/09/iserv-scr-perf.webp" alt="iSERV analyzer plotting quality percentage across a shift with the current value, the 24 hour average, the minimum, the maximum, the forecast trend and the risk level" width="1400" height="788" loading="lazy" decoding="async"></figure>
          <div class="stx-chip"><span><span class="k">Toyo 3B quality</span><span class="v">89.71%, risk medium</span></span></div>
        </div>
      </article>
    </div>
    <div class="stx-panel" style="--ac:#E8A33D;--ac2:#F3B740">
      <article class="stx-card">
        <div class="stx-copy">
          <div class="stx-ghost" aria-hidden="true">04</div>
          <p class="stx-num"><b>4</b>Your customer’s plant team</p>
          <h3>Service Desk</h3>
          <p class="stx-lede">The view your customer signs in to: the machines under contract, every case they have raised and where it stands, which of your engineers is on it and when the visit is booked, with the next request one tap away.</p>
          <ul class="stx-facts"><li>Raise a request against any machine</li><li>Every open case and its status</li><li>Who from your team is on it, and when</li><li>Order the spare from the same ticket</li></ul>
          <span class="stx-tag"><span class="dot"></span>iserv.ithena.ai / my-service</span>
        </div>
        <div class="stx-vis rv shot">
          <figure class="stx-shot"><img src="https://ithena.ai/wp-content/uploads/2026/09/iserv-scr-desk.webp" alt="iSERV service desk listing open work orders by project with subject, status, plant, assignee, SLA and due date, one order opened beside the maintenance schedule" width="1400" height="933" loading="lazy" decoding="async"></figure>
          <div class="stx-chip"><span><span class="k">WO0526400218</span><span class="v">Open, due 29 May</span></span></div>
        </div>
      </article>
    </div>
    <div class="stx-panel" style="--ac:#2F5D8C;--ac2:#5A8BC0">
      <article class="stx-card">
        <div class="stx-copy">
          <div class="stx-ghost" aria-hidden="true">05</div>
          <p class="stx-num"><b>5</b>From the ticket to the cart</p>
          <h3>Spare Parts Ordering</h3>
          <p class="stx-lede">The case that found the fault opens the parts list for that machine. The buyer picks the part off a 2D or 3D model of the assembly, sees the price and availability your ERP reports, and orders it without leaving the ticket.</p>
          <ul class="stx-facts"><li>Searchable parts list with 2D and 3D views</li><li>Price, availability and location from your ERP</li><li>Cart, shipping options and digital payment</li><li>Order tracking from placement to delivery</li></ul>
          <span class="stx-tag"><span class="dot"></span>iserv.ithena.ai / order-parts</span>
        </div>
        <div class="stx-vis rv">
          <div class="panel"><div class="glass"><div class="ui ">
  <div class="ui-top"><span class="ui-dots"><i></i><i></i><i></i></span>
    <span class="ui-url">iserv.ithena.ai / order-parts</span><span class="ui-av">JG</span></div>
  <div class="ui-modal">
  <div class="ui-mbar"><b>Ticket #833383</b><span class="ui-mtools"><i></i><i></i><i></i><i></i><i></i></span></div>
  <div class="ui-mhead"><b>Order parts · Motor</b><span class="x">×</span></div>
  <div class="ui-mbody">
    <div class="ui-tree"><span class="ui-search">Search</span><p class="ui-lab">Parts list</p><span class="ui-node l0"><i></i>eq_91_0000.asm</span><span class="ui-node l1"><i></i>EQ_91_0010</span><span class="ui-node l2"><i></i>EQ_91_0011</span><span class="ui-node l1"><i></i>EQ_91_0020</span><span class="ui-node l2"><i></i>EQ_91_0024</span><span class="ui-node l1"><i></i>EQ_91_0030</span><span class="ui-node l2 sel"><i></i>EQ_91_0033</span><span class="ui-node l1"><i></i>EQ_91_0035</span><span class="ui-node l2"><i></i>EQ_91_0039</span>
      <span class="ui-sel">Selected part <b>EQ_91_0033</b></span>
      <span class="ui-add">Add to cart</span></div>
    <div class="ui-view"><svg class="ui-3d" viewBox="0 0 420 230" aria-hidden="true">
  <defs>
    <linearGradient id="tank" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#B7C2CC"/><stop offset=".14" stop-color="#FCFDFE"/>
      <stop offset=".38" stop-color="#E4EAF0"/><stop offset=".72" stop-color="#B2BEC9"/>
      <stop offset="1" stop-color="#8996A2"/></linearGradient>
    <radialGradient id="cap" cx=".34" cy=".3" r=".9">
      <stop offset="0" stop-color="#F4F7FA"/><stop offset=".6" stop-color="#CBD4DC"/>
      <stop offset="1" stop-color="#8E9BA7"/></radialGradient>
    <linearGradient id="red" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#F0605C"/><stop offset=".42" stop-color="#D93B3B"/>
      <stop offset="1" stop-color="#9C1E1E"/></linearGradient>
    <radialGradient id="wheel" cx=".36" cy=".3" r=".85">
      <stop offset="0" stop-color="#FBEC9A"/><stop offset=".55" stop-color="#F2D34B"/>
      <stop offset="1" stop-color="#C2A02A"/></radialGradient>
    <radialGradient id="gsh" cx=".5" cy=".5" r=".5">
      <stop offset="0" stop-color="#4A6070" stop-opacity=".38"/>
      <stop offset="1" stop-color="#4A6070" stop-opacity="0"/></radialGradient>
  </defs>
  <ellipse class="c-shadow" cx="214" cy="205" rx="152" ry="14" fill="url(#gsh)"/>
  <ellipse cx="86" cy="136" rx="12" ry="32" fill="#8E9BA7"/>
  <g class="c-legs"><path d="M120 168v24M300 168v24M96 152l-16 36M336 152l16 36"/></g>
  <rect x="86" y="104" width="264" height="64" rx="32" fill="url(#tank)" stroke="#7C8894"/>
  <rect x="112" y="110" width="212" height="7" rx="3.5" fill="#fff" opacity=".72"/>
  <rect x="104" y="160" width="228" height="5" rx="2.5" fill="#5F6E7B" opacity=".22"/>
  <ellipse cx="350" cy="136" rx="12" ry="32" fill="url(#cap)" stroke="#7C8894"/>
  <ellipse cx="350" cy="136" rx="6" ry="17" fill="none" stroke="#9AA6B1" stroke-width="1.1"/>
