<!--ithena-mobile-app-->
<style>
.is .mob{--phone:236px;--bar:#0083C8}
.is .mob .mobgrid{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,1fr);gap:clamp(28px,4vw,64px);align-items:start}
/* the phones stay in view while the three pillars scroll past them */
.is .mob .stage{position:sticky;top:96px;align-self:start;display:flex;align-items:flex-start;justify-content:center;gap:0;min-height:560px;padding:24px 0}
.is .mob .stage::before{content:"";position:absolute;inset:8% 10%;border-radius:50%;
  background:radial-gradient(closest-side,rgba(0,131,200,.22),rgba(0,131,200,0));filter:blur(28px);pointer-events:none}

/* ---- the device ---- */
.is .ph{position:relative;width:var(--phone);aspect-ratio:236/500;border-radius:40px;padding:9px;
  background:linear-gradient(155deg,#2a2f3a 0%,#0e1119 55%,#05070c 100%);
  box-shadow:0 2px 6px rgba(13,27,46,.28),0 34px 70px -22px rgba(13,27,46,.55),inset 0 0 0 2px rgba(255,255,255,.08),inset 0 1px 1px rgba(255,255,255,.18);
  animation:mobFloat 7s ease-in-out infinite}
.is .ph.b{position:absolute;right:0;top:120px;width:calc(var(--phone) * .86);animation:mobFloat2 7s ease-in-out infinite;z-index:1}
.is .ph.a{margin-right:calc(var(--phone) * .62);z-index:2}
.is .ph .isl{position:absolute;top:17px;left:50%;transform:translateX(-50%);width:34%;height:18px;border-radius:999px;background:#000;z-index:5}
.is .ph .scr{position:relative;width:100%;height:100%;border-radius:32px;overflow:hidden;background:#F4F6F8;
  font-family:inherit;font-size:9.5px;line-height:1.35;color:#1F2023;display:flex;flex-direction:column}
.is .ph .bar{background:var(--bar);color:#fff;padding:30px 12px 10px;display:flex;align-items:center;gap:8px;flex:none}
.is .ph .bar .ic{width:14px;height:14px;display:block}
.is .ph .bar .lg{height:13px;width:auto;display:block;filter:brightness(0) invert(1);margin-left:2px}
.is .ph .bar .sp{flex:1}
.is .ph .bar .av{width:16px;height:16px;border-radius:50%;background:#fff;color:var(--bar);font-size:7px;font-weight:800;display:grid;place-items:center}
.is .ph .body{padding:9px 9px 0;display:flex;flex-direction:column;gap:8px;flex:1;min-height:0}

/* stat tiles */
.is .ph .stats{display:grid;grid-template-columns:repeat(4,1fr);gap:5px}
.is .ph .st{background:#fff;border-radius:8px;padding:8px 2px 6px;text-align:center;box-shadow:0 1px 2px rgba(13,27,46,.06)}
.is .ph .st b{display:block;font-size:19px;font-weight:600;line-height:1;letter-spacing:-.02em}
.is .ph .st span{display:block;font-size:6.5px;font-weight:700;margin-top:4px;line-height:1.15}
.is .ph .st.o{color:#E8A33D}.is .ph .st.r{color:#D9534F}.is .ph .st.g{color:#1EA672}.is .ph .st.gr{color:#1EA672}

/* cards */
.is .ph .cd{background:#fff;border-radius:9px;padding:8px 9px;box-shadow:0 1px 2px rgba(13,27,46,.06)}
.is .ph .cd .hd{display:flex;align-items:center;justify-content:space-between;font-weight:800;font-size:9.5px;margin-bottom:3px}
.is .ph .cd .hd i{font-style:normal;font-weight:600;color:var(--bar);font-size:8px;display:inline-flex;align-items:center;gap:1px}
.is .ph .cd .hd i svg{width:8px;height:8px}
.is .ph .row{display:flex;align-items:center;gap:6px;padding:5px 0;border-top:1px solid #F0F1F3;font-size:8px;color:#4A4D52}
.is .ph .row:first-of-type{border-top:0}
.is .ph .row .n{color:#8A8E95;font-weight:600;width:20px;flex:none}
.is .ph .row .k{width:2px;height:12px;border-radius:2px;flex:none}
.is .ph .row .k.o{background:#E8A33D}.is .ph .row .k.b{background:var(--bar)}.is .ph .row .k.g{background:#1EA672}
.is .ph .row .t{flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.is .ph .row .c{width:9px;height:9px;flex:none;color:#C3C6CC}
.is .ph .row .di{width:8px;height:8px;flex:none;color:#8A8E95}
.is .ph .row.hi{background:#EAF5FB;margin:0 -9px;padding-left:9px;padding-right:9px;border-radius:5px;border-top-color:transparent}

/* toast + FAB */
.is .ph .fab{position:absolute;right:12px;bottom:14px;width:30px;height:30px;border-radius:50%;background:var(--bar);color:#fff;display:grid;place-items:center;
  box-shadow:0 6px 14px -4px rgba(0,131,200,.6);z-index:4}
.is .ph .fab svg{width:15px;height:15px}
.is .ph .toast{position:absolute;left:10px;right:10px;bottom:52px;background:#fff;border-radius:9px;padding:7px 9px;display:flex;align-items:center;gap:7px;
  box-shadow:0 1px 3px rgba(13,27,46,.08),0 14px 30px -10px rgba(13,27,46,.3);font-size:8px;font-weight:700;z-index:4;opacity:0;transform:translateY(10px);
  animation:mobToast 12s ease-in-out infinite}
.is .ph .toast .ic{width:20px;height:20px;border-radius:6px;background:rgba(30,166,114,.14);color:#1EA672;display:grid;place-items:center;flex:none}
.is .ph .toast .ic svg{width:11px;height:11px}
.is .ph .toast small{display:block;font-weight:500;color:#8A8E95;font-size:7.5px;margin-top:1px}

/* knowledge-base phone */
.is .ph .tabs{display:flex;background:#fff;border-radius:7px;padding:3px;gap:3px}
.is .ph .tabs span{flex:1;text-align:center;font-size:7.5px;font-weight:700;padding:4px 0;border-radius:5px;color:#8A8E95}
.is .ph .tabs span.on{background:var(--bar);color:#fff}
.is .ph .vid{position:relative;border-radius:8px;overflow:hidden;aspect-ratio:16/9;
  background:linear-gradient(135deg,#8a97a6 0%,#5f6d7c 40%,#3d4854 100%)}
.is .ph .vid::before,.is .ph .vid::after{content:"";position:absolute;background:rgba(255,255,255,.14);border-radius:3px}
.is .ph .vid::before{left:10%;top:22%;width:30%;height:42%}
.is .ph .vid::after{right:12%;top:30%;width:22%;height:48%;background:rgba(217,83,79,.55)}
.is .ph .vid .pl{position:absolute;left:50%;top:50%;width:26px;height:26px;margin:-13px 0 0 -13px;border-radius:50%;background:#D9534F;color:#fff;display:grid;place-items:center;z-index:1}
.is .ph .vid .pl svg{width:13px;height:13px;margin-left:1px}
.is .ph .dots{display:flex;justify-content:center;gap:4px;padding:2px 0}
.is .ph .dots i{width:5px;height:5px;border-radius:50%;background:#C3C6CC;animation:mobDot 6s linear infinite}
.is .ph .dots i:nth-child(2){animation-delay:1s}.is .ph .dots i:nth-child(3){animation-delay:2s}
.is .ph .dots i:nth-child(4){animation-delay:3s}.is .ph .dots i:nth-child(5){animation-delay:4s}.is .ph .dots i:nth-child(6){animation-delay:5s}
.is .ph .dl{display:flex;align-items:center;gap:6px;border-radius:6px;padding:6px 8px;color:#fff;font-size:8px;font-weight:700}
.is .ph .dl svg{width:10px;height:10px;flex:none}.is .ph .dl .sp{flex:1}
.is .ph .dl.pdf{background:#E9707A}.is .ph .dl.xls{background:#5EC27B}
.is .ph .pv{font-size:8.5px;font-weight:800;margin-top:2px}
.is .ph .pdfbox{background:#fff;border-radius:7px;padding:7px 8px;font-size:7px;color:#4A4D52;line-height:1.4}
.is .ph .pdfbox .ln{height:4px;border-radius:2px;background:#E4E7EB;margin:4px 0}
.is .ph .pdfbox .ln.s{width:60%}.is .ph .pdfbox .ln.m{width:85%}
.is .ph .pdfbox .note{background:#EAF5FB;border-left:2px solid var(--bar);padding:3px 5px;border-radius:0 3px 3px 0;font-size:6.5px}

/* progress rows (PanelOps) */
.is .ph .pr{display:flex;align-items:center;gap:6px;padding:5px 0;border-top:1px solid #F0F1F3;font-size:8px;color:#4A4D52}
.is .ph .pr:first-of-type{border-top:0}
.is .ph .pr .s{width:12px;height:12px;border-radius:50%;flex:none;display:grid;place-items:center;font-size:6px;font-weight:800}
.is .ph .pr .s svg{width:8px;height:8px}
.is .ph .pr .s.d{background:#E7F5EE;color:#1EA672}.is .ph .pr .s.w{background:#EAF5FB;color:var(--bar)}.is .ph .pr .s.q{background:#F0F1F3;color:#8A8E95}
.is .ph .pr .t{flex:1;min-width:0}.is .ph .pr .t small{display:block;color:#8A8E95;font-size:7px}
.is .ph .pr .pct{font-weight:800;font-size:8px}
.is .ph .bar2{height:4px;border-radius:2px;background:#E4E7EB;overflow:hidden;margin-top:3px}
.is .ph .bar2 i{display:block;height:100%;width:62%;background:var(--bar);border-radius:2px;animation:mobBar 6s ease-in-out infinite}
.is .ph .kv{display:flex;justify-content:space-between;font-size:8px;padding:4px 0;border-top:1px solid #F0F1F3}
.is .ph .kv:first-of-type{border-top:0}.is .ph .kv b{font-weight:800}
.is .ph .kv .ok{color:#1EA672;font-weight:700}.is .ph .kv .lo{color:#E8A33D;font-weight:700}

/* ---- copy column ---- */
.is .mob .pil{display:grid;gap:clamp(18px,2.4vw,28px);margin-top:clamp(22px,3vw,34px)}
.is .mob .pi{display:grid;grid-template-columns:44px 1fr;gap:16px;align-items:start}
.is .mob .pi .ico{width:44px;height:44px;border-radius:12px;background:#EAF5FB;color:#0083C8;display:grid;place-items:center}
.is .mob .pi .ico svg{width:22px;height:22px}
.is .mob .pi h3{font-size:18px;margin:6px 0 8px;font-weight:800;letter-spacing:-.01em}
.is .mob .pi ul{list-style:none;margin:0;padding:0;display:grid;gap:6px}
.is .mob .pi ul li{font-size:14.5px;line-height:1.55;color:rgba(0,0,0,.7);padding:0 0 0 14px !important;margin:0;position:relative} /* PanelOps has .mx li{padding:0!important} */
.is .mob .pi ul li::before{content:"";position:absolute;left:0;top:.62em;width:5px;height:5px;border-radius:50%;background:#0083C8}
.is .mob .pi li b{color:#1F2023;font-weight:700}

@keyframes mobFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}
@keyframes mobFloat2{0%,100%{transform:translateY(0)}50%{transform:translateY(6px)}}
@keyframes mobToast{0%,8%{opacity:0;transform:translateY(10px)}14%,42%{opacity:1;transform:none}48%,100%{opacity:0;transform:translateY(10px)}}
@keyframes mobDot{0%,12%{background:#0083C8;transform:scale(1.25)}17%,100%{background:#C3C6CC;transform:none}}
@keyframes mobBar{0%,20%{width:62%}60%,100%{width:78%}}

@media (max-width:1100px){
  .is .mob .mobgrid{grid-template-columns:1fr;gap:12px}
  .is .mob .stage{position:static;min-height:0;order:2;justify-content:center;padding:16px 0 8px;gap:16px}
  .is .ph.a{margin-right:0}.is .ph.b{position:relative;top:24px;right:auto}
}
@media (max-width:540px){
  .is .mob{--phone:196px}
  /* back to the overlapped pair - two phones side by side no longer fit */
  .is .mob .stage{display:block;position:relative;width:min(100%,300px);margin:0 auto;min-height:500px;padding:12px 0 8px}
  .is .ph.a{margin:0}
  .is .ph.b{position:absolute;right:0;top:56px;width:calc(var(--phone) * .82)}
  .is .ph .body{padding:7px 7px 0}.is .ph .st b{font-size:16px}
  .is .mob .pi{grid-template-columns:38px 1fr;gap:12px}.is .mob .pi .ico{width:38px;height:38px}
}
@media (prefers-reduced-motion:reduce){
  .is .ph,.is .ph.b,.is .ph .toast,.is .ph .dots i,.is .ph .bar2 i{animation:none}
  .is .ph .toast{opacity:1;transform:none}
}
</style>
